                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="FILE INFO" Foreground="#00FF00" FontWeight="Bold" FontSize="12"/>
                        <Button Content="&#x2715;" Click="BtnCloseFileInfo_Click"
                                HorizontalAlignment="Right" Background="Transparent"
                                Foreground="#555" BorderThickness="0"
                                Width="23" Height="23" FontSize="12" Cursor="Hand"/>
                    </Grid>
                    <TextBlock x:Name="TxtFileInfoName" Foreground="{DynamicResource Brush_Text}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtFileInfoSize" Foreground="{DynamicResource Brush_SoftText}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock x:Name="TxtFileInfoDate" Foreground="{DynamicResource Brush_SoftText}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock x:Name="TxtFileInfoType" Foreground="{DynamicResource Brush_SoftText}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock x:Name="TxtFileInfoPath" Foreground="#555" FontSize="10"  TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="OverlayRename" Background="#AA000000" Visibility="Collapsed" Grid.RowSpan="3">
            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="220" Padding="15">
                <StackPanel>
                    <TextBlock Text="RENAME SHORTCUT" Foreground="{DynamicResource Brush.Neon}"
                               FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtRenameInput" Background="{DynamicResource Brush_DeepBackground}" Foreground="{DynamicResource Brush_Text}"
                             BorderThickness="0" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="CANCEL" Click="BtnCancelRename_Click"
                                Style="{StaticResource Style_StealthButton}" Width="60" Height="25" Margin="0,0,5,0"/>
                        <Button Content="SAVE" Click="BtnSaveRename_Click"
                                Background="{DynamicResource Brush.Neon}" Foreground="Black"
                                FontWeight="Bold" Width="60" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="OverlayChangeCategory" Background="#AA000000" Visibility="Collapsed" Grid.RowSpan="3" Panel.ZIndex="102">
            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="240" Padding="15">
                <StackPanel>
                    <TextBlock Text="CHANGE CATEGORY" Foreground="{DynamicResource Brush.Neon}"
                               FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock Text="Current pin:" Foreground="{DynamicResource Brush_MutedText}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtChangeCatPinName" Foreground="{DynamicResource Brush_Text}" FontSize="13"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Select category:" Foreground="{DynamicResource Brush_MutedText}" FontSize="10" Margin="0,0,0,4"/>
                    <ListBox x:Name="ListChangeCatOptions"
                             Background="#1a1a1a" BorderBrush="#333" BorderThickness="1"
                             Foreground="{DynamicResource Brush_SoftText}" FontSize="13" MaxHeight="160"
                             SelectionChanged="ListChangeCatOptions_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="CANCEL" Click="BtnCancelChangeCategory_Click"
                                Style="{StaticResource Style_StealthButton}" Width="60" Height="25" Margin="0,0,5,0"/>
                        <Button Content="APPLY" Click="BtnApplyChangeCategory_Click"
                                Background="{DynamicResource Brush.Neon}" Foreground="Black"
                                FontWeight="Bold" Width="60" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="OverlayCategoryEdit" Background="#AA000000" Visibility="Collapsed" Grid.RowSpan="3" Panel.ZIndex="103">
            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="240" Padding="15">
                <StackPanel>
                    <TextBlock x:Name="TxtCategoryEditTitle" Foreground="{DynamicResource Brush.Neon}"
                               FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtCategoryEditInput" Background="{DynamicResource Brush_DeepBackground}" Foreground="{DynamicResource Brush_Text}"
                             BorderThickness="0" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="CANCEL" Click="BtnCancelCategoryEdit_Click"
                                Style="{StaticResource Style_StealthButton}" Width="60" Height="25" Margin="0,0,5,0"/>
                        <Button Content="SAVE" Click="BtnSaveCategoryEdit_Click"
                                Background="{DynamicResource Brush.Neon}" Foreground="Black"
                                FontWeight="Bold" Width="60" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
