<UserControl x:Class="Horizon.Stealth.Controls.FluxSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Horizon.Stealth.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                
            </ResourceDictionary.MergedDictionaries>

            <local:FaviconConverter x:Key="FaviconConverter"/>
            <local:FluxAccentColorConverter x:Key="FluxAccentColorConverter"/>
            <local:NullOrEmptyConverter    x:Key="NullOrEmptyConverter"/>
            <local:LocalImageConverter     x:Key="LocalImageConverter"/>
            <local:CategoryColorConverter  x:Key="CategoryColorConverter"/>
            <BooleanToVisibilityConverter  x:Key="BoolToVisConverter"/>

            <SolidColorBrush x:Key="Brush.Alert"   Color="#FF3333"/>

            <Style x:Key="Style.SortBtn" TargetType="Button">
                <Setter Property="Height"          Value="32"/>
                <Setter Property="FontSize"        Value="10"/>
                <Setter Property="FontWeight"      Value="Bold"/>
                <Setter Property="Margin"          Value="2"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{DynamicResource Brush_Text}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource Brush_ButtonBorder}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonHoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_ButtonHoverBorder}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Style.CtxBtn" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="#CCC"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height"          Value="32"/>
                <Setter Property="Padding"         Value="8,0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="FontSize"        Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bx" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bx" Property="Background" Value="#2a2a2a"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Style.SidebarIconBtn" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{DynamicResource Brush_SoftText}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource Brush_ButtonBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Margin"          Value="2,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonHoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_ButtonHoverBorder}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Style.CtxSearchBox" TargetType="TextBox">
                <Setter Property="Background"             Value="Transparent"/>
                <Setter Property="Foreground"             Value="#CCC"/>
                <Setter Property="BorderThickness"        Value="0"/>
                <Setter Property="FontSize"               Value="12"/>
                <Setter Property="Padding"                Value="5,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Style.StealthListItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{DynamicResource Brush_TabStripBg}" BorderBrush="{DynamicResource Brush_TabStripBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="4">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonHoverBg}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_ButtonHoverBorder}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_TabStripBgSelected}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Neon}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Style.FluxListItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{Binding ItemGradient}"
                                    BorderBrush="{DynamicResource Brush_SidebarTileStroke}" BorderThickness="1" CornerRadius="6" Padding="4">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#666"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Neon}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Style.MiniListItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Width="40" Height="40" CornerRadius="8"
                                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Neon}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <local:FluxAccentGradientConverter x:Key="FluxAccentGradientConverter"/>

            <Style x:Key="Style.PinListItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{Binding Converter={StaticResource FluxAccentGradientConverter}}"
                                    BorderBrush="{DynamicResource Brush_SidebarTileStroke}" BorderThickness="1" CornerRadius="6" Padding="4" ClipToBounds="True">
                                <Grid>
                                    <Border Width="4" HorizontalAlignment="Right" Margin="0,-1,-1,-1"
                                            Background="{Binding Converter={StaticResource FluxAccentColorConverter}}"
                                            CornerRadius="0,5,5,0" IsHitTestVisible="False"/>
                                    <ContentPresenter/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#666"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Neon}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="Template.PinItem">
                <Grid Margin="5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon cell: emoji > local file > favicon URL -->
                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource Brush_HeaderButtonScrim}"
                            VerticalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Favicon (default; hidden if overridden) -->
                            <Image x:Name="ImgFavicon"
                                   Source="{Binding Url, Converter={StaticResource FaviconConverter}}"
                                   Width="20" Height="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stretch="Uniform"/>
                            <!-- Local image file (shown when IconPath is set) -->
                            <Image x:Name="ImgCustom"
                                   Source="{Binding IconPath, Converter={StaticResource LocalImageConverter}}"
                                   Width="20" Height="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stretch="Uniform" Visibility="Collapsed"/>
                            <!-- Emoji override (shown when IconEmoji is set) -->
                            <TextBlock x:Name="TbEmoji"
                                       Text="{Binding IconEmoji}"
                                       FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush_Text}" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Category}"
                                   Foreground="{Binding Category, Converter={StaticResource CategoryColorConverter}}"
                                   FontSize="11" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <!-- Local file path set &#x2192; show custom image, hide favicon -->
                    <DataTrigger Binding="{Binding IconPath, Converter={StaticResource NullOrEmptyConverter}}" Value="False">
                        <Setter TargetName="ImgFavicon" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ImgCustom"  Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!-- Emoji set &#x2192; show emoji, hide everything else -->
                    <DataTrigger Binding="{Binding IconEmoji, Converter={StaticResource NullOrEmptyConverter}}" Value="False">
                        <Setter TargetName="ImgFavicon" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ImgCustom"  Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="TbEmoji"    Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="Template.HistoryItem">
                <Grid Margin="5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="23" Height="23" CornerRadius="3" Background="{DynamicResource Brush_HeaderButtonScrim}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="{Binding Url, Converter={StaticResource FaviconConverter}}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush_Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}"   Foreground="{DynamicResource Brush_MutedText}" FontSize="10"  TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="Template.FluxItem">
                <Grid Margin="5,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.RowSpan="2" Text="{Binding TypeIcon}" FontSize="18"
                               Foreground="{DynamicResource Brush_SoftText}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding DisplayName}"
                               Foreground="{DynamicResource Brush_Text}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                    <TextBlock Grid.Column="1" Grid.Row="1" Foreground="{DynamicResource Brush_SoftText}" FontSize="10" Margin="0,2,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}  ·  {1}">
                                <Binding Path="State"/>
                                <Binding Path="FileSizeDisplay"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <ProgressBar Grid.Column="1" Grid.Row="1" Height="2" VerticalAlignment="Bottom"
                                 Margin="0,4,0,0"
                                 Value="{Binding ReceivedBytes, Mode=OneWay}" Maximum="{Binding TotalBytes, Mode=OneWay}"
                                 Foreground="{DynamicResource Brush.Neon}" Background="{DynamicResource Brush_DeepBackground}"
                                 BorderThickness="0"
                                 x:Name="BarProgress" Visibility="Collapsed"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="DOWNLOADING">
                        <Setter TargetName="BarProgress" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="Template.PinItemMini">
                <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Name}">
                    <Border CornerRadius="8" Background="{DynamicResource Brush_HeaderButtonScrim}" ClipToBounds="True">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="ImgFavicon"
                                   Source="{Binding Url, Converter={StaticResource FaviconConverter}}"
                                   Stretch="Uniform" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="ImgCustom"
                                   Source="{Binding IconPath, Converter={StaticResource LocalImageConverter}}"
                                   Stretch="Uniform" Width="22" Height="22" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TbEmoji"
                                       Text="{Binding IconEmoji}"
                                       FontSize="18" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IconPath, Converter={StaticResource NullOrEmptyConverter}}" Value="False">
                        <Setter TargetName="ImgFavicon" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ImgCustom"  Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconEmoji, Converter={StaticResource NullOrEmptyConverter}}" Value="False">
                        <Setter TargetName="ImgFavicon" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ImgCustom"  Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="TbEmoji"    Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="Template.HistoryItemMini">
                <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Title}">
                    <Border CornerRadius="8" Background="{DynamicResource Brush_HeaderButtonScrim}" ClipToBounds="True">
                        <Image Source="{Binding Url, Converter={StaticResource FaviconConverter}}"
                               Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="Template.FluxItemMini">
                <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding DisplayName}">
                    <Border CornerRadius="8" Background="{DynamicResource Brush_HeaderButtonScrim}" ClipToBounds="True">
                        <TextBlock Text="{Binding TypeIcon}" FontSize="18"
                                   Foreground="{DynamicResource Brush_SoftText}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </DataTemplate>

                        <DataTemplate x:Key="Template.UtilitySidebarItemMini">
                <Border x:Name="BdUtilMini" Width="38" Height="38" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Brush_SidebarTile}" BorderBrush="{DynamicResource Brush_SidebarTileStroke}" BorderThickness="1"
                        Cursor="Hand">
                    <Border.ToolTip>
                        <ToolTip Background="#1A202C" Foreground="#FFFFFF" BorderBrush="#33FFFFFF">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#A0AEC0" MaxWidth="220" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                    <TextBlock Text="{Binding Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="BdUtilMini" Property="Background" Value="#222A3C"/>
                        <Setter TargetName="BdUtilMini" Property="BorderBrush" Value="#4A9EFF"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

<DataTemplate x:Key="Template.UtilitySidebarItem">
                <Border x:Name="BdUtil" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Brush_SidebarTile}" BorderBrush="{DynamicResource Brush_SidebarTileStroke}" BorderThickness="1" Padding="8,6"
                        Cursor="Hand" ToolTip="{Binding Description}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon badge -->
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="#222838" BorderBrush="#4A9EFF" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title & Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Brush_Text}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                <Border Margin="4,0,0,0" CornerRadius="3" Background="#20FFFFFF" Padding="3,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="8.5" Foreground="#4A9EFF" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{DynamicResource Brush_MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Actions (Pin / Run) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="&#x1F4CC;" FontSize="10" Foreground="#4A9EFF"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="BtnSidebarRunUtil" Content="&#x25B6;" Width="22" Height="22" Style="{StaticResource Style.SidebarIconBtn}" FontSize="9"
                                    ToolTip="Run / Open Utility" Click="BtnSidebarRunUtil_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="BdUtil" Property="Background" Value="#222A3C"/>
                        <Setter TargetName="BdUtil" Property="BorderBrush" Value="#4A9EFF"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
        </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

                <Border x:Name="SidebarDockHeader" Grid.Row="0" Margin="4,4,4,4">
            <Grid>
                <Grid x:Name="PnlHeaderTabModes">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColHeaderPanes" Width="*"/>
                        <ColumnDefinition x:Name="ColHeaderUtil" Width="*"/>
                        <ColumnDefinition x:Name="ColHeaderDock" Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RowHeaderDock" Height="Auto"/>
                        <RowDefinition x:Name="RowHeaderPanes" Height="Auto"/>
                        <RowDefinition x:Name="RowHeaderUtil" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="BtnSidebarPanesTab" Grid.Row="0" Grid.Column="0" Margin="0,0,2,0" CornerRadius="6"
                            Height="32" Background="{DynamicResource Brush_TabStripBgSelected}" BorderBrush="{DynamicResource Brush.Neon}" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonUp="BtnSidebarPanesTab_Click" ToolTip="Browser Panes">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPanesTabLabel" Text="&#x1F5C2;&#xFE0F; Panes" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush_Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BtnSidebarUtilitiesTab" Grid.Row="0" Grid.Column="1" Margin="2,0,2,0" CornerRadius="6"
                            Height="32" Background="{DynamicResource Brush_TabStripBg}" BorderBrush="{DynamicResource Brush_TabStripBorder}" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonUp="BtnSidebarUtilitiesTab_Click" ToolTip="Horizon Utilities Hub">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUtilitiesTabLabel" Text="&#x26A1; Utilities" FontSize="11" FontWeight="SemiBold" Foreground="#4A9EFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnToggleSidebarDock" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Width="26" Height="26"
                            Style="{StaticResource Style.SidebarIconBtn}"
                            Content="&#x25B6;" ToolTip="Dock to mini mode" Click="BtnToggleSidebarDock_Click" Visibility="Visible"/>
                </Grid>
                <TextBlock x:Name="TxtSidebarTitle" Text="SIDEBAR" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TabControl x:Name="SidebarTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RowTabHeader" Height="100"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <UniformGrid x:Name="TabHeaderGrid" Grid.Row="0" Columns="3" Rows="2" IsItemsHost="True"/>
                        <ContentPresenter Grid.Row="1"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                    <Setter Property="Cursor"   Value="Hand"/>
                    <Setter Property="Margin"   Value="2"/>
                    <Setter Property="Padding"  Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{DynamicResource Brush_TabStripBg}" BorderBrush="{DynamicResource Brush_TabStripBorder}"
                                        BorderThickness="1" CornerRadius="8" Height="38" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Border CornerRadius="8" Background="{DynamicResource Brush_HeaderButtonScrim}" IsHitTestVisible="False"/>
                                        <Border x:Name="ActivePip" Width="3" HorizontalAlignment="Left" Margin="2,6,0,6" CornerRadius="1.5"
                                                Background="{DynamicResource Brush.Neon}" Visibility="Collapsed"/>
