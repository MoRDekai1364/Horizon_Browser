<UserControl x:Class="Horizon.Stealth.Controls.StackHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             BorderThickness="0"
             ClipToBounds="True">
    <Grid x:Name="Root" Background="Transparent" MouseWheel="Root_MouseWheel">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Viewport" Grid.Column="0" ClipToBounds="True">
            <Border x:Name="EmptyAdd" Visibility="Collapsed" Background="Transparent" Cursor="Hand" CornerRadius="22"
                    MouseLeftButtonUp="EmptyAdd_Click" MouseEnter="EmptyAdd_Hover" MouseLeave="EmptyAdd_Hover">
                <Grid>
                    <Rectangle x:Name="EmptyAddOutline" RadiusX="22" RadiusY="22" Margin="1" StrokeThickness="2"
                               StrokeDashArray="4 4" Opacity="0.45" IsHitTestVisible="False"
                               Stroke="{DynamicResource HomeTextBrush}"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Grid x:Name="EmptyAddCircle" Width="64" Height="64" HorizontalAlignment="Center">
                            <Ellipse StrokeThickness="2" Stroke="{DynamicResource HomeTextBrush}"/>
                            <TextBlock x:Name="EmptyAddPlus" Text="+" FontSize="36" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,-4,0,0" Foreground="{DynamicResource HomeTextBrush}"/>
                        </Grid>
                        <TextBlock x:Name="EmptyAddLabel" Text="Add a widget" FontSize="14" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Opacity="0.8" Foreground="{DynamicResource HomeTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentPresenter x:Name="Outgoing" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="Incoming"/>
            <Grid x:Name="Overlay" Visibility="Collapsed" Opacity="0" Focusable="True" FocusVisualStyle="{x:Null}" KeyDown="Overlay_KeyDown">
                <Rectangle x:Name="OverlayBackdrop" Fill="Transparent" MouseLeftButtonUp="OverlayBackdrop_Click">
                </Rectangle>
                <ContentPresenter x:Name="OverlayContent"/>
            </Grid>
        </Grid>
        <StackPanel x:Name="Dots" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>
</UserControl>