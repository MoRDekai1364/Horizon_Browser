<UserControl x:Class="Horizon.Stealth.Controls.StackHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             BorderThickness="0"
             ClipToBounds="True">
    <Grid x:Name="Root" Background="Transparent" MouseWheel="Root_MouseWheel">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Viewport" Grid.Column="0" ClipToBounds="True">
            <ContentPresenter x:Name="Outgoing" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="Incoming"/>
            <Grid x:Name="Overlay" Visibility="Collapsed" Opacity="0" Focusable="True" FocusVisualStyle="{x:Null}" KeyDown="Overlay_KeyDown">
                <Rectangle MouseLeftButtonUp="OverlayBackdrop_Click">
                    <Rectangle.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66000000" Offset="0"/>
                            <GradientStop Color="#B3000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <ContentPresenter x:Name="OverlayContent"/>
            </Grid>
        </Grid>
        <StackPanel x:Name="Dots" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>
</UserControl>