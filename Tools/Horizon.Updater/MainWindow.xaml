<Window x:Class="Horizon.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon Browser // Updater"
        Width="560" Height="260"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0B0F1A"
        BorderBrush="#1F293D"
        BorderThickness="1"
        Topmost="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF2D78" Offset="0"/>
            <GradientStop Color="#00D9FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="NeonProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#141C2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#253550"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <Border x:Name="PART_Track" Margin="1" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator"
                                    Margin="1"
                                    HorizontalAlignment="Left"
                                    CornerRadius="5"
                                    Background="{StaticResource AccentGradient}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,28" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtHeaderTitle" Text="UPDATING HORIZON BROWSER"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#00D9FF"/>
            <TextBlock x:Name="TxtHeaderSubtitle" Text="Professional Update Engine"
                       FontSize="11" Foreground="#6C7F99"
                       FontWeight="SemiBold"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Progress Details -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="TxtStatus" Text="Initializing update sequence..."
                       FontSize="13" Foreground="#EAF6FF"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <ProgressBar x:Name="ProgressBarUpdate"
                         Height="12"
                         Style="{StaticResource NeonProgressBarStyle}"
                         Value="0" Maximum="100"/>

            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="TxtPercent" Text="0%"
                           FontSize="12" FontWeight="Bold"
                           Foreground="#00D9FF"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="Please do not close this window"
                           FontSize="11" Foreground="#586A82"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Footer / Error message -->
        <TextBlock Grid.Row="2" x:Name="TxtError" Text=""
                   FontSize="11" Foreground="#FF4772"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Window>
