                    <TextBlock Text="SORT BY" Foreground="#444" FontSize="10" FontWeight="Bold" Margin="8,4,0,2"/>
                    <Button Content="📅  By Date"          Click="CtxHistSortDate_Click"         Style="{StaticResource Style.CtxBtn}"/>
