                    <Separator x:Name="SepExtractHere" Background="#333" Margin="4,2" Visibility="Collapsed"/>
                    <Button x:Name="BtnCtxExtractHere"
                            Content="📦  Extract Here"
                            Click="CtxExtractHere_Click"
                            Style="{StaticResource Style.CtxBtn}"
                            Foreground="#AADDAA"
                            Visibility="Collapsed"/>
                    <Separator Background="#333" Margin="4,2"/>
                    <TextBlock Text="SORT BY" Foreground="#444" FontSize="10" FontWeight="Bold" Margin="8,4,0,2"/>
                    <Button Content="📅  By Date"          Click="CtxSortDate_Click"             Style="{StaticResource Style.CtxBtn}"/>
                    <Button Content="🔤  By Name"          Click="CtxSortName_Click"             Style="{StaticResource Style.CtxBtn}"/>
                    <Button Content="📦  By Size"          Click="CtxSortSize_Click"             Style="{StaticResource Style.CtxBtn}"/>
                    <Separator Background="#333" Margin="4,2"/>
                    <Button Content="🗑  Delete File"      Click="BtnFluxDelete_Click"
                            Style="{StaticResource Style.CtxBtn}" Foreground="{StaticResource Brush.Alert}"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ExtContextPopup" StaysOpen="False" AllowsTransparency="True" Placement="MousePoint">
            <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="4">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.6"/></Border.Effect>
                <StackPanel MinWidth="200">
                    <Border Background="#141414" BorderBrush="#2a2a2a" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                        <Grid>
                            <TextBox x:Name="TxtExtSearch" Style="{StaticResource Style.CtxSearchBox}"
                                     TextChanged="TxtExtSearch_TextChanged"/>
                            <TextBlock x:Name="TxtExtSearchHint" Text="🔍 search extensions…"
                                       Foreground="#333" FontSize="13" VerticalAlignment="Center"
                                       Margin="8,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <Separator Background="#333" Margin="4,2"/>
                    <Button Content="⚡  Toggle On / Off" Click="CtxExtToggle_Click"            Style="{StaticResource Style.CtxBtn}"/>
                    <Button Content="🧩  Open Extension"  Click="CtxExtOpen_Click"              Style="{StaticResource Style.CtxBtn}" Foreground="#AADDAA"/>
                    <Separator Background="#333" Margin="4,2"/>
                    <TextBlock Text="SORT BY" Foreground="#444" FontSize="10" FontWeight="Bold" Margin="8,4,0,2"/>
                    <Button Content="🔤  By Name"          Click="CtxExtSortName_Click"          Style="{StaticResource Style.CtxBtn}"/>
                    <Button Content="⚡  By State"        Click="CtxExtSortState_Click"         Style="{StaticResource Style.CtxBtn}"/>
                    <Button Content="📦  By Source"        Click="CtxExtSortSource_Click"        Style="{StaticResource Style.CtxBtn}"/>
                    <Separator Background="#333" Margin="4,2"/>
                    <Button Content="🗑  Uninstall"       Click="CtxExtUninstall_Click"
                            Style="{StaticResource Style.CtxBtn}" Foreground="{StaticResource Brush.Alert}"/>
                </StackPanel>
            </Border>
        </Popup>

        <Grid x:Name="OverlayFileInfo" Background="#CC000000"
              Visibility="Collapsed" Grid.RowSpan="2" Panel.ZIndex="101">
            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="260" Padding="16" Margin="10">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.7"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="FILE INFO" Foreground="#00FF00" FontWeight="Bold" FontSize="12"/>
                        <Button Content="✕" Click="BtnCloseFileInfo_Click"
                                HorizontalAlignment="Right" Background="Transparent"
                                Foreground="#555" BorderThickness="0"
                                Width="23" Height="23" FontSize="12" Cursor="Hand"/>
                    </Grid>
                    <TextBlock x:Name="TxtFileInfoName" Foreground="#EEE" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtFileInfoSize" Foreground="{StaticResource Brush_SoftText}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock x:Name="TxtFileInfoDate" Foreground="{StaticResource Brush_SoftText}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock x:Name="TxtFileInfoType" Foreground="{StaticResource Brush_SoftText}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock x:Name="TxtFileInfoPath" Foreground="#555" FontSize="10"  TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="OverlayRename" Background="#AA000000" Visibility="Collapsed" Grid.RowSpan="3">
            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="220" Padding="15">
                <StackPanel>
                    <TextBlock Text="RENAME SHORTCUT" Foreground="{StaticResource Brush.Neon}"
                               FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtRenameInput" Background="#222" Foreground="White"
                             BorderThickness="0" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="CANCEL" Click="BtnCancelRename_Click"
                                Style="{StaticResource Style_StealthButton}" Width="60" Height="25" Margin="0,0,5,0"/>
                        <Button Content="SAVE" Click="BtnSaveRename_Click"
                                Background="{StaticResource Brush.Neon}" Foreground="Black"
                                FontWeight="Bold" Width="60" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="OverlayChangeCategory" Background="#AA000000" Visibility="Collapsed" Grid.RowSpan="3" Panel.ZIndex="102">
            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="240" Padding="15">
                <StackPanel>
                    <TextBlock Text="CHANGE CATEGORY" Foreground="{StaticResource Brush.Neon}"
                               FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock Text="Current pin:" Foreground="#666" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtChangeCatPinName" Foreground="#EEE" FontSize="13"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Select category:" Foreground="#666" FontSize="10" Margin="0,0,0,4"/>
                    <ListBox x:Name="ListChangeCatOptions"
                             Background="#1a1a1a" BorderBrush="#333" BorderThickness="1"
                             Foreground="{StaticResource Brush_SoftText}" FontSize="13" MaxHeight="160"
                             SelectionChanged="ListChangeCatOptions_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="CANCEL" Click="BtnCancelChangeCategory_Click"
                                Style="{StaticResource Style_StealthButton}" Width="60" Height="25" Margin="0,0,5,0"/>
                        <Button Content="APPLY" Click="BtnApplyChangeCategory_Click"
                                Background="{StaticResource Brush.Neon}" Foreground="Black"
                                FontWeight="Bold" Width="60" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="OverlayCategoryEdit" Background="#AA000000" Visibility="Collapsed" Grid.RowSpan="3" Panel.ZIndex="103">
            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="240" Padding="15">
                <StackPanel>
                    <TextBlock x:Name="TxtCategoryEditTitle" Foreground="{StaticResource Brush.Neon}"
                               FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtCategoryEditInput" Background="#222" Foreground="White"
                             BorderThickness="0" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="CANCEL" Click="BtnCancelCategoryEdit_Click"
                                Style="{StaticResource Style_StealthButton}" Width="60" Height="25" Margin="0,0,5,0"/>
                        <Button Content="SAVE" Click="BtnSaveCategoryEdit_Click"
                                Background="{StaticResource Brush.Neon}" Foreground="Black"
                                FontWeight="Bold" Width="60" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
