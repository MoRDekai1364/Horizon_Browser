                    <Button Content="🔤  By Name"          Click="CtxBmSortName_Click"           Style="{StaticResource Style.CtxBtn}"/>
                    <Button Content="🌐  By Domain"        Click="CtxBmSortDomain_Click"         Style="{StaticResource Style.CtxBtn}"/>
                    <Separator Background="#333" Margin="4,2"/>
                    <Button Content="➕  Add New Bookmark"  Click="CtxBmAddNew_Click"
                            Style="{StaticResource Style.CtxBtn}" Foreground="#AAAADD"/>
                    <Button Content="💾  Export Bookmarks"  Click="CtxBmExport_Click"
                            Style="{StaticResource Style.CtxBtn}" Foreground="#AAAADD"/>
                    <Separator Background="#333" Margin="4,2"/>
                    <Button Content="🗑  Remove"           Click="BtnBookmarkDelete_Click"
                            Style="{StaticResource Style.CtxBtn}" Foreground="{StaticResource Brush.Alert}"/>
                    <Separator Background="#333" Margin="4,2"/>
                    <Button Content="⭐  Send to Favourites" Click="CtxBmSendToFavourites_Click"
                            Style="{StaticResource Style.CtxBtn}" Foreground="#AADDAA"/>
                </StackPanel>
            </Border>
        </Popup>

