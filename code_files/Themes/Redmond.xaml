<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color_Accent">#0078D4</Color>
    <SolidColorBrush x:Key="Brush_Background" Color="White"/>
    <SolidColorBrush x:Key="Brush_DeepBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush_Accent" Color="{StaticResource Color_Accent}"/>
    <SolidColorBrush x:Key="Brush_Text" Color="Black"/>
    <SolidColorBrush x:Key="Brush_Alert" Color="#E81123"/>

    <Style TargetType="Button" x:Key="Style_StealthButton">
        <Setter Property="Background" Value="#DDDDDD"/>
        <Setter Property="BorderBrush" Value="#AAAAAA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CCE8FF"/>
                            <Setter Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem" x:Key="Style_SidebarItem">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
</ResourceDictionary>