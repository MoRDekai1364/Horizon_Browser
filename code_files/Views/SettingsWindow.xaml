                </ScrollViewer>
            </TabItem>

            <TabItem Header="PERFORMANCE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10,10,20,10">
                        <TextBlock Text="TAB &amp; MEMORY MANAGEMENT" Foreground="{StaticResource Brush_Accent}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Tab Widths" Foreground="{StaticResource Brush_Accent}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="All values in pixels. Changes apply after saving and restarting the browser." Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Default (px)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtTabDefaultWidth" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5" ToolTip="Standard tab width when the tab bar has room. Range: 90–400."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0">
                                <TextBlock Text="Media Tab (px)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtTabMediaWidth" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5" ToolTip="Minimum width granted to a tab that is playing audio. Range: 90–400."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBlock Text="Download Tab (px)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtTabDownloadWidth" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5" ToolTip="Minimum width granted to a tab with an active download. Range: 90–400."/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Media Hover Width (px)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtTabMediaHoverWidth" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5" ToolTip="Width a media-playback tab expands to on mouse hover. Range: 120–500."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Download Hover Width (px)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtTabDownloadHoverWidth" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5" ToolTip="Width a download-mode tab expands to on mouse hover. Range: 120–500."/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#333" Margin="0,0,0,18"/>

                        <TextBlock Text="Sleeping Tabs" Foreground="{StaticResource Brush_Accent}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enable sleeping tabs (auto-suspend idle tabs to free RAM)" Foreground="{StaticResource Brush_Text}" FontSize="11" VerticalAlignment="Center" ToolTip="When disabled, no tabs will ever be auto-suspended."/>
                            <CheckBox x:Name="ChkSleepingTabsEnabled" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Top 5 most-clicked tabs are always protected. Suspending is skipped when RAM is below 2 GB and fewer than 6 tabs are open." Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <TextBlock Text="Flux Janitor Rules" Foreground="{StaticResource Brush_Accent}" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,15" ToolTip="Automatically delete downloads based on file size and age.">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Small File (MB)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtJanitorSmall" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5"/>
                            </StackPanel>
                        
                            <StackPanel Grid.Column="1" Margin="5,0">
                                <TextBlock Text="Large File (GB)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtJanitorLarge" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBlock Text="Retention (Min)" Foreground="{StaticResource Brush_Text}" FontSize="11"/>
                                <TextBox x:Name="TxtJanitorTime" Height="30" Background="#222" Foreground="White" BorderThickness="0" Margin="0,5"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="System Health" Foreground="{StaticResource Brush_Accent}" FontWeight="Bold" Margin="0,10,0,10"/>
                        <Button x:Name="BtnNuclear" Content="⚠ EXECUTE PURGE" Click="BtnNuclear_Click" 
                                Background="#330000" Foreground="#FF3333" BorderBrush="#FF3333" BorderThickness="1"
                                Height="40" Cursor="Hand"
                                ToolTip="Forcefully releases RAM from all browser processes. May cause tabs to reload.">
                            <Button.Template>
                                 <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="Bold"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="Forcefully clears Working Sets for all Browser processes." Foreground="Gray" FontSize="11" Margin="0,5"/>

                        </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="DEVELOPER">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10,10,20,10">
                        <TextBlock x:Name="TblVersionDisplay" Text="-----version—" Foreground="#FF2222" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>

                        <TextBlock Text="PROJECT TOOLS" Foreground="{StaticResource Brush_Accent}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Project Mapping" Foreground="{StaticResource Brush_Accent}" FontWeight="Bold" Margin="0,10,0,10"/>
