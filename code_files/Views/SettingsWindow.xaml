                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#1A1A1A" CornerRadius="3" Padding="8,4">
                                <TextBlock Text="Memory Purge" Foreground="{StaticResource Brush_Accent}" FontWeight="Bold" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Forcefully releases RAM from all browser processes. Tabs may reload" Foreground="#DDD" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#1A1A1A" CornerRadius="3" Padding="8,4">
                                <TextBlock Text="Session Restore" Foreground="{StaticResource Brush_Accent}" FontWeight="Bold" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="On startup, prompts to reopen tabs from the previous session" Foreground="#DDD" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" Click="BtnCancel_Click" Style="{StaticResource Style_StealthButton}" Width="100" Height="35" Margin="0,0,10,0"/>
            <Button Content="SAVE &amp; APPLY" Click="BtnSave_Click" Background="{StaticResource Brush_Accent}" Foreground="Black" FontWeight="Bold" Width="120" Height="35">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>