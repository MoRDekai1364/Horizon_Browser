<Window x:Class="Horizon.Stealth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Horizon.Stealth.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Horizon Stealth" Height="720" Width="1280"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="{StaticResource Brush_Background}">

    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="0"
                                        ResizeBorderThickness="5"
                                        GlassFrameThickness="0"
                                        CornerRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Horizon.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#222"/>
                <Setter Property="Foreground" Value="#DDD"/>
                <Setter Property="BorderBrush" Value="#444"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Global dark scrollbar thumb (applies to all ScrollViewers in the window) -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#2E2E2E" CornerRadius="3" Margin="1,2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Storyboard x:Key="Anim_HeaderOpen">
                <DoubleAnimation Storyboard.TargetName="HeaderContainer" Storyboard.TargetProperty="Height"
                                 To="60" Duration="0:0:0.18">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="Anim_HeaderClose">
                <DoubleAnimation Storyboard.TargetName="HeaderContainer" Storyboard.TargetProperty="Height"
                                 To="0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="Anim_SidebarOpen">
                <DoubleAnimation Storyboard.TargetName="SidebarContainer" Storyboard.TargetProperty="Width"
                                 To="320" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="Anim_SidebarClose">
                <DoubleAnimation Storyboard.TargetName="SidebarContainer" Storyboard.TargetProperty="Width"
                                 To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#222" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowHeader" Height="Auto"/>
                <RowDefinition x:Name="RowOverflow" Height="Auto"/>
                <RowDefinition x:Name="RowNotify" Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColSidebar" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="2"
                  Panel.ZIndex="999" IsHitTestVisible="True" Background="{x:Null}">

                <Rectangle x:Name="SensorTop" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                           Height="8" Fill="#01000000" Cursor="Hand"/>

                <Rectangle x:Name="SensorPillLeft" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Width="100" Height="10" Fill="#01000000" Cursor="Hand"/>

                <Rectangle x:Name="SensorRight" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                           Width="20" Fill="#01000000" Cursor="None"/>
            </Grid>

            <!-- Fullscreen notification bar (Firefox-style) -->
            <Border x:Name="FullscreenNotifyBar"
                    Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2"
                    Panel.ZIndex="997"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Opacity="0" IsHitTestVisible="False"
                    Margin="0,12,0,0" Padding="18,7" CornerRadius="6"
                    Background="#EE111111" BorderBrush="#888" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⛶  " Foreground="#CCC" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Full screen  —  press " Foreground="#CCC" FontSize="13" VerticalAlignment="Center"/>
                    <Border Background="#444" CornerRadius="3" Padding="6,2" Margin="0,0,3,0">
                        <TextBlock Text="F11" Foreground="#FFF" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text=" to exit" Foreground="#CCC" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- WebApp mode: thin ghost control bar (min/max/close + drag). Normally Opacity=0, fades in on SensorTop hover -->
            <Grid x:Name="WebAppBar"
                  Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2"
                  Panel.ZIndex="998" VerticalAlignment="Top"
                  Height="32" Opacity="0" IsHitTestVisible="False"
                  Visibility="Collapsed">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC0b0b0b" Offset="0"/>
                        <GradientStop Color="#000b0b0b" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Rectangle x:Name="WebAppDragGrip" Fill="#01000000" Cursor="SizeAll"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Margin="0,0,110,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnWebAppMin"   Content="─" Width="30" Height="22"
                            Background="Transparent" Foreground="#888" BorderThickness="0"
                            FontSize="11" Cursor="Hand" Click="BtnWebAppMin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnWebAppMax"   Content="□" Width="30" Height="22"
                            Background="Transparent" Foreground="#888" BorderThickness="0"
                            FontSize="11" Cursor="Hand" Click="BtnWebAppMax_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnWebAppClose" Content="✕" Width="30" Height="22"
                            Background="Transparent" Foreground="#883333" BorderThickness="0"
                            FontSize="11" Cursor="Hand" Click="BtnWebAppClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#441111"/>
                                        <Setter Property="Foreground" Value="#FF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            

            <!-- Fullscreen flash overlay — fades in black then out, like Firefox -->
            <Rectangle x:Name="FullscreenFlash"
                       Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2"
                       Panel.ZIndex="1000" Fill="Black" Opacity="0"
                       IsHitTestVisible="False"/>

            <Grid x:Name="HeaderContainer" Grid.Row="0" Grid.ColumnSpan="2" Height="60" ClipToBounds="True">
                <Grid Background="{StaticResource Brush_DeepBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="2*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                        <Button x:Name="BtnBack" Content="🠔" Click="BtnBack_Click" MouseRightButtonUp="BtnBack_RightClick"
                                Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="20"
                                ToolTip="Go Back (Alt + Left) · Right-click for history"/>
                        <Button x:Name="BtnForward" Content="🠖" Click="BtnForward_Click" MouseRightButtonUp="BtnForward_RightClick"
                                Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="20"
                                ToolTip="Go Forward (Alt + Right) · Right-click for history"/>
                        <Button Content="↻" Click="BtnReload_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="20"
                                ToolTip="Reload (F5 / Ctrl + R)"/>
                    </StackPanel>

                    <controls:Omnibox x:Name="OmniboxControl" Grid.Column="1" Margin="5,12" ToolTip="Search or Enter URL"/>

                    <Button x:Name="BtnCompactTabsBadge" Grid.Column="2"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="44,0,0,0"
                            Visibility="Collapsed"
                            Click="BtnCompactTabsBadge_Click"
                            Style="{StaticResource Style_StealthButton}"
                            Height="42" Padding="12,0"
                            FontSize="13"
                            ToolTip="All tabs — click to switch (Tab Switcher)"/>

                    <!-- Install as Web App button (shown between omnibox and tabs) -->
                    <Button x:Name="BtnInstallWebApp" Grid.Column="2"
                            Click="BtnInstallWebApp_Click"
                            Style="{StaticResource Style_StealthButton}"
                            Width="36" Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            ToolTip="Install as Web App"
                            Visibility="Collapsed">
                        <TextBlock Text="&#xEBD3;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <ListBox x:Name="ListTabs" Grid.Column="2"
                             Margin="44,0,0,0"
                             ItemsSource="{Binding Tabs}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VerticalAlignment="Center"
                             SelectionChanged="Tabs_SelectionChanged">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <EventSetter Event="MouseEnter" Handler="MediaTab_MouseEnter"/>
                                <EventSetter Event="MouseLeave" Handler="MediaTab_MouseLeave"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            
                                            <Grid VerticalAlignment="Center"
                                                  AllowDrop="True"
                                                  PreviewMouseLeftButtonDown="TabHeader_MouseLeftButtonDown"
                                                  MouseMove="TabHeader_MouseMove"
                                                  MouseLeftButtonUp="TabHeader_MouseLeftButtonUp"
                                                  DragOver="TabHeader_DragOver"
                                                  Drop="TabHeader_Drop">

                                                <Grid.ContextMenu>
                                                    <ContextMenu Opened="TabContextMenu_Opened">
                                                        <MenuItem Header="Duplicate Tab"       Tag="dup"  Click="TabMenu_Duplicate"/>
                                                        <MenuItem Header="Rename Tab"          Tag="ren"  Click="TabMenu_Rename"/>
                                                        <MenuItem Header="Change Tab Position" Tag="pos"  Click="TabMenu_ChangePosition"/>
                                                        <MenuItem Header="Bring Tab to Top"    Tag="top"  Click="TabMenu_BringToTop"/>
                                                        <Separator/>
                                                        <MenuItem Header="Tab Language" Tag="__lang_parent__"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="MnuMultiTabActions2" Header="⚡ Multi-Tab Actions…" Tag="multi" Click="TabMenu_OpenMultiContext" FontWeight="SemiBold" Visibility="Collapsed"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <Border x:Name="BaseBorder"
                                                        Background="#222" CornerRadius="8"
                                                        Margin="1.9,0" Width="{Binding TabWidth}" MinHeight="47" MaxHeight="47"
                                                        BorderBrush="#333" BorderThickness="1"
                                                        VerticalAlignment="Center"/>

                                                <Border x:Name="TabBorder"
                                                        Background="{Binding AnimatedBrush}"
                                                        CornerRadius="8" Margin="1.9,0" Width="{Binding TabWidth}" MinHeight="47" MaxHeight="47"
                                                        BorderBrush="#00000000" BorderThickness="1"
                                                        VerticalAlignment="Center">

                                                    <Grid ClipToBounds="True">
                                                        
                                                        <Border CornerRadius="8" ClipToBounds="True">
                                                            <Rectangle Fill="{Binding SingleColorBrush}" Opacity="{Binding LoadingOpacity}" RenderTransformOrigin="0,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding LoadingProgress}" ScaleY="1"/>
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                        </Border>

                                                        <StackPanel x:Name="NormalTitlePanel"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0,22,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActiveDownload}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasEverDownloaded}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Ellipse x:Name="AudioDot"
                                                                     Width="5" Height="5" Fill="White"
                                                                     Margin="0,0,5,0"
                                                                     Visibility="Collapsed"
                                                                     VerticalAlignment="Center"
                                                                     Opacity="0.85"/>
                                                            <!-- Sleeping indicator -->
                                                            <TextBlock Text="💤" FontSize="9"
                                                                       Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock x:Name="TxtTabDisplayTitle"
                                                                       Text="{Binding DisplayTitle}"
                                                                       Foreground="{Binding TitleForeground}"
                                                                       FontWeight="SemiBold" FontSize="12"
                                                                       MaxWidth="200"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Domain tooltip hover panel — shows domain (e.g. accounts.google.com) while default shows full title (Gmail) -->
                                                        <Border x:Name="FullTitleHoverPanel"
                                                                Opacity="0" IsHitTestVisible="False"
                                                                Background="#1A1A1A" CornerRadius="4"
                                                                BorderBrush="#444" BorderThickness="1"
                                                                Padding="6,3" Margin="4,0,22,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DomainTitle}"
                                                                       Foreground="{Binding TitleForeground}"
                                                                       FontSize="11" FontWeight="Normal"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="220"/>
                                                        </Border>

                                                        <Border x:Name="IdleTitlePanel"
                                                                Opacity="0"
                                                                ClipToBounds="True"
                                                                Margin="2,0,20,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="{Binding TitleForeground}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="95"/>
                                                                <TextBlock Text="🎵" FontSize="9" Margin="4,0,0,0"
                                                                           Foreground="{Binding TitleForeground}"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAudioOnlyMode}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border x:Name="IdleDownloadPanel"
                                                                Opacity="0" ClipToBounds="True"
                                                                Margin="2,0,20,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch">
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="⬇" FontSize="9" Margin="0,0,4,0"
                                                                           Foreground="{Binding TitleForeground}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DownloadFileName}"
                                                                           Foreground="{Binding TitleForeground}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="95"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <Grid x:Name="HoverContentPanel"
                                                              Opacity="0" IsHitTestVisible="False"
                                                              Margin="4,2,22,2"
                                                              PreviewMouseRightButtonUp="HoverMediaPanel_SuppressContextMenu">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Grid Grid.Column="0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>

                                                                <Border Grid.Row="0" ClipToBounds="True"
                                                                        VerticalAlignment="Center"
                                                                        SizeChanged="MarqueeBorder_SizeChanged">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="HoverMarqueeText"
                                                                                   Text="{Binding Title}"
                                                                                   Foreground="{Binding TitleForeground}"
                                                                                   FontWeight="SemiBold" FontSize="10"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Left"
                                                                                   TextWrapping="NoWrap"
                                                                                   SizeChanged="HoverMarquee_SizeChanged">
                                                                            <TextBlock.RenderTransform>
                                                                                <TranslateTransform x:Name="HoverMarqueeTT" X="0"/>
                                                                            </TextBlock.RenderTransform>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>

                                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="⏮" Click="BtnMediaBack_Click"
                                                                            PreviewMouseRightButtonDown="BtnMediaBack_RightClick"
                                                                            Width="26" Height="22" FontSize="12"
                                                                            Background="Transparent"
                                                                            Foreground="{Binding TitleForeground}"
                                                                            BorderThickness="0" Cursor="Hand"
                                                                            ContextMenu="{x:Null}"
                                                                            ToolTip="⏮ Left-click: -10s  |  Right-click: Previous Track">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                    <Button x:Name="BtnPlayPause" Content="⏸" Click="BtnMediaPlayPause_Click"
                                                                            Width="26" Height="22" FontSize="12"
                                                                            Background="Transparent"
                                                                            Foreground="{Binding TitleForeground}"
                                                                            BorderThickness="0" Cursor="Hand"
                                                                            ContextMenu="{x:Null}">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                    <Button Content="⏭" Click="BtnMediaForward_Click"
                                                                            PreviewMouseRightButtonDown="BtnMediaForward_RightClick"
                                                                            Width="26" Height="22" FontSize="12"
                                                                            Background="Transparent"
                                                                            Foreground="{Binding TitleForeground}"
                                                                            BorderThickness="0" Cursor="Hand"
                                                                            ContextMenu="{x:Null}"
                                                                            ToolTip="⏭ Left-click: +10s  |  Right-click: Next Track">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                    <Button x:Name="BtnMute" Content="🔊" Click="BtnMediaMute_Click"
                                                                            Width="26" Height="22" FontSize="12"
                                                                            Background="Transparent"
                                                                            Foreground="{Binding TitleForeground}"
                                                                            BorderThickness="0" Cursor="Hand"
                                                                            ContextMenu="{x:Null}">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                    <ToggleButton x:Name="BtnTools" Content="···"
                                                                                  Width="24" Height="22" FontSize="12"
                                                                                  Background="Transparent"
                                                                                  Foreground="{Binding TitleForeground}"
                                                                                  BorderThickness="0" Cursor="Hand"
                                                                                  ContextMenu="{x:Null}">
                                                                        <ToggleButton.Resources>
                                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                        </ToggleButton.Resources>
                                                                    </ToggleButton>
                                                                </StackPanel>
                                                            </Grid>

                                                            

                                                            <Popup x:Name="ToolsPopup"
                                                                   IsOpen="{Binding IsChecked, ElementName=BtnTools}"
                                                                   PlacementTarget="{Binding ElementName=BaseBorder}"
                                                                   Placement="Bottom"
                                                                   StaysOpen="False"
                                                                   AllowsTransparency="True">
                                                                <Border Background="#2A2A2D" BorderBrush="#555" BorderThickness="1"
                                                                        CornerRadius="7" Padding="8,6">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.7"/>
                                                                    </Border.Effect>
                                                                    <StackPanel Orientation="Vertical" MinWidth="160">
                                                                        <Button Click="BtnMediaMiniPlayer_Click"
                                                                                HorizontalContentAlignment="Left"
                                                                                Height="28" Background="Transparent"
                                                                                Foreground="#DDD" BorderThickness="0"
                                                                                Cursor="Hand" Padding="4,0">
                                                                            <Button.ToolTip><ToolTip Content="Toggle Picture-in-Picture"/></Button.ToolTip>
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="⧉" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Picture-in-Picture" FontSize="11" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <Button.Resources>
                                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                            </Button.Resources>
                                                                        </Button>
                                                                        <Button Click="BtnMediaAudioOnly_Click"
                                                                                HorizontalContentAlignment="Left"
                                                                                Height="28" Background="Transparent"
                                                                                Foreground="#DDD" BorderThickness="0"
                                                                                Cursor="Hand" Padding="4,0">
                                                                            <Button.ToolTip><ToolTip Content="Toggle Audio Only Mode"/></Button.ToolTip>
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="🎵" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Audio Only" FontSize="11" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <Button.Resources>
                                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                                                           </Button.Resources>
                                                                        </Button>
                                                                        <Separator Background="#444" Margin="0,4"/>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                                                            <TextBlock Text="🔉" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                                <TextBlock.ToolTip><ToolTip Content="Volume"/></TextBlock.ToolTip>
                                                                            </TextBlock>
                                                                            <Slider Minimum="0" Maximum="100" Value="100"
                                                                                    Width="100" VerticalAlignment="Center"
                                                                                    ValueChanged="SliderVolume_ValueChanged">
                                                                                <Slider.ToolTip><ToolTip Content="Volume"/></Slider.ToolTip>
                                                                            </Slider>
                                                                            <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Popup>
                                                        </Grid>

                                                        <Grid x:Name="DownloadHoverPanel"
                                                              Opacity="0" IsHitTestVisible="False"
                                                              Margin="4,2,22,2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding DownloadFileName}"
                                                                           Foreground="{Binding TitleForeground}"
                                                                           FontWeight="SemiBold" FontSize="10"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="110"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DownloadSpeedText}"
                                                                               Foreground="#4A9EFF" FontSize="9"
                                                                               VerticalAlignment="Center"
                                                                               Margin="4,0,4,0"/>
                                                                    <Button Tag="DlPause" Content="⏸"
                                                                            Click="BtnTabDlPause_Click"
                                                                            Width="18" Height="16" FontSize="9"
                                                                            Background="Transparent" Foreground="#CCC"
                                                                            BorderThickness="0" Cursor="Hand"
                                                                            ContextMenu="{x:Null}" ToolTip="Pause / Resume">
                                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                                                    </Button>
                                                                    <Button Content="✕"
                                                                            Click="BtnTabDlCancel_Click"
                                                                            Width="16" Height="16" FontSize="9"
                                                                            Background="Transparent" Foreground="#FF6666"
                                                                            BorderThickness="0" Cursor="Hand"
                                                                            ContextMenu="{x:Null}" ToolTip="Cancel Download">
                                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressBar Grid.Column="0"
                                                                             Value="{Binding DownloadProgressValue}"
                                                                             Minimum="0" Maximum="1"
                                                                             Height="5" VerticalAlignment="Center"
                                                                             Background="#333" Foreground="#4A9EFF"
                                                                             BorderThickness="0"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DownloadEtaText}"
                                                                           Foreground="#888" FontSize="9"
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Grid>

                                                        <Button x:Name="BtnClose"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Margin="0,0,4,0"
                                                                Content="✕" Click="BtnCloseTab_Click"
                                                                Width="16" Height="16" FontSize="9"
                                                                Background="Transparent" Foreground="#888"
                                                                BorderThickness="0" Panel.ZIndex="10">
                                                            <Button.ToolTip>
                                                                <ToolTip Content="Close Tab (Ctrl + W)"/>
                                                            </Button.ToolTip>
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="8"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BaseBorder" Property="Background" Value="#333"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="BaseBorder" Property="Background" Value="#444"/>
                                                    <Setter TargetName="BaseBorder" Property="BorderBrush" Value="#555"/>
                                                </Trigger>
                                                <!-- Multi-select highlight (Ctrl/Shift-click) -->
                                                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                                    <Setter TargetName="BaseBorder" Property="Background" Value="#1A3A5C"/>
                                                    <Setter TargetName="BaseBorder" Property="BorderBrush" Value="#2E6AA0"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                    <Setter TargetName="AudioDot" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMediaPaused}" Value="True">
                                                    <Setter TargetName="AudioDot" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsPlayingAudio}" Value="False">
                                                    <Setter TargetName="BtnPlayPause" Property="Content" Value="▶"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter TargetName="BtnMute" Property="Content" Value="🔇"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding HasEverPlayedAudio}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="NormalTitlePanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.96"/>
                                                                <DoubleAnimation Storyboard.TargetName="IdleTitlePanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.96"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="NormalTitlePanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.96"/>
                                                                <DoubleAnimation Storyboard.TargetName="IdleTitlePanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.96"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding HasEverPlayedAudio}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>

                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="IdleTitlePanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0" Duration="0:0:0.72"/>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="HoverContentPanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1" Duration="0:0:0.72">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <BooleanAnimationUsingKeyFrames
                                                                    Storyboard.TargetName="HoverContentPanel"
                                                                    Storyboard.TargetProperty="IsHitTestVisible">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0" Value="True"/>
                                                                </BooleanAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>

                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard FillBehavior="Stop">
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="HoverContentPanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0" Duration="0:0:0.72"/>
                                                                <BooleanAnimationUsingKeyFrames
                                                                    Storyboard.TargetName="HoverContentPanel"
                                                                    Storyboard.TargetProperty="IsHitTestVisible">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0" Value="False"/>
                                                                </BooleanAnimationUsingKeyFrames>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="IdleTitlePanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1" Duration="0:0:0.72">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding HasEverPlayedAudio}" Value="True"/>
                                                        <Condition Binding="{Binding IsMarqueeNeeded}" Value="True"/>
                                                        <Condition Binding="{Binding IsMarqueeEnabled}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="MarqueeAnim">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimationUsingKeyFrames
                                                                    Storyboard.TargetName="HoverMarqueeTT"
                                                                    Storyboard.TargetProperty="X">
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0"    Value="160"/>
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:4.5"  Value="-200"/>
                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:5.0" Value="160"/>
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="MarqueeAnim"/>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="HoverMarqueeTT"
                                                                    Storyboard.TargetProperty="X"
                                                                    To="0" Duration="0:0:0.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>

                                                <!-- Domain-only hover: show full title on mouse-over (only when tab is NOT in media or download mode) -->
                                                                    <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                        <Condition Binding="{Binding HasEverDownloaded}" Value="True"/>
                                                                        <Condition Binding="{Binding HasEverPlayedAudio}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="IdleDownloadPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
                                                                                <DoubleAnimation Storyboard.TargetName="DownloadHoverPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.96">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="DownloadHoverPanel" Storyboard.TargetProperty="IsHitTestVisible">
                                                                                    <DiscreteBooleanKeyFrame KeyTime="0" Value="True"/>
                                                                                </BooleanAnimationUsingKeyFrames>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard FillBehavior="Stop">
                                                                                <DoubleAnimation Storyboard.TargetName="DownloadHoverPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="DownloadHoverPanel" Storyboard.TargetProperty="IsHitTestVisible">
                                                                                    <DiscreteBooleanKeyFrame KeyTime="0" Value="False"/>
                                                                                </BooleanAnimationUsingKeyFrames>
                                                                                <DoubleAnimation Storyboard.TargetName="IdleDownloadPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.96">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>

                                                                <!-- Download idle: show ⬇ + filename (mirrors media HasEverPlayedAudio pattern) -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasEverDownloaded}" Value="True"/>
                                                                        <Condition Binding="{Binding HasEverPlayedAudio}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="NormalTitlePanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.96"/>
                                                                                <DoubleAnimation Storyboard.TargetName="IdleDownloadPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.96"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="NormalTitlePanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.96"/>
                                                                                <DoubleAnimation Storyboard.TargetName="IdleDownloadPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.96"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>

                                                                

                                                <!-- Domain-only hover: show full title on mouse-over (only when tab is NOT in media or download mode) -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding HasEverPlayedAudio}" Value="False"/>
                                                        <Condition Binding="{Binding HasEverDownloaded}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FullTitleHoverPanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1" Duration="0:0:0.4">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="NormalTitlePanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0" Duration="0:0:0.25"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FullTitleHoverPanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0" Duration="0:0:0.4"/>
                                                                <DoubleAnimation Storyboard.TargetName="NormalTitlePanel"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1" Duration="0:0:0.4">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>

                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0,10,0">
                        <!-- ── Update install banner (persistent until dismissed/clicked) ──── -->
                        <StackPanel x:Name="PanelUpdateBanner" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                            <Button x:Name="BtnInstallUpdate" Click="BtnInstallUpdate_Click"
                                    Background="#0D1A2A" Foreground="#00D9FF" BorderBrush="#00D9FF" BorderThickness="1"
                                    Height="35" Padding="14,0" Cursor="Hand" FontWeight="Bold" FontSize="12"
                                    Content="⬆ INSTALL UPDATE"
                                    ToolTip="Closes Horizon, backs up your data, installs the update, then restores and relaunches."/>
                            <Button x:Name="BtnDismissUpdateBanner" Content="✕" Click="BtnDismissUpdateBanner_Click"
                                    Style="{StaticResource Style_StealthButton}" Width="28" Height="28" FontSize="11"
                                    Margin="4,0,0,0" ToolTip="Dismiss (you can install later from Settings)"/>
                        </StackPanel>
                        <!-- ── Widget nav buttons ─────────────────────────── -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button x:Name="BtnWidgetPrev" Content="▲"
                                    Style="{StaticResource Style_StealthButton}"
                                    Width="22" Height="20" FontSize="11" Padding="0"
                                    Click="BtnWidgetPrev_Click"
                                    MouseRightButtonUp="BtnWidgetNav_RightClick"
                                    ToolTip="Previous widget (right-click to pick)"/>
                            <Button x:Name="BtnWidgetNext" Content="▼"
                                    Style="{StaticResource Style_StealthButton}"
                                    Width="22" Height="20" FontSize="11" Padding="0"
                                    Click="BtnWidgetNext_Click"
                                    MouseRightButtonUp="BtnWidgetNav_RightClick"
                                    ToolTip="Next widget (right-click to pick)"/>
                        </StackPanel>
                        <!-- ── Header Widget ──────────────────────────────── -->
                        <Border x:Name="HeaderWidgetBorder"
                                Width="146" Height="42"
                                Background="#141414" BorderBrush="#2a2a2a" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,6,0" Cursor="Hand"
                                VerticalAlignment="Center"
                                MouseRightButtonUp="HeaderWidget_RightClick"
                                MouseWheel="HeaderWidget_MouseWheel"
                                MouseEnter="HeaderWidget_MouseEnter"
                                MouseLeave="HeaderWidget_MouseLeave"
                                MouseLeftButtonDown="HeaderWidget_MouseDown"
                                MouseMove="HeaderWidget_MouseMove"
                                MouseLeftButtonUp="HeaderWidget_MouseUp"
                                ToolTip="Click or swipe ↑: open controls · Swipe ←/→: cycle modes · Scroll: cycle modes · Right-click or swipe ↓: options">
                            <Grid ClipToBounds="True">
                                <!-- Normal text display (clock, cpu, etc.) -->
                                <TextBlock x:Name="TxtWidget"
                                           Foreground="#dddddd" FontSize="16" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="--:--"/>
                                <!-- Seconds-in-corner sub-text (clock mode 3 only) -->
                                <TextBlock x:Name="TxtWidgetSub"
                                           Foreground="#888888" FontSize="11" FontFamily="Consolas"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Margin="0,0,5,3" Text=""/>
                                
                                <!-- Media: audio visualizer (audio-only playing) -->
                                <Canvas x:Name="WidgetVizCanvas"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <!-- Media: video thumbnail display -->
                                <Image x:Name="WidgetVideoImage"
                                       Visibility="Collapsed"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <Button Content="&#x2795;" Click="BtnNewTab_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="18"
                                ToolTip="New Tab (Ctrl + T)"/>
                        <Button Content="⚙" Click="BtnSettings_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="18"
                                ToolTip="Configuration"/>
                        <Button Content="◫" Click="ToggleSidebar_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="18"
                                ToolTip="Toggle Sidebar"/>
                        <Rectangle Width="1" Fill="#333" Margin="8,15"/>
                        <Button Content="🗕" Click="BtnMinimize_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42"
                                ToolTip="Minimize"/>
                        <Button Content="🗖" Click="BtnMaximize_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42"
                                ToolTip="Maximize / Restore"/>
                        <Button Content="✕" Click="BtnClose_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42"
                                Foreground="{StaticResource Brush_Alert}" ToolTip="Close Horizon"/>
                    </StackPanel>

                </Grid>
            </Grid>

            <!-- ── Mobile / Compact Header (2-row stacked layout) ──────────── -->
            <Grid x:Name="MobileHeaderContainer"
                  Grid.Row="0" Grid.ColumnSpan="2"
                  Visibility="Collapsed"
                  Background="{StaticResource Brush_DeepBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Nav + Tab badge + Actions + Window chrome -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back / Forward / Reload -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,0">
                        <Button x:Name="MBtnBack" Content="🠔" Click="BtnBack_Click"
                                MouseRightButtonUp="BtnBack_RightClick"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38" FontSize="18"
                                ToolTip="Back"/>
                        <Button x:Name="MBtnForward" Content="🠖" Click="BtnForward_Click"
                                MouseRightButtonUp="BtnForward_RightClick"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38" FontSize="18"
                                ToolTip="Forward"/>
                        <Button Content="↻" Click="BtnReload_Click"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38" FontSize="18"
                                ToolTip="Reload"/>
                    </StackPanel>

                    <!-- Centre-left: Tab badge -->
                    <Button x:Name="MBtnTabBadge"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="4,0"
                            Click="BtnCompactTabsBadge_Click"
                            Style="{StaticResource Style_StealthButton}"
                            Height="38" Padding="10,0"
                            FontSize="13"
                            ToolTip="All tabs"/>

                    <!-- Centre spacer — drag handle -->
                    <Border Grid.Column="2"
                            Background="Transparent"/>

                    <!-- Right: actions + window chrome -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="&#x2795;" Click="BtnNewTab_Click"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38" FontSize="16"
                                ToolTip="New Tab"/>
                        <Button Content="⚙" Click="BtnSettings_Click"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38" FontSize="16"
                                ToolTip="Settings"/>
                        <Button Content="◫" Click="ToggleSidebar_Click"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38" FontSize="16"
                                ToolTip="Toggle Sidebar"/>
                        <Rectangle Width="1" Fill="#333" Margin="6,12"/>
                        <Button Content="🗕" Click="BtnMinimize_Click"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38"
                                ToolTip="Minimize"/>
                        <Button Content="🗖" Click="BtnMaximize_Click"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38"
                                ToolTip="Maximize"/>
                        <Button Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource Style_StealthButton}"
                                Width="38" Height="38"
                                Foreground="{StaticResource Brush_Alert}"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Full-width Omnibox -->
                <controls:Omnibox x:Name="MobileOmniboxControl"
                                  Grid.Row="1"
                                  Margin="8,6"
                                  ToolTip="Search or Enter URL"/>
            </Grid>

            <ListBox x:Name="ListOverflowTabs" Grid.Row="1" Grid.ColumnSpan="2"
                     ItemsSource="{Binding OverflowTabs}"
                     Background="{StaticResource Brush_DeepBackground}"
                     BorderThickness="0,1,0,0" BorderBrush="#333"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VerticalAlignment="Top"
                     Margin="0,0,16,0"
                     Height="50"
                     Visibility="Collapsed"
                     SelectionChanged="Tabs_SelectionChanged">

                <ListBox.Resources>
                    <Style x:Key="OverflowScrollThumb" TargetType="Thumb">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#3A3A3A" CornerRadius="3" Margin="2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="42"/>
                        <Setter Property="SmallChange" Value="42"/>
                        <Setter Property="LargeChange" Value="42"/>
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="#1A1A1A">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="15"/>
                                            <RowDefinition Height="4"/>
                                            <RowDefinition Height="15"/>
                                        </Grid.RowDefinitions>

                                        <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Focusable="False">
                                            <RepeatButton.Style>
                                                <Style TargetType="RepeatButton">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="RepeatButton">
                                                                <Border x:Name="ArrowBorder" Background="#333" CornerRadius="3,3,0,0">
                                                                    <TextBlock x:Name="ArrowText" Text="🔼" FontSize="9"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ArrowBorder" Property="Background" Value="#4A4A4A"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ArrowBorder" Property="Background" Value="#5C9AE0"/>
                                                                        <Setter TargetName="ArrowText" Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <ScaleTransform ScaleX="0.85" ScaleY="0.85" CenterX="10" CenterY="8"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </RepeatButton.Style>
                                        </RepeatButton>

                                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource OverflowScrollThumb}"/>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>

                                        <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Focusable="False">
                                            <RepeatButton.Style>
                                                <Style TargetType="RepeatButton">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="RepeatButton">
                                                                <Border x:Name="ArrowBorder" Background="#333" CornerRadius="0,0,3,3">
                                                                    <TextBlock x:Name="ArrowText" Text="🔽" FontSize="9"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ArrowBorder" Property="Background" Value="#4A4A4A"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ArrowBorder" Property="Background" Value="#5C9AE0"/>
                                                                        <Setter TargetName="ArrowText" Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <ScaleTransform ScaleX="0.85" ScaleY="0.85" CenterX="10" CenterY="8"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </RepeatButton.Style>
                                        </RepeatButton>

                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="TabBorder" Background="#1C1E24" CornerRadius="7" Margin="1.9,2" Width="{Binding TabWidth}" Height="42" BorderBrush="#2A2E38" BorderThickness="1"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="TabHeader_MouseLeftButtonDown"
                                                MouseMove="TabHeader_MouseMove"
                                                MouseLeftButtonUp="TabHeader_MouseLeftButtonUp"
                                                DragOver="TabHeader_DragOver"
                                                Drop="TabHeader_Drop">

                                            <Border.ContextMenu>
                                                <ContextMenu Opened="TabContextMenu_Opened">
                                                    <MenuItem Header="Duplicate Tab"       Tag="dup"  Click="TabMenu_Duplicate"/>
                                                    <MenuItem Header="Rename Tab"          Tag="ren"  Click="TabMenu_Rename"/>
                                                    <MenuItem Header="Change Tab Position" Tag="pos"  Click="TabMenu_ChangePosition"/>
                                                    <MenuItem Header="Bring Tab to Top"    Tag="top"  Click="TabMenu_BringToTop"/>
                                                    <Separator/>
                                                    <MenuItem Header="Tab Language" Tag="__lang_parent__"/>
                                                    <Separator/>
                                                    <MenuItem x:Name="MnuMultiTabActions1" Header="⚡ Multi-Tab Actions…" Tag="multi" Click="TabMenu_OpenMultiContext" FontWeight="SemiBold" Visibility="Collapsed"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <!-- FIX: Download/loading progress was missing from secondary bar.
                                                 Wrap content in a Grid so the progress rectangle can underlay it. -->
                                            <Grid>
                                                <!-- Animated color gradient layer (matches primary bar behavior) -->
                                                <Border CornerRadius="7" ClipToBounds="True"
                                                        Background="{Binding AnimatedBrush}"/>
                                                <!-- Loading progress sweep -->
                                                <Border CornerRadius="7" ClipToBounds="True">
                                                    <Rectangle Fill="{Binding SingleColorBrush}" Opacity="{Binding LoadingOpacity}" RenderTransformOrigin="0,0.5">
                                                        <Rectangle.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding LoadingProgress}" ScaleY="1"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                </Border>
                                                <!-- Hover glow overlay (animated in triggers) -->
                                                <Border x:Name="HoverHighlight" CornerRadius="7" Opacity="0"
                                                        Background="#10FFFFFF" IsHitTestVisible="False"/>
                                                <!-- Selected accent overlay (animated in triggers) -->
                                                <Border x:Name="SelectHighlight" CornerRadius="7" Opacity="0"
                                                        Background="#285B9BD5" IsHitTestVisible="False"/>

                                            <Grid Margin="10,0,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse x:Name="OverflowAudioDot"
                                                         Grid.Column="0"
                                                         Width="5" Height="5" Fill="White"
                                                         Margin="0,0,5,0"
                                                         Visibility="Collapsed"
                                                         VerticalAlignment="Center"
                                                         Opacity="0.85"/>

                                                <TextBlock x:Name="OverflowTitleText" Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="{Binding TitleForeground}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="{Binding TabWidth}"
                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Border x:Name="OverflowDomainHover" Grid.Column="1"
                                                        Opacity="0" IsHitTestVisible="False"
                                                        Background="#1A1A1A" CornerRadius="3"
                                                        BorderBrush="#444" BorderThickness="1"
                                                        Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DomainTitle}" Foreground="#cccccc" FontSize="10"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="180" TextWrapping="NoWrap"/>
                                                </Border>
                                                           

                                                <Button x:Name="BtnClose" Grid.Column="2" Content="✕"
                                                        Click="BtnCloseTab_Click"
                                                        Width="16" Height="16" FontSize="9"
                                                        Background="Transparent" Foreground="#888" BorderThickness="0"
                                                        Visibility="Visible"
                                                        ToolTip="Close Tab">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                            </Grid>

                                        </Border>

                                        <Popup x:Name="OverflowMediaPopup"
                                               PlacementTarget="{Binding ElementName=TabBorder}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               IsOpen="False">
                                            <Border Background="#2A2A2D" BorderBrush="#555" BorderThickness="1"
                                                    CornerRadius="7" Padding="8,6" MinWidth="200">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.7"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding CleanMediaTitle}" Foreground="#CCC" FontSize="10"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                               Margin="4,0,4,6" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                        <Button Content="⏮" Click="BtnMediaBack_Click"
                                                                PreviewMouseRightButtonDown="BtnMediaBack_RightClick"
                                                                Width="26" Height="22" FontSize="12"
                                                                Background="Transparent" Foreground="#DDD"
                                                                BorderThickness="0" Cursor="Hand"
                                                                ContextMenu="{x:Null}"
                                                                ToolTip="⏮ Left-click: -10s  |  Right-click: Previous Track">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="OverflowBtnPlayPause" Content="⏸" Click="BtnMediaPlayPause_Click"
                                                                Width="26" Height="22" FontSize="12"
                                                                Background="Transparent" Foreground="#DDD"
                                                                BorderThickness="0" Cursor="Hand"
                                                                ContextMenu="{x:Null}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button Content="⏭" Click="BtnMediaForward_Click"
                                                                PreviewMouseRightButtonDown="BtnMediaForward_RightClick"
                                                                Width="26" Height="22" FontSize="12"
                                                                Background="Transparent" Foreground="#DDD"
                                                                BorderThickness="0" Cursor="Hand"
                                                                ContextMenu="{x:Null}"
                                                                ToolTip="⏭ Left-click: +10s  |  Right-click: Next Track">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                        <Button x:Name="OverflowBtnMute" Content="🔊" Click="BtnMediaMute_Click"
                                                                Width="26" Height="22" FontSize="12"
                                                                Background="Transparent" Foreground="#DDD"
                                                                BorderThickness="0" Cursor="Hand"
                                                                ContextMenu="{x:Null}">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,2">
                                                        <TextBlock Text="🔉" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <Slider Minimum="0" Maximum="100" Value="100"
                                                                Width="110" VerticalAlignment="Center"
                                                                ValueChanged="SliderVolume_ValueChanged"/>
                                                        <TextBlock Text="🔊" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <!-- Fade-in when tab first appears in overflow bar -->
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                        From="0" To="1" Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <!-- Hover: fade in white glow overlay -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverHighlight"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="1" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverHighlight"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <!-- Selected: blue bottom accent border + animated blue overlay -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SelectHighlight"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SelectHighlight"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4A8FD4"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,3"/>
                                        </Trigger>
                                        <!-- Multi-select highlight (Ctrl/Shift-click) -->
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1A3A5C"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2E6AA0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                            <Setter TargetName="OverflowAudioDot" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="OverflowAudioDot" Property="Fill" Value="#00FF00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMediaPaused}" Value="True">
                                            <Setter TargetName="OverflowAudioDot" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="OverflowAudioDot" Property="Fill" Value="#888888"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="False">
                                            <Setter TargetName="OverflowBtnPlayPause" Property="Content" Value="▶"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter TargetName="OverflowBtnMute" Property="Content" Value="🔇"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding HasEverPlayedAudio}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="OverflowMediaPopup" Property="IsOpen" Value="True"/>
                                        </MultiDataTrigger>
                                        <!-- Domain hover: mirrors primary tab bar behaviour for non-media/download tabs -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding HasEverPlayedAudio}" Value="False"/>
                                                                <Condition Binding="{Binding IsActiveDownload}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="OverflowDomainHover"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="OverflowTitleText"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="OverflowDomainHover"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0" Duration="0:0:0.3"/>
                                                        <DoubleAnimation Storyboard.TargetName="OverflowTitleText"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Expand / collapse all overflow rows -->
            <Button x:Name="BtnExpandOverflow"
                    Grid.Row="1" Grid.ColumnSpan="2"
                    Width="20" Height="50"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Content="▼" FontSize="10"
                    Background="#1A1A1A" Foreground="#888"
                    BorderBrush="#333" BorderThickness="1,1,0,0"
                    Cursor="Hand" Panel.ZIndex="2"
                    Visibility="Collapsed"
                    Click="BtnExpandOverflow_Click"
                    MouseRightButtonUp="BtnExpandOverflow_RightClick"
                    ToolTip="Show / collapse all overflow tabs">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                </Button.Resources>
            </Button>

            <!-- Margin="0,0,1,0": keeps the HWND 1 px shy of the right edge so
                 SensorRight (HorizontalAlignment=Right in the ZIndex=999 overlay)
                 is never fully covered by the WebView2 HWND — fixes auto-hide sidebar. -->
            <Grid x:Name="ViewContainer" Grid.Row="3" Grid.Column="0" Margin="0,0,1,0"/>

            <Grid x:Name="SidebarContainer" Grid.Row="3" Grid.Column="1" Width="0">
                <controls:FluxSidebar x:Name="RightSidebar"/>
            </Grid>

            <!-- Notification row: lives in Row 2 (pure WPF layout, above WebView2 HWND) -->
            <!-- This avoids the WPF/Win32 airspace problem where HWND always renders on top -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Brush_DeepBackground}">

                <!-- Session Restore Banner -->
                <Border x:Name="RestoreBanner"
                        Visibility="Collapsed"
                        Background="#1E3A5F" BorderBrush="#2E5A8F" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗃 Restore previous session?" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="RESTORE" Click="BtnRestoreSession_Click"
                                Background="{StaticResource Brush_Accent}" Foreground="Black" FontWeight="Bold"
                                Padding="10,4" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                        </Button>
                        <Button Content="✕" Click="BtnDismissRestore_Click"
                                Background="Transparent" Foreground="#888" BorderThickness="0"
                                Margin="10,0,0,0" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Image Detected Banner -->
                <Border x:Name="OverlaySingleImage"
                        Visibility="Collapsed"
                        Background="#1E3A1E" BorderBrush="#2E6A2E" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖼 Image detected — open as standalone" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>
                        <Button Content="DOWNLOAD" Click="BtnDownloadImage_Click"
                                Background="{StaticResource Brush_Accent}" Foreground="Black" FontWeight="Bold"
                                Padding="10,4" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                        </Button>
                        <Button Content="✕" Click="BtnDismissImageOverlay_Click"
                                Background="Transparent" Foreground="#888" BorderThickness="0"
                                Margin="10,0,0,0" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── Widget Context Popup ─────────────────────────────────────────── -->
            <Popup x:Name="WidgetContextPopup" StaysOpen="False" AllowsTransparency="True" Placement="MousePoint">
                <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.6"/></Border.Effect>
                    <StackPanel MinWidth="210">
                        <TextBlock Text="WIDGET ORDER" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="≡ drag to reorder  ·  ▲▼ buttons below" Foreground="#444" FontSize="9" Margin="0,0,0,8"/>
                        <ListBox x:Name="LstWidgetOrder"
                                 Background="Transparent" BorderThickness="0"
                                 AllowDrop="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="WidgetList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="WidgetList_PreviewMouseMove"
                                 Drop="WidgetList_Drop"
                                 MouseRightButtonUp="LstWidgetOrder_RightClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2d2d2d"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#252525"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button x:Name="BtnWidgetMoveUp"   Content="▲" Click="BtnWidgetMoveUp_Click"
                                    Width="28" Height="22" Margin="0,0,4,0"
                                    Background="#252525" Foreground="#aaa" BorderBrush="#444" BorderThickness="1"
                                    ToolTip="Move selected widget up in cycle order"/>
                            <Button x:Name="BtnWidgetMoveDown" Content="▼" Click="BtnWidgetMoveDown_Click"
                                    Width="28" Height="22"
                                    Background="#252525" Foreground="#aaa" BorderBrush="#444" BorderThickness="1"
                                    ToolTip="Move selected widget down in cycle order"/>
                        </StackPanel>
                        <!-- Weather city — shown only when Weather is checked -->
                        <Grid x:Name="PnlWeatherCity" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="City: " Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtWeatherCity" Grid.Column="1"
                                     Background="#141414" Foreground="#ccc" BorderBrush="#444" BorderThickness="1"
                                     Padding="4,2" FontSize="12" KeyDown="TxtWeatherCity_KeyDown"
                                     LostFocus="TxtWeatherCity_LostFocus"
                                     ToolTip="Press Enter or click away to apply"/>
                        </Grid>
                        <Separator Background="#333" Margin="0,10"/>
                        <CheckBox x:Name="ChkWidgetDisableCycle"
                                  Content="🚫  Never auto-cycle"
                                  Click="WidgetModeCheck_Click"
                                  Foreground="#aaa" Margin="0,4,0,6"
                                  ToolTip="Disable automatic cycling; only scroll changes modes"/>
                        <StackPanel x:Name="PnlWidgetCycle">
                        <TextBlock Text="CYCLE EVERY  (0 = Off)" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderWidgetCycle" Minimum="0" Maximum="60" SmallChange="1" LargeChange="5"
                                    VerticalAlignment="Center" ValueChanged="SliderWidgetCycle_Changed"/>
                            <TextBlock x:Name="TxtWidgetCycleSecs" Grid.Column="1" Text="7s"
                                       Foreground="#aaa" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ── Tab Multi-select Context Popup ──────────────────────────────── -->
            <Popup x:Name="MultiTabContextPopup" StaysOpen="False" AllowsTransparency="True" Placement="MousePoint">
                <Border Background="#1e1e1e" BorderBrush="#2E6AA0" BorderThickness="1" CornerRadius="6" Padding="4">
                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.6"/></Border.Effect>
                    <StackPanel MinWidth="230">
                        <TextBlock x:Name="TxtMultiTabHeader" Text="2 TABS SELECTED"
                                   Foreground="#2E6AA0" FontSize="10" FontWeight="Bold" Margin="8,6,8,6"/>
                        <Separator Background="#2a2a2a" Margin="4,0"/>
                        <Button Content="📋  Duplicate All"        Click="MultiTab_Duplicate"       Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>
                        <Button Content="🏷  Rename All…"          Click="MultiTab_Rename"          Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>
                        <Separator Background="#2a2a2a" Margin="4,2"/>
                        <Button Content="⬆  Bring All to Top"     Click="MultiTab_BringToTop"      Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>
                        <Button Content="⬇  Send All to End"      Click="MultiTab_SendToEnd"       Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>
                        <Button Content="📦  Group Selected Tabs"  Click="MultiTab_Group"           Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#aaeebb"/>
                        <Separator Background="#2a2a2a" Margin="4,2"/>
                        <Button Content="✕  Close All Selected"   Click="MultiTab_CloseAll"        Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ee8888"/>
                        <Separator Background="#2a2a2a" Margin="4,2"/>
                        <Button Content="💤  Sleep All Selected"  Click="MultiTab_SleepAll"        Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#aaaaff"/>
                        <Button Content="☀  Wake All Selected"   Click="MultiTab_WakeAll"         Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#aaffaa"/>
                        <Separator Background="#2a2a2a" Margin="4,2"/>
                        <Button Content="✖  Cancel"               Click="MultiTab_Cancel"          Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ── Music / Video Widget Popup ─────────────────────────────────── -->
            <Popup x:Name="MusicWidgetPopup" StaysOpen="False" AllowsTransparency="True"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderWidgetBorder}">
                <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.7"/></Border.Effect>
                    <StackPanel MinWidth="240">
                        <TextBlock x:Name="MusicPopupTitleTxt" Text="Nothing playing"
                                   Foreground="#eee" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,0,0,2"/>
                        <TextBlock x:Name="MusicPopupTabTxt" Text=""
                                   Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock x:Name="MusicPopupStatusTxt" Text=""
                                   Foreground="#aaa" FontSize="10" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Content="⏮" Click="MusicPopupBack_Click" ContextMenu="{x:Null}"
                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"
                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"
                                    Cursor="Hand" Margin="2,0" ToolTip="Back 10s">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MusicPopupPlayBtn" Content="⏸" Click="MusicPopupPlay_Click" ContextMenu="{x:Null}"
                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"
                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"
                                    Cursor="Hand" Margin="2,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button Content="⏭" Click="MusicPopupForward_Click" ContextMenu="{x:Null}"
                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"
                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"
                                    Cursor="Hand" Margin="2,0" ToolTip="Forward 10s">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="MusicPopupMuteBtn" Content="🔊" Click="MusicPopupMute_Click" ContextMenu="{x:Null}"
                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"
                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"
                                    Cursor="Hand" Margin="2,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                        <Button Content="Go to tab →" Click="MusicPopupGoToTab_Click"
                                HorizontalContentAlignment="Center" Height="26"
                                Background="#252525" Foreground="#aaa"
                                BorderThickness="1" BorderBrush="#333" Cursor="Hand" FontSize="11">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ── Weather Detail Popup ──────────────────────────────────────── -->
            <Popup x:Name="WeatherDetailPopup" StaysOpen="False" AllowsTransparency="True"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderWidgetBorder}">
                <Border Background="#1e1e1e" BorderBrush="#2a5a8a" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.7"/></Border.Effect>
                    <StackPanel MinWidth="200">
                        <TextBlock Text="WEATHER" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="WeatherDetailTxt"
                                   Text="Loading…" Foreground="#ddd" FontSize="12"
                                   FontFamily="Consolas" TextWrapping="Wrap" MaxWidth="300" LineHeight="18"/>
                    </StackPanel>
                </Border>
            </Popup>

        </Grid>
    </Border>
</Window>