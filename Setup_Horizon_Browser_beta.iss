; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "Horizon_Browser"
#define MyAppVersion "2.7.9"
#define MyAppPublisher "Swordmaster_Studios Inc."
#define MyAppURL "https://github.com/MoRDekai1364/Horizon_Browser"
#define MyAppExeName "Horizon.Browser.exe"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".html, mhtml, .pdf"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{06A644B6-B05C-4E24-928F-296EFB497E0C}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\Horizon_Browser_Beta
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
; Uncomment the following line to use a 64-bit installer.
;SetupArchitecture=x64
ChangesAssociations=yes
DisableProgramGroupPage=yes
LicenseFile=D:\Programming\Personal_projects_D\Horizon_Browser\Horizon_Browser_official_release\LICENSE.txt
InfoBeforeFile=D:\Programming\Personal_projects_D\Horizon_Browser\Horizon_Browser_official_release\Hello.txt
InfoAfterFile=D:\Programming\Personal_projects_D\Horizon_Browser\Horizon_Browser_official_release\Finish.txt
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=D:\Programming\Personal_projects_D\Horizon_Browser\Horizon_Browser_AI_channel\horizon-browser\Output
OutputBaseFilename=Setup_Horizon_Browser_Official_Release
SetupIconFile=D:\Programming\Personal_projects_D\Horizon_Browser\Horizon_Browser_official_release\src\Gemini_Generated_Image_version2.ico
SolidCompression=yes
WizardStyle=modern stellar

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "D:\Programming\Personal_projects_D\Horizon_Browser\Horizon_Browser_AI_channel\horizon-browser\bin\Release\*"; DestDir: "{app}"; Excludes: "net8.0-windows*,logs\*,*.pdb"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: """{code:GetBrowserExePath}"",0"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{code:GetBrowserExePath}"" ""%1"""

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{code:GetBrowserExePath}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{code:GetBrowserExePath}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent; Check: ExeExistsAtAppRoot
Filename: "{app}\bin\Release\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent; Check: ExeExistsAtBinRelease

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
var
  AppRootExe, SubBinExe: string;
begin
  if CurStep = ssPostInstall then
  begin
    AppRootExe := ExpandConstant('{app}\Horizon.Browser.exe');
    SubBinExe := ExpandConstant('{app}\bin\Release\Horizon.Browser.exe');
    if (not FileExists(AppRootExe)) and FileExists(SubBinExe) then
    begin
      CopyFile(SubBinExe, AppRootExe, False);
    end;
  end;
end;

function ExeExistsAtAppRoot: Boolean;
begin
  Result := FileExists(ExpandConstant('{app}\Horizon.Browser.exe'));
end;

function ExeExistsAtBinRelease: Boolean;
begin
  Result := (not ExeExistsAtAppRoot) and FileExists(ExpandConstant('{app}\bin\Release\Horizon.Browser.exe'));
end;

function GetBrowserExePath(Param: String): String;
begin
  if FileExists(ExpandConstant('{app}\Horizon.Browser.exe')) then
    Result := ExpandConstant('{app}\Horizon.Browser.exe')
  else if FileExists(ExpandConstant('{app}\bin\Release\Horizon.Browser.exe')) then
    Result := ExpandConstant('{app}\bin\Release\Horizon.Browser.exe')
  else
    Result := ExpandConstant('{app}\Horizon.Browser.exe');
end;

