<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <Color x:Key="Color_Accent">#606060</Color> 
    
    <SolidColorBrush x:Key="Brush_Background" Color="#000000" po:Freeze="False"/> 
    <SolidColorBrush x:Key="Brush_DeepBackground" Color="#141414" po:Freeze="False"/> 
    <SolidColorBrush x:Key="Brush_Accent" Color="{StaticResource Color_Accent}" po:Freeze="False"/>
    
    <SolidColorBrush x:Key="Brush_Text" Color="#FFFFFF" po:Freeze="False"/> 
    <SolidColorBrush x:Key="Brush_SoftText" Color="#EAEAEA" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_MutedText" Color="#B0B0B0" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_DisabledText" Color="#777777" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_OnAccent" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_Alert" Color="#FF453A" po:Freeze="False"/> 

    <SolidColorBrush x:Key="Brush_TabStripBg" Color="#111111" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripBgSelected" Color="#1A1A1A" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripBorder" Color="#222222" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripTextInactive" Color="#444444" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripTextHover" Color="#AAAAAA" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_TabChipBg" Color="#222222" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipBorder" Color="#333333" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipHoverBg" Color="#333333" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipSelectedBg" Color="#444444" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipSelectedBorder" Color="#555555" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipText" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipPopupBg" Color="#1A1A1A" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabBar2ChipBg" Color="#1C1E24" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabBar2ChipBorder" Color="#2A2E38" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_ButtonBorder" Color="#333333" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBg" Color="#222222" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBorder" Color="#666666" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_ButtonPressedBg" Color="#111111" po:Freeze="False"/> 

    <SolidColorBrush x:Key="Brush_BannerInfoBg" Color="#1E3A5F" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_BannerInfoBorder" Color="#2E5A8F" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_BannerSuccessBg" Color="#1E3A1E" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_BannerSuccessBorder" Color="#2E6A2E" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_DangerBg" Color="#331111" po:Freeze="False"/> 

    <SolidColorBrush x:Key="Brush_SurfaceCard" Color="#EB121419" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceChrome" Color="#16FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceChromeStroke" Color="#1AFFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceField" Color="#16FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceFieldStroke" Color="#25FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_OmniboxBg" Color="#66141414" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SidebarTile" Color="#161A24" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SidebarTileStroke" Color="#25FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SidebarPanel" Color="#141414" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_HeaderButtonForeground" Color="#FFFFFF" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush.Neon" Color="{StaticResource Color_Accent}" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.NeonDim" Color="#333333" po:Freeze="False"/>

    <Style TargetType="Button" x:Key="Style_StealthButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_HeaderButtonForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
           <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderBrush="{DynamicResource Brush_ButtonBorder}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonHoverBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_ButtonHoverBorder}"/>
                        </Trigger>
                         <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonPressedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_TabStripBgSelected}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#111111"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0,24,0"/>
        <Setter Property="Background" Value="#CC000000"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#141414"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Browser Dark Glass ContextMenu, MenuItem & Separator Styles -->
    <Style x:Key="ModernContextMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="8,5,8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#1FFFFFFF"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernContextMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Padding" Value="11,7,11,7"/>
        <Setter Property="Margin" Value="2,1,2,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumn"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumn"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="IconHost" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <ContentPresenter x:Name="IconPresenter"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <Border x:Name="CheckGlyph"
                                        Width="18" Height="18"
                                        CornerRadius="5"
                                        Background="#26FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <TextBlock Text="&#x2713;"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush_Text}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                            <Border x:Name="GestureBadge"
                                    Grid.Column="2"
                                    CornerRadius="5"
                                    Background="#14FFFFFF"
                                    BorderBrush="#22FFFFFF"
                                    BorderThickness="1"
                                    Padding="6,1.5"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="GestureText"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource Brush_MutedText}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Path x:Name="RightArrow"
                                  Grid.Column="3"
                                  Data="M 0,0 L 4.5,4.5 L 0,9"
                                  Stroke="#AAFFFFFF"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Margin="12,0,2,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>

                            <Popup x:Name="SubMenuPopup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   HorizontalOffset="-4"
                                   VerticalOffset="-6"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush_SurfaceCard}"
                                        BorderBrush="#2EFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="6"
                                        Margin="14"
                                        MinWidth="210">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="22" Direction="270" ShadowDepth="6" Opacity="0.68"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="360">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="GestureBadge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="{x:Null}">
                            <Setter TargetName="GestureBadge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="GestureBadge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2CFFFFFF"/>
                            <Setter TargetName="RightArrow" Property="Stroke" Value="#FFFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2CFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Brush_SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="MinWidth" Value="235"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            Margin="14">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="22" Direction="270" ShadowDepth="6" Opacity="0.68"/>
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="520">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource ModernContextMenuSeparatorStyle}"/>
            <Style TargetType="MenuItem" BasedOn="{StaticResource ModernContextMenuItemStyle}"/>
        </Style.Resources>
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource HeaderContextMenuStyle}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource ModernContextMenuItemStyle}"/>
    <Style TargetType="Separator" BasedOn="{StaticResource ModernContextMenuSeparatorStyle}"/>

</ResourceDictionary>