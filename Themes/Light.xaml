<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <Color x:Key="Color_Accent">#606060</Color>

    <SolidColorBrush x:Key="Brush_Background" Color="#F5F5F5" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_DeepBackground" Color="#F2F2F2" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_Accent" Color="{StaticResource Color_Accent}" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_Text" Color="#1A1A1A" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SoftText" Color="#333333" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_MutedText" Color="#555555" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_DisabledText" Color="#999999" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_OnAccent" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_Alert" Color="#D93025" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_TabStripBg" Color="#F0F0F0" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripBgSelected" Color="#F5F5F5" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripBorder" Color="#DDDDDD" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripTextInactive" Color="#999999" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabStripTextHover" Color="#555555" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_TabChipBg" Color="#E4E4E4" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipBorder" Color="#CFCFCF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipHoverBg" Color="#D6D6D6" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipSelectedBg" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipSelectedBorder" Color="#9A9A9A" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipText" Color="#1A1A1A" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabChipPopupBg" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabBar2ChipBg" Color="#E4E4E4" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_TabBar2ChipBorder" Color="#CFCFCF" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_ButtonBorder" Color="#000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBg" Color="#F2F2F2" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBorder" Color="#000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_ButtonPressedBg" Color="#DCDCDC" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_BannerInfoBg" Color="#D6E9FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_BannerInfoBorder" Color="#8FB8E8" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_BannerSuccessBg" Color="#DDF3DD" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_BannerSuccessBorder" Color="#8FCB8F" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_DangerBg" Color="#FADCDC" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush_SurfaceCard" Color="#F2F4F6F8" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceChrome" Color="#12000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceChromeStroke" Color="#1F000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceField" Color="#0F000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SurfaceFieldStroke" Color="#33000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_OmniboxBg" Color="#B3FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SidebarTile" Color="#E6E9EE" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SidebarTileStroke" Color="#33000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_SidebarPanel" Color="#EEEEEE" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush_HeaderButtonForeground" Color="#1A1A1A" po:Freeze="False"/>

    <SolidColorBrush x:Key="Brush.Neon" Color="{StaticResource Color_Accent}" po:Freeze="False"/>
    <SolidColorBrush x:Key="Brush.NeonDim" Color="#AAAAAA" po:Freeze="False"/>

    <Style TargetType="Button" x:Key="Style_StealthButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush_HeaderButtonForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
           <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderBrush="#767676" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#999999"/>
                        </Trigger>
                         <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_TabStripBgSelected}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0,24,0"/>
        <Setter Property="Background" Value="#F0F0F0"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#E0E0E0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>