<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color_Accent">#606060</Color>

    <SolidColorBrush x:Key="Brush_Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_DeepBackground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Brush_Accent" Color="{StaticResource Color_Accent}"/>

    <SolidColorBrush x:Key="Brush_Text" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Brush_SoftText" Color="#333333"/>
    <SolidColorBrush x:Key="Brush_Alert" Color="#D93025"/>

    <SolidColorBrush x:Key="Brush_TabStripBg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush_TabStripBgSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_TabStripBorder" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="Brush_TabStripTextInactive" Color="#999999"/>
    <SolidColorBrush x:Key="Brush_TabStripTextHover" Color="#555555"/>

    <SolidColorBrush x:Key="Brush_ButtonBorder" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBg" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBorder" Color="#999999"/>
    <SolidColorBrush x:Key="Brush_ButtonPressedBg" Color="#DCDCDC"/>

    <Style TargetType="Button" x:Key="Style_StealthButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
           <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            BorderBrush="#CCCCCC" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#999999"/>
                        </Trigger>
                         <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
               </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>