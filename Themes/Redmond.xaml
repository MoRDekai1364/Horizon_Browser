<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color_Accent">#0078D4</Color>
    <SolidColorBrush x:Key="Brush_Background" Color="White"/>
    <SolidColorBrush x:Key="Brush_DeepBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush_Accent" Color="{StaticResource Color_Accent}"/>
    <SolidColorBrush x:Key="Brush_Text" Color="Black"/>
    <SolidColorBrush x:Key="Brush_MutedText" Color="#555555"/>
    <SolidColorBrush x:Key="Brush_DisabledText" Color="#999999"/>
    <SolidColorBrush x:Key="Brush_OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_SurfaceCard" Color="#EB121419"/>
    <SolidColorBrush x:Key="Brush_SurfaceChrome" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="Brush_SurfaceChromeStroke" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Brush_SurfaceField" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="Brush_SurfaceFieldStroke" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="Brush_OmniboxBg" Color="#66141414"/>
    <SolidColorBrush x:Key="Brush_SidebarTile" Color="#161A24"/>
    <SolidColorBrush x:Key="Brush_SidebarTileStroke" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="Brush_SidebarPanel" Color="#141414"/>
    <SolidColorBrush x:Key="Brush_HeaderButtonForeground" Color="Black"/>

    <SolidColorBrush x:Key="Brush.Neon" Color="{StaticResource Color_Accent}"/>
    <SolidColorBrush x:Key="Brush.NeonDim" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="Brush_Alert" Color="#E81123"/>

    <SolidColorBrush x:Key="Brush_SoftText" Color="#222222"/>

    <SolidColorBrush x:Key="Brush_TabStripBg" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Brush_TabStripBgSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_TabStripBorder" Color="#ADADAD"/>
    <SolidColorBrush x:Key="Brush_TabStripTextInactive" Color="#6D6D6D"/>
    <SolidColorBrush x:Key="Brush_TabStripTextHover" Color="#000000"/>

    <SolidColorBrush x:Key="Brush_ButtonBorder" Color="#ADADAD"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBg" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="Brush_ButtonHoverBorder" Color="#0078D4"/>
    <SolidColorBrush x:Key="Brush_ButtonPressedBg" Color="#CCE4F7"/>

    <SolidColorBrush x:Key="Brush_BannerInfoBg" Color="#D6E9FF"/>
    <SolidColorBrush x:Key="Brush_BannerInfoBorder" Color="#8FB8E8"/>
    <SolidColorBrush x:Key="Brush_BannerSuccessBg" Color="#DDF3DD"/>
    <SolidColorBrush x:Key="Brush_BannerSuccessBorder" Color="#8FCB8F"/>
    <SolidColorBrush x:Key="Brush_DangerBg" Color="#FADCDC"/>

    <SolidColorBrush x:Key="Brush_TabChipBg" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Brush_TabChipBorder" Color="#ADADAD"/>
    <SolidColorBrush x:Key="Brush_TabChipHoverBg" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="Brush_TabChipSelectedBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_TabChipSelectedBorder" Color="#0078D4"/>
    <SolidColorBrush x:Key="Brush_TabChipText" Color="#000000"/>
    <SolidColorBrush x:Key="Brush_TabChipPopupBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush_TabBar2ChipBg" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Brush_TabBar2ChipBorder" Color="#ADADAD"/>

    <Style TargetType="Button" x:Key="Style_StealthButton">
        <Setter Property="Background" Value="#DDDDDD"/>
        <Setter Property="BorderBrush" Value="#AAAAAA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CCE8FF"/>
                            <Setter Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem" x:Key="Style_SidebarItem">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
</ResourceDictionary>