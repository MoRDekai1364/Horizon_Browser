<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CodePage>65001</CodePage>
    <Version>2.8.0</Version>
    <AssemblyVersion>2.8.0.0</AssemblyVersion>
    <FileVersion>2.8.0.0</FileVersion>
    <InformationalVersion>2.8.0</InformationalVersion>
    <Company>Swordmaster_Studios Inc.</Company>
    <Authors>Swordmaster_Studios Inc.</Authors>
    <Product>Horizon Browser</Product>
    <Description>Horizon Browser — High-Performance Privacy &amp; Spatial Web Browser</Description>
    <Copyright>Copyright (C) 2026 Swordmaster_Studios Inc.</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ApplicationIcon)' == '' And Exists('$(MSBuildProjectDirectory)\default_settings.txt')">
    <_AppIconRel>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\default_settings.txt')), '(?sm)\A.*?^@AppIcon=([^\r\n]*).*\z', '$1').Trim())</_AppIconRel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_AppIconRel)' != '' And Exists('$(MSBuildProjectDirectory)\$(_AppIconRel)')">
    <ApplicationIcon>$(MSBuildProjectDirectory)\$(_AppIconRel)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**" />
    <None Remove="Tools\**" />
    <Page Remove="Tools\**" />
    <ApplicationDefinition Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Extensions\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Languages\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Languages\**" />
    <None Include="start_videos\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="test_fixtures\**" CopyToOutputDirectory="PreserveNewest" Condition="'$(IncludeBenchmarkFixtures)' == 'true'" />
    <None Include="default_settings.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('default_settings.txt')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="src\animated_icons\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

    <ItemGroup>
    <None Include="wallpapers\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Native\horizon_core\target\release\horizon_core.dll" Link="horizon_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Native\horizon_core\target\release\horizon_core.dll')" />
    <None Include="version.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('version.txt')" />
    <None Include="update.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('update.txt')" />
  </ItemGroup>

  <Target Name="BuildAndCopyNativeTools" AfterTargets="Build">
    <MSBuild Projects="Tools\Horizon.Updater\Horizon.Updater.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=x64;OutDir=$(TargetDir)Tools\" RemoveProperties="RuntimeIdentifier;SelfContained" Condition="Exists('Tools\Horizon.Updater\Horizon.Updater.csproj')" ContinueOnError="WarnAndContinue" />
    <MSBuild Projects="Tools\Horizon.SessionImporter\Horizon.SessionImporter.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=x64;OutDir=$(TargetDir)Tools\" RemoveProperties="RuntimeIdentifier;SelfContained" Condition="Exists('Tools\Horizon.SessionImporter\Horizon.SessionImporter.csproj')" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <_UpdaterBins Include="$(TargetDir)Tools\Horizon.Updater.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdaterBins)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>