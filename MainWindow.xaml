<Window x:Class="Horizon.Stealth.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:controls="clr-namespace:Horizon.Stealth.Controls"

        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"

        mc:Ignorable="d"

        Title="Horizon Browser" Height="720" Width="1280"

        WindowStyle="None" ResizeMode="CanResizeWithGrip"

        AllowsTransparency="False"

        Background="{StaticResource Brush_Background}">



    <Window.Style>

        <Style TargetType="{x:Type Window}">

            <Setter Property="shell:WindowChrome.WindowChrome">

                <Setter.Value>

                    <shell:WindowChrome CaptionHeight="0"

                                        ResizeBorderThickness="5"

                                        GlassFrameThickness="0"

                                        CornerRadius="8"/>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Style>



    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Themes/Horizon.xaml"/>

            </ResourceDictionary.MergedDictionaries>



            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#222"/>
                <Setter Property="Foreground" Value="#DDD"/>
                <Setter Property="BorderBrush" Value="#444"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Modern Homepage Dark Acrylic Glass Context Menu Style -->
            <Style x:Key="HeaderContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Background" Value="#E612151E"/>
                <Setter Property="BorderBrush" Value="#35FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,6,4,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.6"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Resources>
                    <Style TargetType="Separator">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Height="1" Background="#20FFFFFF" Margin="6,4,6,4"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="#EEEEEE"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                        <Setter Property="Padding" Value="12,7,12,7"/>
                        <Setter Property="Margin" Value="2,1,2,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="IconGroup"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="GestureGroup"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#88FFFFFF" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center"/>
                                            <Path x:Name="RightArrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="#99FFFFFF" StrokeThickness="1.5" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <Popup x:Name="SubMenuPopup" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" Focusable="False" PopupAnimation="Fade">
                                                <Border Background="#E612151E" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="4,6,4,6">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.6"/>
                                                    </Border.Effect>
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Role" Value="SubmenuHeader">
                                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
            </Style>

            <!-- Header Window Caption Buttons: Stretch to upper/right edges, hit-test in chrome, sharp corners -->

            <Style x:Key="Style_HeaderCaptionButton" TargetType="Button">

                <Setter Property="Background" Value="Transparent"/>

                <Setter Property="Foreground" Value="{DynamicResource Brush_HeaderButtonForeground}"/>

                <Setter Property="BorderThickness" Value="0"/>

                <Setter Property="Padding" Value="0"/>

                <Setter Property="Margin" Value="0"/>

                <Setter Property="Width" Value="46"/>

                <Setter Property="VerticalAlignment" Value="Stretch"/>

                <Setter Property="Focusable" Value="False"/>

                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="Bd" Background="{TemplateBinding Background}">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>

                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <Style x:Key="Style_HeaderCloseButton" TargetType="Button">

                <Setter Property="Background" Value="Transparent"/>

                <Setter Property="Foreground" Value="{DynamicResource Brush_HeaderButtonForeground}"/>

                <Setter Property="BorderThickness" Value="0"/>

                <Setter Property="Padding" Value="0"/>

                <Setter Property="Margin" Value="0"/>

                <Setter Property="Width" Value="48"/>

                <Setter Property="VerticalAlignment" Value="Stretch"/>

                <Setter Property="Focusable" Value="False"/>

                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="Bd" Background="{TemplateBinding Background}">

                                <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="#E81123"/>

                                    <Setter Property="Foreground" Value="White"/>

                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="#B80E1B"/>

                                    <Setter Property="Foreground" Value="White"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <!-- Global dark scrollbar thumb (applies to all ScrollViewers in the window) -->

            <Style TargetType="ScrollBar">

                <Setter Property="Width" Value="6"/>

                <Setter Property="Background" Value="Transparent"/>

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="ScrollBar">

                            <Grid Background="Transparent">

                                <Track x:Name="PART_Track" IsDirectionReversed="True">

                                    <Track.DecreaseRepeatButton>

                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>

                                    </Track.DecreaseRepeatButton>

                                    <Track.Thumb>

                                        <Thumb>

                                            <Thumb.Template>

                                                <ControlTemplate TargetType="Thumb">

                                                    <Border Background="#2E2E2E" CornerRadius="3" Margin="1,2"/>

                                                </ControlTemplate>

                                            </Thumb.Template>

                                        </Thumb>

                                    </Track.Thumb>

                                    <Track.IncreaseRepeatButton>

                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>

                                    </Track.IncreaseRepeatButton>

                                </Track>

                            </Grid>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>



            <Storyboard x:Key="Anim_HeaderOpen">

                <DoubleAnimation Storyboard.TargetName="HeaderContainer" Storyboard.TargetProperty="Height"

                                 To="60" Duration="0:0:0.18">

                    <DoubleAnimation.EasingFunction>

                        <QuadraticEase EasingMode="EaseOut"/>

                    </DoubleAnimation.EasingFunction>

                </DoubleAnimation>

            </Storyboard>



            <Storyboard x:Key="Anim_HeaderClose">

                <DoubleAnimation Storyboard.TargetName="HeaderContainer" Storyboard.TargetProperty="Height"

                                 To="0" Duration="0:0:0.2">

                    <DoubleAnimation.EasingFunction>

                        <CubicEase EasingMode="EaseIn"/>

                    </DoubleAnimation.EasingFunction>

                </DoubleAnimation>

            </Storyboard>



            <Storyboard x:Key="Anim_SidebarOpen">

                <DoubleAnimation Storyboard.TargetName="SidebarContainer" Storyboard.TargetProperty="Width"

                                 To="320" Duration="0:0:0.3">

                    <DoubleAnimation.EasingFunction>

                        <CubicEase EasingMode="EaseOut"/>

                    </DoubleAnimation.EasingFunction>

                </DoubleAnimation>

            </Storyboard>



            <Storyboard x:Key="Anim_SidebarClose">

                <DoubleAnimation Storyboard.TargetName="SidebarContainer" Storyboard.TargetProperty="Width"

                                 To="0" Duration="0:0:0.3">

                    <DoubleAnimation.EasingFunction>

                        <CubicEase EasingMode="EaseOut"/>

                    </DoubleAnimation.EasingFunction>

                </DoubleAnimation>

            </Storyboard>

        </ResourceDictionary>

    </Window.Resources>



    <Border BorderBrush="#222" BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition x:Name="RowHeader" Height="Auto"/>

                <RowDefinition x:Name="RowOverflow" Height="Auto"/>

                <RowDefinition x:Name="RowNotify" Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition x:Name="ColSidebar" Width="Auto"/>

            </Grid.ColumnDefinitions>



            <Grid Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="2"

                  Panel.ZIndex="999" IsHitTestVisible="True" Background="{x:Null}">



                <Rectangle x:Name="SensorTop" VerticalAlignment="Top" HorizontalAlignment="Stretch"

                           Height="8" Fill="#01000000" Cursor="Arrow"/>



                <Rectangle x:Name="SensorPillLeft" HorizontalAlignment="Left" VerticalAlignment="Top"

                           Width="100" Height="10" Fill="#01000000" Cursor="Arrow"/>



                <Rectangle x:Name="SensorRight" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                           Width="20" Fill="#01000000" Cursor="Arrow" IsHitTestVisible="False"/>

                <!-- Header Monochrome Proximity Glow Hint (Microsoft Store soft blurry glow style - 30% wider wave arc) -->
                <Path x:Name="HeaderProximityGlow" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Width="1105" Height="38" IsHitTestVisible="False" Opacity="0"
                      Data="M 0,0 C 300,0 420,38 552.5,38 C 685,38 805,0 1105,0 Z">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="HeaderProximityGlowTransform" X="0" Y="0"/>
                    </Path.RenderTransform>
                    <Path.Fill>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.5" RadiusY="1.0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#C0FFFFFF" Offset="0.25"/>
                            <GradientStop Color="#55FFFFFF" Offset="0.65"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <BlurEffect Radius="22"/>
                    </Path.Effect>
                </Path>

                <!-- Sidebar Monochrome Proximity Glow Hints (Microsoft Store soft blurry glow style) -->
                <Border x:Name="SidebarProximityGlowTop" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="5" Height="70" CornerRadius="2.5" Margin="0,4,1,0"
                        Background="#E6FFFFFF" IsHitTestVisible="False" Opacity="0">
                    <Border.Effect>
                        <BlurEffect Radius="14"/>
                    </Border.Effect>
                </Border>

                <Border x:Name="SidebarProximityGlowBottom" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Width="5" Height="70" CornerRadius="2.5" Margin="0,0,1,4"
                        Background="#E6FFFFFF" IsHitTestVisible="False" Opacity="0">
                    <Border.Effect>
                        <BlurEffect Radius="14"/>
                    </Border.Effect>
                </Border>
            </Grid>



            <!-- WebApp mode: thin ghost control bar (min/max/close + drag). Normally Opacity=0, fades in on SensorTop hover -->

            <Grid x:Name="WebAppBar"

                  Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2"

                  Panel.ZIndex="998" VerticalAlignment="Top"

                  Height="32" Opacity="0" IsHitTestVisible="False"

                  Visibility="Collapsed">

                <Grid.Background>

                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                        <GradientStop Color="#CC0b0b0b" Offset="0"/>

                        <GradientStop Color="#000b0b0b" Offset="1"/>

                    </LinearGradientBrush>

                </Grid.Background>

                <Rectangle x:Name="WebAppDragGrip" Fill="#01000000" Cursor="SizeAll"

                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                           Margin="0,0,110,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"

                            VerticalAlignment="Center" Margin="0,0,8,0">

                    <Button x:Name="BtnWebAppMin"   Content="&#x2500;" Width="30" Height="22"

                            Background="Transparent" Foreground="#888" BorderThickness="0"

                            FontSize="11" Cursor="Hand" Click="BtnWebAppMin_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter TargetName="Bd" Property="Background" Value="#333"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <Button x:Name="BtnWebAppMax"   Content="&#x25A1;" Width="30" Height="22"

                            Background="Transparent" Foreground="#888" BorderThickness="0"

                            FontSize="11" Cursor="Hand" Click="BtnWebAppMax_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter TargetName="Bd" Property="Background" Value="#333"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <Button x:Name="BtnWebAppClose" Content="&#x2715;" Width="30" Height="22"

                            Background="Transparent" Foreground="#883333" BorderThickness="0"

                            FontSize="11" Cursor="Hand" Click="BtnWebAppClose_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter TargetName="Bd" Property="Background" Value="#441111"/>

                                        <Setter Property="Foreground" Value="#FF4444"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </StackPanel>

            </Grid>



            



            <Grid x:Name="HeaderContainer" Grid.Row="0" Grid.ColumnSpan="2" Height="60" ClipToBounds="True"
                  AllowDrop="True" DragOver="HeaderContainer_DragOver" Drop="HeaderContainer_Drop">

                <!-- Deep background for standard web page browsing -->

                <Grid x:Name="PnlHeaderBackground" Background="{StaticResource Brush_DeepBackground}"/>



                <!-- Wallpaper glass blur layer (active on homepage) -->

                <Grid x:Name="HeaderWallpaperGlass"

                      IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">

                    <Grid x:Name="HeaderMainCropHost" HorizontalAlignment="Stretch" ClipToBounds="True">

                        <Border x:Name="HeaderWallpaperGlassBlur" Margin="-48"/>

                    </Grid>

                    <Grid x:Name="HeaderSidebarStripHost" HorizontalAlignment="Right" Visibility="Collapsed" ClipToBounds="True" IsHitTestVisible="False">

                        <Border x:Name="HeaderSidebarStripBlur" Margin="-48"/>

                    </Grid>

                    <Rectangle x:Name="HeaderWallpaperBWOverlay" IsHitTestVisible="False" Visibility="Collapsed"/>

                </Grid>



                <!-- Site ambient glow -->

                <Rectangle x:Name="HeaderAmbientGlow"

                           Height="90" VerticalAlignment="Top"

                           IsHitTestVisible="False">

                    <Rectangle.Effect>

                        <BlurEffect Radius="28"/>

                    </Rectangle.Effect>

                </Rectangle>



                <!-- Interactive controls grid (always 100% visible, transparent background) -->

                <Grid Background="Transparent">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*" MinWidth="0"/>

                        <ColumnDefinition Width="2*" MinWidth="0"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>







                    <StackPanel x:Name="PnlHeaderNavButtons" Grid.Column="0" Orientation="Horizontal" Margin="10,0">

                        <Button x:Name="BtnBack" Content="&#x1F814;" Click="BtnBack_Click" MouseRightButtonUp="BtnBack_RightClick"

                                Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="20"

                                ToolTip="Go Back (Alt + Left) · Right-click for history"/>

                        <Button x:Name="BtnForward" Content="&#x1F816;" Click="BtnForward_Click" MouseRightButtonUp="BtnForward_RightClick"

                                Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="20"

                                ToolTip="Go Forward (Alt + Right) · Right-click for history"/>

                        <Button x:Name="BtnReload" Content="&#x21BB;" Click="BtnReload_Click" Style="{StaticResource Style_StealthButton}" Width="42" Height="42" FontSize="20"

                                ToolTip="Reload (F5 / Ctrl + R)"/>

                    </StackPanel>



                    <controls:Omnibox x:Name="OmniboxControl" Grid.Column="1" Margin="5,12" ToolTip="Search or Enter URL"/>



                    <Button x:Name="BtnCompactTabsBadge" Grid.Column="2"

                            HorizontalAlignment="Left" VerticalAlignment="Center"

                            Margin="84,0,0,0"

                            Visibility="Collapsed"

                            Click="BtnCompactTabsBadge_Click"

                            Style="{StaticResource Style_StealthButton}"

                            Height="42" Padding="12,0"

                            FontSize="13"

                            ToolTip="All tabs &#x2014; click to switch (Tab Switcher)"/>



                    <Button x:Name="BtnTabSwitcher" Grid.Column="2"

                            Click="BtnCompactTabsBadge_Click"

                            Style="{StaticResource Style_StealthButton}"

                            Width="36" Height="36"

                            HorizontalAlignment="Left"

                            VerticalAlignment="Center"

                            Margin="4,0,0,0"

                            ToolTip="Tab Switcher (Ctrl + Tab)">

                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    </Button>



                    <Button x:Name="BtnCreateWebApp" Grid.Column="2"

                            Click="BtnInstallWebApp_Click"

                            Style="{StaticResource Style_StealthButton}"

                            Width="36" Height="36"

                            HorizontalAlignment="Left"

                            VerticalAlignment="Center"

                            Margin="44,0,0,0"

                            ToolTip="Install this page as a Web App">

                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    </Button>



                    <ListBox x:Name="ListTabs" Grid.Column="2"

                             Margin="84,0,0,0"

                             ItemsSource="{Binding Tabs}"

                             Background="Transparent" BorderThickness="0"

                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"

                             ScrollViewer.VerticalScrollBarVisibility="Disabled"

                             VerticalAlignment="Center"

                             SelectionChanged="Tabs_SelectionChanged">



                        <ListBox.ItemsPanel>

                            <ItemsPanelTemplate>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>

                            </ItemsPanelTemplate>

                        </ListBox.ItemsPanel>



                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                <EventSetter Event="MouseEnter" Handler="MediaTab_MouseEnter"/>

                                <EventSetter Event="MouseLeave" Handler="MediaTab_MouseLeave"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            

                                            <Grid VerticalAlignment="Center"

                                                  AllowDrop="True"

                                                  PreviewMouseLeftButtonDown="TabHeader_MouseLeftButtonDown"

                                                  PreviewMouseRightButtonDown="TabHeader_PreviewMouseRightButtonDown"

                                                  MouseMove="TabHeader_MouseMove"

                                                  MouseLeftButtonUp="TabHeader_MouseLeftButtonUp"

                                                  DragOver="TabHeader_DragOver"

                                                  Drop="TabHeader_Drop">



                                                <Grid.ContextMenu>

                                                    <ContextMenu Opened="TabContextMenu_Opened">

                                                        <MenuItem Header="Duplicate Tab"       Tag="dup"  Click="TabMenu_Duplicate"/>

                                                        <MenuItem Header="Rename Tab"          Tag="ren"  Click="TabMenu_Rename"/>

                                                        <MenuItem Header="Change Tab Position" Tag="pos"  Click="TabMenu_ChangePosition"/>

                                                        <MenuItem Header="Bring Tab to Top"    Tag="top"  Click="TabMenu_BringToTop"/>

                                                        <Separator/>

                                                        <MenuItem Header="Tab Language" Tag="__lang_parent__"/>
                                                        <MenuItem Header="Account Container" Tag="__account_container_parent__"/>

                                                        <Separator/>

                                                        <MenuItem x:Name="MnuMultiTabActions2" Header="&#x26A1; Multi-Tab Actions&#x2026;" Tag="multi" Click="TabMenu_OpenMultiContext" FontWeight="SemiBold" Visibility="Collapsed"/>

                                                    </ContextMenu>

                                                </Grid.ContextMenu>



                                                <Border x:Name="BaseBorder"

                                                        Background="#222" CornerRadius="8"

                                                        Margin="1.9,0" Width="{Binding TabWidth}" MinHeight="47" MaxHeight="47"

                                                        BorderBrush="#333" BorderThickness="1"

                                                        VerticalAlignment="Center"/>



                                                <Border x:Name="TabBorder"

                                                        Background="{Binding AnimatedBrush}"

                                                        CornerRadius="8" Margin="1.9,0" Width="{Binding TabWidth}" MinHeight="47" MaxHeight="47"

                                                        BorderBrush="#00000000" BorderThickness="1"

                                                        VerticalAlignment="Center">



                                                    <Grid ClipToBounds="True">

                                                        

                                                        <Border CornerRadius="8" ClipToBounds="True">

                                                            <Rectangle Fill="{Binding SingleColorBrush}" Opacity="{Binding LoadingOpacity}" RenderTransformOrigin="0,0.5">

                                                                <Rectangle.RenderTransform>

                                                                    <ScaleTransform ScaleX="{Binding LoadingProgress}" ScaleY="1"/>

                                                                </Rectangle.RenderTransform>

                                                            </Rectangle>

                                                        </Border>



                                                        <StackPanel x:Name="NormalTitlePanel"

                                                                    Orientation="Horizontal"

                                                                    HorizontalAlignment="Left"

                                                                    VerticalAlignment="Center"

                                                                    Margin="8,0,22,0">

                                                            <StackPanel.Style>

                                                                <Style TargetType="StackPanel">

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding IsActiveDownload}" Value="True">

                                                                            <Setter Property="Visibility" Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding HasEverDownloaded}" Value="True">

                                                                            <Setter Property="Visibility" Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding HasEverPlayedAudio}" Value="True">

                                                                            <Setter Property="Visibility" Value="Collapsed"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>

                                                                </Style>

                                                            </StackPanel.Style>

                                                            <Ellipse x:Name="AudioDot"

                                                                     Width="5" Height="5" Fill="White"

                                                                     Margin="0,0,5,0"

                                                                     Visibility="Collapsed"

                                                                     VerticalAlignment="Center"

                                                                     Opacity="0.85"/>

                                                            <!-- Sleeping indicator -->

                                                            <TextBlock Text="&#x1F4A4;" FontSize="9"

                                                                       Margin="0,0,4,0" VerticalAlignment="Center">

                                                                <TextBlock.Style>

                                                                    <Style TargetType="TextBlock">

                                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                                        <Style.Triggers>

                                                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">

