                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>

                        </LinearGradientBrush>

                    </Border.OpacityMask>

                    <Border x:Name="HeaderHomeBlurBleedBlur" Margin="-24"/>

                </Border>

