                                                                ContextMenu="{x:Null}">

                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>

                                                        </Button>

                                                        <Button Content="&#x23ED;" Click="BtnMediaForward_Click"

                                                                PreviewMouseRightButtonDown="BtnMediaForward_RightClick"

                                                                Width="26" Height="22" FontSize="12"

                                                                Background="Transparent" Foreground="#DDD"

                                                                BorderThickness="0" Cursor="Hand"

                                                                ContextMenu="{x:Null}"

                                                                ToolTip="&#x23ED; Left-click: +10s  |  Right-click: Next Track">

                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>

                                                        </Button>

                                                        <Button x:Name="OverflowBtnMute" Content="&#x1F50A;" Click="BtnMediaMute_Click"

                                                                Width="26" Height="22" FontSize="12"

                                                                Background="Transparent" Foreground="#DDD"

                                                                BorderThickness="0" Cursor="Hand"

                                                                ContextMenu="{x:Null}">

                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>

                                                        </Button>

                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,2">

                                                        <TextBlock Text="&#x1F509;" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>

                                                        <Slider Minimum="0" Maximum="100" Value="100"

                                                                Width="110" VerticalAlignment="Center"

                                                                ValueChanged="SliderVolume_ValueChanged"/>

                                                        <TextBlock Text="&#x1F50A;" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                                    </StackPanel>

                                                </StackPanel>

                                            </Border>

                                        </Popup>

                                    </Grid>



                                    <ControlTemplate.Triggers>

                                        <!-- Fade-in when tab first appears in overflow bar -->

                                        <EventTrigger RoutedEvent="Loaded">

                                            <BeginStoryboard>

                                                <Storyboard>

                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"

                                                        From="0" To="1" Duration="0:0:0.28">

                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                                    </DoubleAnimation>

                                                </Storyboard>

                                            </BeginStoryboard>

                                        </EventTrigger>

                                        <!-- Hover: fade in white glow overlay -->

                                        <EventTrigger RoutedEvent="MouseEnter">

                                            <BeginStoryboard>

                                                <Storyboard>

                                                    <DoubleAnimation Storyboard.TargetName="HoverHighlight"

                                                        Storyboard.TargetProperty="Opacity"

                                                        To="1" Duration="0:0:0.15">

                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                                    </DoubleAnimation>

                                                </Storyboard>

                                            </BeginStoryboard>

                                        </EventTrigger>

                                        <EventTrigger RoutedEvent="MouseLeave">

                                            <BeginStoryboard>

                                                <Storyboard>

                                                    <DoubleAnimation Storyboard.TargetName="HoverHighlight"

                                                        Storyboard.TargetProperty="Opacity"

                                                        To="0" Duration="0:0:0.2"/>

                                                </Storyboard>

                                            </BeginStoryboard>

                                        </EventTrigger>

                                        <!-- Selected: blue bottom accent border + animated blue overlay -->

                                        <Trigger Property="IsSelected" Value="True">

                                            <Trigger.EnterActions>

                                                <BeginStoryboard>

                                                    <Storyboard>

                                                        <DoubleAnimation Storyboard.TargetName="SelectHighlight"

                                                            Storyboard.TargetProperty="Opacity"

                                                            To="1" Duration="0:0:0.2">

                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                                        </DoubleAnimation>

                                                    </Storyboard>

                                                </BeginStoryboard>

                                            </Trigger.EnterActions>

                                            <Trigger.ExitActions>

                                                <BeginStoryboard>

                                                    <Storyboard>

                                                        <DoubleAnimation Storyboard.TargetName="SelectHighlight"

                                                            Storyboard.TargetProperty="Opacity"

                                                            To="0" Duration="0:0:0.18"/>

                                                    </Storyboard>

                                                </BeginStoryboard>

                                            </Trigger.ExitActions>

                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4A8FD4"/>

                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,3"/>

                                        </Trigger>

                                        <!-- Multi-select highlight (Ctrl/Shift-click) -->

                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">

                                            <Setter TargetName="TabBorder" Property="Background" Value="#1A3A5C"/>

                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2E6AA0"/>

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">

                                            <Setter TargetName="OverflowAudioDot" Property="Visibility" Value="Visible"/>

                                            <Setter TargetName="OverflowAudioDot" Property="Fill" Value="#00FF00"/>

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsMediaPaused}" Value="True">

                                            <Setter TargetName="OverflowAudioDot" Property="Visibility" Value="Visible"/>

                                            <Setter TargetName="OverflowAudioDot" Property="Fill" Value="#888888"/>

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="False">

                                            <Setter TargetName="OverflowBtnPlayPause" Property="Content" Value="&#x25B6;"/>

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">

                                            <Setter TargetName="OverflowBtnMute" Property="Content" Value="&#x1F507;"/>

                                        </DataTrigger>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                                <Condition Binding="{Binding HasEverPlayedAudio}" Value="True"/>

                                            </MultiDataTrigger.Conditions>

                                            <Setter TargetName="OverflowMediaPopup" Property="IsOpen" Value="True"/>

                                        </MultiDataTrigger>

                                        <!-- Domain hover: mirrors primary tab bar behaviour for non-media/download tabs -->

                                                        <MultiDataTrigger>

                                                            <MultiDataTrigger.Conditions>

                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                                                <Condition Binding="{Binding HasEverPlayedAudio}" Value="False"/>

                                                                <Condition Binding="{Binding IsActiveDownload}" Value="False"/>

                                                            </MultiDataTrigger.Conditions>

                                            <MultiDataTrigger.EnterActions>

                                                <BeginStoryboard>

                                                    <Storyboard>

                                                        <DoubleAnimation Storyboard.TargetName="OverflowDomainHover"

                                                            Storyboard.TargetProperty="Opacity"

                                                            To="1" Duration="0:0:0.25">

                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                                        </DoubleAnimation>

                                                        <DoubleAnimation Storyboard.TargetName="OverflowTitleText"

                                                            Storyboard.TargetProperty="Opacity"

                                                            To="0" Duration="0:0:0.2"/>

                                                    </Storyboard>

                                                </BeginStoryboard>

                                            </MultiDataTrigger.EnterActions>

                                            <MultiDataTrigger.ExitActions>

                                                <BeginStoryboard>

                                                    <Storyboard>

                                                        <DoubleAnimation Storyboard.TargetName="OverflowDomainHover"

                                                            Storyboard.TargetProperty="Opacity"

                                                            To="0" Duration="0:0:0.3"/>

                                                        <DoubleAnimation Storyboard.TargetName="OverflowTitleText"

                                                            Storyboard.TargetProperty="Opacity"

                                                            To="1" Duration="0:0:0.3">

                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>

                                                        </DoubleAnimation>

                                                    </Storyboard>

                                                </BeginStoryboard>

                                            </MultiDataTrigger.ExitActions>

                                        </MultiDataTrigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </ListBox.ItemContainerStyle>

            </ListBox>
            </Grid>



            <!-- Expand / collapse all overflow rows -->

            <Button x:Name="BtnExpandOverflow"

                    Grid.Row="1" Grid.ColumnSpan="2"

                    Width="20" Height="50"

                    Margin="0,0,0,0"

                    HorizontalAlignment="Left" VerticalAlignment="Top"

                    Content="&#x25BC;" FontSize="10"

                    Background="#1A1A1A" Foreground="#888"

                    BorderBrush="#333" BorderThickness="1,1,0,0"

                    Cursor="Hand" Panel.ZIndex="2"

                    Visibility="Collapsed"

                    Click="BtnExpandOverflow_Click"

                    MouseRightButtonUp="BtnExpandOverflow_RightClick"

                    ToolTip="Show / collapse all overflow tabs">

                <Button.Resources>

                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>

                </Button.Resources>

            </Button>



            <!-- Margin="0,0,1,0": keeps the HWND 1 px shy of the right edge so

                 SensorRight (HorizontalAlignment=Right in the ZIndex=999 overlay)

                 is never fully covered by the WebView2 HWND &#x2014; fixes auto-hide sidebar. -->

            <Grid x:Name="ViewContainer" Grid.Row="3" Grid.Column="0" Margin="0"/>



            <Grid x:Name="SidebarContainer" Grid.Row="3" Grid.Column="1" Panel.ZIndex="50" Width="0" Margin="-1,0,0,0" ClipToBounds="True">
                <Grid x:Name="SidebarSlideHost" ClipToBounds="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SidebarSlideTransform" X="0" Y="0"/>
                    </Grid.RenderTransform>




                <!--

                    Homepage exception, same idea as the header: while the

                    homepage's wallpaper is on screen, the sidebar shows a

                    heavily blurred, distorted slice of that wallpaper instead

                    of its normal flat background, with a solid B/W center fill

                    (matching the homepage search bar) faded in from top/bottom.

                    Wired in code-behind via InitSidebarWallpaperGlass. This

                    layer (and the center fill after it) sit BEHIND RightSidebar

                    on purpose &#x2014; RightSidebar's own background is transparent

                    except for a thin b/w strip at the far right, so the glass

                    shows through it instead of being hidden under it.

                -->

                <Grid x:Name="SidebarWallpaperGlass" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">

                    <Border x:Name="SidebarWallpaperGlassBlur" Margin="-48"/>
                    <Border x:Name="SidebarOverlayTint" Background="#B812151E" BorderBrush="#26FFFFFF" BorderThickness="1,0,0,0" Visibility="Collapsed"/>

                </Grid>



                <!--

                    Off-homepage counterpart to SidebarWallpaperGlass above: when

                    there's no wallpaper to sample (a normal webpage), the sidebar

                    instead shows a soft blurred blend between a neutral B/W tone

                    and the current site's accent color &#x2014; the same two colors

                    UpdateHeaderAmbientGlow already derives for the header glow.

                    Wired in code-behind via InitSidebarAmbientGlow /

                    UpdateHeaderAmbientGlow. Visibility is toggled opposite

                    SidebarWallpaperGlass in InitSidebarWallpaperGlass.

                -->

                <Grid x:Name="SidebarSiteGlow" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">

                    <Rectangle x:Name="SidebarSiteGlowFill" Margin="-60">

                        <Rectangle.Effect>

                            <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance"/>

                        </Rectangle.Effect>

                    </Rectangle>

                </Grid>



                <controls:FluxSidebar x:Name="RightSidebar"/>





            
                </Grid>
            </Grid>



            <!-- Notification row: lives in Row 2 (pure WPF layout, above WebView2 HWND) -->

            <!-- This avoids the WPF/Win32 airspace problem where HWND always renders on top -->

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Brush_DeepBackground}">



                <!-- Session Restore Banner -->

                <Border x:Name="RestoreBanner"

                        Visibility="Collapsed"

                        Background="{DynamicResource Brush_BannerInfoBg}" BorderBrush="{DynamicResource Brush_BannerInfoBorder}" BorderThickness="0,0,0,1"

                        Padding="14,8">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#x1F5C3; Restore previous session?" Foreground="{DynamicResource Brush_Text}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <Button Content="RESTORE" Click="BtnRestoreSession_Click"

                                Background="{StaticResource Brush_Accent}" Foreground="Black" FontWeight="Bold"

                                Padding="10,4" BorderThickness="0" Cursor="Hand">

                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>

                        </Button>

                        <Button Content="&#x2715;" Click="BtnDismissRestore_Click"

                                Background="Transparent" Foreground="#888" BorderThickness="0"

                                Margin="10,0,0,0" FontSize="14" Cursor="Hand"/>

                    </StackPanel>

                </Border>



                <!-- Image Detected Banner -->

                <Border x:Name="OverlaySingleImage"

                        Visibility="Collapsed"

                        Background="{DynamicResource Brush_BannerSuccessBg}" BorderBrush="{DynamicResource Brush_BannerSuccessBorder}" BorderThickness="0,0,0,1"

                        Padding="14,8">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#x1F5BC; Image detected &#x2014; open as standalone" Foreground="{DynamicResource Brush_Text}" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>

                        <Button Content="DOWNLOAD" Click="BtnDownloadImage_Click"

                                Background="{StaticResource Brush_Accent}" Foreground="Black" FontWeight="Bold"

                                Padding="10,4" BorderThickness="0" Cursor="Hand">

                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>

                        </Button>

                        <Button Content="&#x2715;" Click="BtnDismissImageOverlay_Click"

                                Background="Transparent" Foreground="#888" BorderThickness="0"

                                Margin="10,0,0,0" FontSize="14" Cursor="Hand"/>

                    </StackPanel>

                </Border>



            </StackPanel>



            <!-- &#x2500;&#x2500; Widget Context Popup &#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500; -->

            <Popup x:Name="WidgetContextPopup" StaysOpen="False" AllowsTransparency="True" Placement="MousePoint">

                <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="10">

                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.6"/></Border.Effect>

                    <StackPanel MinWidth="210">

                        <TextBlock Text="WIDGET ORDER" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>

                        <TextBlock Text="&#x2261; drag to reorder  ·  &#x25B2;&#x25BC; buttons below" Foreground="#444" FontSize="9" Margin="0,0,0,8"/>

                        <ListBox x:Name="LstWidgetOrder"

                                 Background="Transparent" BorderThickness="0"

                                 AllowDrop="True"

                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                                 PreviewMouseLeftButtonDown="WidgetList_PreviewMouseLeftButtonDown"

                                 PreviewMouseMove="WidgetList_PreviewMouseMove"

                                 Drop="WidgetList_Drop"

                                 MouseRightButtonUp="LstWidgetOrder_RightClick">

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">

                                    <Setter Property="Background" Value="Transparent"/>

                                    <Setter Property="Padding" Value="0"/>

                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsSelected" Value="True">

                                            <Setter Property="Background" Value="#2d2d2d"/>

                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="Background" Value="#252525"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </ListBox.ItemContainerStyle>

                        </ListBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">

                            <Button x:Name="BtnWidgetMoveUp"   Content="&#x25B2;" Click="BtnWidgetMoveUp_Click"

                                    Width="28" Height="22" Margin="0,0,4,0"

                                    Background="#252525" Foreground="#aaa" BorderBrush="#444" BorderThickness="1"

                                    ToolTip="Move selected widget up in cycle order"/>

                            <Button x:Name="BtnWidgetMoveDown" Content="&#x25BC;" Click="BtnWidgetMoveDown_Click"

                                    Width="28" Height="22"

                                    Background="#252525" Foreground="#aaa" BorderBrush="#444" BorderThickness="1"

                                    ToolTip="Move selected widget down in cycle order"/>

                        </StackPanel>

                        <!-- Weather city &#x2014; shown only when Weather is checked -->

                        <Grid x:Name="PnlWeatherCity" Visibility="Collapsed" Margin="0,6,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="City: " Foreground="#888" VerticalAlignment="Center" Margin="0,0,4,0"/>

                            <TextBox x:Name="TxtWeatherCity" Grid.Column="1"

                                     Background="#141414" Foreground="#ccc" BorderBrush="#444" BorderThickness="1"

                                     Padding="4,2" FontSize="12" KeyDown="TxtWeatherCity_KeyDown"

                                     LostFocus="TxtWeatherCity_LostFocus"

                                     ToolTip="Press Enter or click away to apply"/>

                        </Grid>

                        <Separator Background="#333" Margin="0,10"/>

                        <CheckBox x:Name="ChkWidgetDisableCycle"

                                  Content="&#x1F6AB;  Never auto-cycle"

                                  Click="WidgetModeCheck_Click"

                                  Foreground="#aaa" Margin="0,4,0,6"

                                  ToolTip="Disable automatic cycling; only scroll changes modes"/>

                        <StackPanel x:Name="PnlWidgetCycle">

                        <TextBlock Text="CYCLE EVERY  (0 = Off)" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="38"/>

                            </Grid.ColumnDefinitions>

                            <Slider x:Name="SliderWidgetCycle" Minimum="0" Maximum="60" SmallChange="1" LargeChange="5"

                                    VerticalAlignment="Center" ValueChanged="SliderWidgetCycle_Changed"/>

                            <TextBlock x:Name="TxtWidgetCycleSecs" Grid.Column="1" Text="7s"

                                       Foreground="#aaa" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>

                        </Grid>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Popup>



            <!-- &#x2500;&#x2500; Tab Multi-select Context Popup &#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500; -->

            <Popup x:Name="MultiTabContextPopup" StaysOpen="False" AllowsTransparency="True" Placement="MousePoint">

                <Border Background="#1e1e1e" BorderBrush="#2E6AA0" BorderThickness="1" CornerRadius="6" Padding="4">

                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.6"/></Border.Effect>

                    <StackPanel MinWidth="230">

                        <TextBlock x:Name="TxtMultiTabHeader" Text="2 TABS SELECTED"

                                   Foreground="#2E6AA0" FontSize="10" FontWeight="Bold" Margin="8,6,8,6"/>

                        <Separator Background="#2a2a2a" Margin="4,0"/>

                        <Button Content="&#x1F4CB;  Duplicate All"        Click="MultiTab_Duplicate"       Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>

                        <Button Content="&#x1F3F7;  Rename All&#x2026;"          Click="MultiTab_Rename"          Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>

                        <Separator Background="#2a2a2a" Margin="4,2"/>

                        <Button Content="&#x2B06;  Bring All to Top"     Click="MultiTab_BringToTop"      Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>

                        <Button Content="&#x2B07;  Send All to End"      Click="MultiTab_SendToEnd"       Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ddd"/>

                        <Button Content="&#x1F4E6;  Group Selected Tabs"  Click="MultiTab_Group"           Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#aaeebb"/>

                        <Separator Background="#2a2a2a" Margin="4,2"/>

                        <Button Content="&#x2715;  Close All Selected"   Click="MultiTab_CloseAll"        Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#ee8888"/>

                        <Separator Background="#2a2a2a" Margin="4,2"/>

                        <Button Content="&#x1F4A4;  Sleep All Selected"  Click="MultiTab_SleepAll"        Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#aaaaff"/>

                        <Button Content="&#x2600;  Wake All Selected"   Click="MultiTab_WakeAll"         Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#aaffaa"/>

                        <Separator Background="#2a2a2a" Margin="4,2"/>

                        <Button Content="&#x2716;  Cancel"               Click="MultiTab_Cancel"          Style="{StaticResource Style_StealthButton}" HorizontalContentAlignment="Left" Padding="10,7" FontSize="12" Foreground="#888888"/>

                    </StackPanel>

                </Border>

            </Popup>



            <!-- &#x2500;&#x2500; Music / Video Widget Popup &#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500; -->

            <Popup x:Name="MusicWidgetPopup" StaysOpen="False" AllowsTransparency="True"

                   Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderWidgetBorder}">

                <Border Background="#1e1e1e" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="12,10">

                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.7"/></Border.Effect>

                    <StackPanel MinWidth="240">

                        <TextBlock x:Name="MusicPopupTitleTxt" Text="Nothing playing"

                                   Foreground="#eee" FontSize="12" FontWeight="SemiBold"

                                   TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,0,0,2"/>

                        <TextBlock x:Name="MusicPopupTabTxt" Text=""

                                   Foreground="#888" FontSize="10" Margin="0,0,0,2"/>

                        <TextBlock x:Name="MusicPopupStatusTxt" Text=""

                                   Foreground="#aaa" FontSize="10" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">

                            <Button Content="&#x23EE;" Click="MusicPopupBack_Click" ContextMenu="{x:Null}"

                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"

                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"

                                    Cursor="Hand" Margin="2,0" ToolTip="Back 10s">

                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>

                            </Button>

                            <Button x:Name="MusicPopupPlayBtn" Content="&#x23F8;" Click="MusicPopupPlay_Click" ContextMenu="{x:Null}"

                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"

                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"

                                    Cursor="Hand" Margin="2,0">

                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>

                            </Button>

                            <Button Content="&#x23ED;" Click="MusicPopupForward_Click" ContextMenu="{x:Null}"

                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"

                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"

                                    Cursor="Hand" Margin="2,0" ToolTip="Forward 10s">

                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>

                            </Button>

                            <Button x:Name="MusicPopupMuteBtn" Content="&#x1F50A;" Click="MusicPopupMute_Click" ContextMenu="{x:Null}"

                                    Width="34" Height="28" FontSize="14" Background="#2a2a2a"

                                    Foreground="#ddd" BorderThickness="1" BorderBrush="#444"

                                    Cursor="Hand" Margin="2,0">

                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>

                            </Button>

                        </StackPanel>

                        <Button Content="Go to tab &#x2192;" Click="MusicPopupGoToTab_Click"

                                HorizontalContentAlignment="Center" Height="26"

                                Background="#252525" Foreground="#aaa"

                                BorderThickness="1" BorderBrush="#333" Cursor="Hand" FontSize="11">

                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>

                        </Button>

                    </StackPanel>

                </Border>

            </Popup>



            <!-- &#x2500;&#x2500; Weather Detail Popup &#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500; -->

            <Popup x:Name="WeatherDetailPopup" StaysOpen="False" AllowsTransparency="True"

                   Placement="Bottom" PlacementTarget="{Binding ElementName=HeaderWidgetBorder}">

                <Border Background="#1e1e1e" BorderBrush="#2a5a8a" BorderThickness="1" CornerRadius="8" Padding="14,12">

                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.7"/></Border.Effect>

                    <StackPanel MinWidth="200">

                        <TextBlock Text="WEATHER" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                        <TextBlock x:Name="WeatherDetailTxt"

                                   Text="Loading&#x2026;" Foreground="#ddd" FontSize="12"

                                   FontFamily="Consolas" TextWrapping="Wrap" MaxWidth="300" LineHeight="18"/>

                    </StackPanel>

                </Border>

            </Popup>



        
                <!-- ── Dynamic Island / Live Capsule Header Pill (iOS & OxygenOS Style) ──────── -->
        <Popup x:Name="DynamicIslandPopup"
               AllowsTransparency="True"
               StaysOpen="True"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=MainGrid}"
               IsOpen="False"
               Width="660" Height="160">
            <Grid x:Name="DynamicIslandHost" Width="660" Height="160" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent">
                <!-- Audio Visualizer Outer Glow Aura (Soft breathing neon border around the pill edges) -->
                <Border x:Name="DynamicIslandAudioGlow"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        Width="{Binding ActualWidth, ElementName=DynamicIslandPill}"
                        Height="{Binding ActualHeight, ElementName=DynamicIslandPill}"
                        CornerRadius="{Binding CornerRadius, ElementName=DynamicIslandPill}"
                        BorderThickness="1.5"
                        IsHitTestVisible="False"
                        Opacity="0.0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00E5FF" Offset="0.0"/>
                            <GradientStop Color="#A855F7" Offset="0.5"/>
                            <GradientStop Color="#00E5FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect x:Name="AudioGlowShadow" BlurRadius="22" ShadowDepth="0" Color="#00E5FF" Opacity="0.85"/>
                    </Border.Effect>
                </Border>

                <!-- Dynamic Island Pill Body -->
                <Border x:Name="DynamicIslandPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        Width="120" Height="28"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True"
                        MouseEnter="DynamicIsland_MouseEnter"
                        MouseLeave="DynamicIsland_MouseLeave"
                        PreviewMouseLeftButtonDown="DynamicIsland_MouseLeftButtonDown"
                        PreviewMouseMove="DynamicIsland_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="DynamicIsland_PreviewMouseLeftButtonUp"
                        Cursor="Arrow">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#70FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#28FFFFFF" Offset="0.4"/>
                            <GradientStop Color="#10FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C8121620" Offset="0.0"/>
                            <GradientStop Color="#D80F1219" Offset="0.5"/>
                            <GradientStop Color="#E50B0D12" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="DynamicIslandScale" ScaleX="1.0" ScaleY="1.0" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform x:Name="DynamicIslandTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect x:Name="DynamicIslandShadow" BlurRadius="26" ShadowDepth="3" Opacity="0.60" Color="#000000"/>
                    </Border.Effect>
                    <Grid x:Name="DynamicIslandContentHost">
                        <!-- Specular top glare line -->
                        <Rectangle Height="1" VerticalAlignment="Top" Margin="14,0,14,0" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#55FFFFFF" Offset="0.25"/>
                                    <GradientStop Color="#75FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#55FFFFFF" Offset="0.75"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- ════════════════ Compact Resting Capsule (Image 3) ════════════════ -->
                        <Grid x:Name="DynamicIslandCompact" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0" Cursor="Hand" MouseLeftButtonUp="DynamicIslandCompact_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Left: Music / Favicon icon -->
                            <TextBlock x:Name="TxtCompactLeftIcon" Grid.Column="0" Text="&#x266B;" FontSize="11" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Middle: Three dots / indicator -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse Width="3" Height="3" Fill="#60FFFFFF" Margin="1.5,0"/>
                                <Ellipse Width="3" Height="3" Fill="#90FFFFFF" Margin="1.5,0"/>
                                <Ellipse Width="3" Height="3" Fill="#60FFFFFF" Margin="1.5,0"/>
                            </StackPanel>
                            <!-- Right: Timer / Clock icon -->
                            <TextBlock x:Name="TxtCompactRightIcon" Grid.Column="2" Text="&#x23F1;" FontSize="11" Foreground="#FFD54F" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ════════════════ Expanded Executive Deck (Images 0-2) ════════════════ -->
                        <Grid x:Name="DynamicIslandExpanded" Width="556" Height="76" Margin="12,3" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Mode Pills + Header Reveal Button -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mode Chips Stack -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="ChipAmbient" CornerRadius="11" Background="#2800E5FF" BorderBrush="#8000E5FF" BorderThickness="1" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandChip_Click" Tag="Ambient">
                                        <TextBlock Text="+ Ambient" FontSize="9.5" FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipTimer" CornerRadius="11" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandChip_Click" Tag="Timer">
                                        <TextBlock Text="&#x23F1; Timer" FontSize="9.5" FontWeight="SemiBold" Foreground="#8E9297" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipMedia" CornerRadius="11" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandChip_Click" Tag="Media">
                                        <TextBlock Text="&#x266B; Media" FontSize="9.5" FontWeight="SemiBold" Foreground="#8E9297" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipNotes" CornerRadius="11" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandChip_Click" Tag="Notes">
                                        <TextBlock Text="&#x1F4DD; Notes" FontSize="9.5" FontWeight="SemiBold" Foreground="#8E9297" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipDownload" CornerRadius="11" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandChip_Click" Tag="Download">
                                        <TextBlock Text="&#x2193; Down" FontSize="9.5" FontWeight="SemiBold" Foreground="#8E9297" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Right Controls: Mute + Header Reveal + Collapse -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="BtnIslandMute" Width="22" Height="22" CornerRadius="11" Background="#15FFFFFF" Cursor="Hand" Margin="0,0,5,0" MouseLeftButtonUp="BtnIslandMute_Click" ToolTip="Mute / Unmute" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtIslandMute" Text="&#x1F50A;" FontSize="9.5" Foreground="#CCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BtnIslandRevealHeaderFull" Height="22" CornerRadius="11" Background="#22FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="8,0" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonUp="BtnIslandRevealHeader_Click" ToolTip="Reveal Header">
                                        <TextBlock Text="&#x25BC; Header" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFF" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BtnIslandCollapse" Width="20" Height="22" CornerRadius="11" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BtnIslandCollapse_Click" ToolTip="Collapse">
                                        <TextBlock Text="&#x25B2;" FontSize="8" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Bottom Decks (Height ~44px) -->
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <!-- Deck 1: Ambient Deck (Image 0 &amp; 2 layout!) -->
                                <Grid x:Name="IslandDeckAmbient" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Favicon + Title + Domain (Clicking reveals full header) -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="PnlIslandTabInfo_Click" ToolTip="Click to reveal header">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Favicon container -->
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="IslandTabFaviconImage" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock x:Name="IslandTabFaviconFallback" Text="&#x1F310;" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <!-- Title and Domain -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="IslandAmbientTabTitle" Text="Horizon Web Engine" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="IslandAmbientTabDomain" Text="Aegis High-Efficiency Tab Governor Active" Foreground="#9AA0A6" FontSize="10.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Center Divider -->
                                    <Rectangle Grid.Column="1" Width="1" Height="26" Fill="#20FFFFFF" Margin="12,0" VerticalAlignment="Center"/>

                                    <!-- Right: Active Status Badges (Timer &amp; Notes with glowing indicator dots) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Timer Badge -->
                                        <Border x:Name="BtnIslandBadgeTimer" Height="26" CornerRadius="13" Background="#252DD4BF" BorderBrush="#502DD4BF" BorderThickness="1" Padding="9,0" Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonUp="BtnIslandOpenTimerWindow_Click" ToolTip="Timer / Stopwatch">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#x23F1;" FontSize="10.5" Foreground="#2DD4BF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtIslandBadgeTimer" Text="Timer" FontSize="10.5" FontWeight="SemiBold" Foreground="#2DD4BF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Cyan glowing indicator dot -->
                                                <Ellipse Width="5" Height="5" Fill="#2DD4BF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Notes Badge -->
                                        <Border x:Name="BtnIslandBadgeNotes" Height="26" CornerRadius="13" Background="#28F59E0B" BorderBrush="#50F59E0B" BorderThickness="1" Padding="9,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandOpenNotesWindow_Click" ToolTip="Quick Notes">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#x1F4DD;" FontSize="10.5" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtIslandBadgeNotes" Text="Notes" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Amber glowing indicator dot -->
                                                <Ellipse Width="5" Height="5" Fill="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Deck 2: Timer Deck -->
                                <Grid x:Name="IslandDeckTimer" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IslandExpTimerDigits" Grid.Column="0" Text="00:00" FontFamily="Consolas" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="IslandExpTimerStatus" Text="Ready" Foreground="#8E9297" FontSize="9.5"/>
                                        <ProgressBar x:Name="IslandExpTimerProgress" Height="3" Maximum="100" Value="100" Foreground="#00E5FF" Background="#20FFFFFF" BorderThickness="0" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="BtnIslandExpTimerToggle" Height="24" CornerRadius="12" Background="#3000E5FF" BorderBrush="#8000E5FF" BorderThickness="1" Padding="9,0" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonUp="BtnIslandTimerToggle_Click">
                                            <TextBlock x:Name="TxtIslandExpTimerToggle" Text="&#x25B6; Start" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Height="24" Width="24" CornerRadius="12" Background="#1FFFFFFF" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonUp="BtnIslandTimerReset_Click" ToolTip="Reset">
                                            <TextBlock Text="&#x21BA;" FontSize="10.5" Foreground="#DDD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Height="24" Width="24" CornerRadius="12" Background="#1FFFFFFF" Cursor="Hand" MouseLeftButtonUp="BtnIslandOpenTimerWindow_Click" ToolTip="Open Full Timer Window">
                                            <TextBlock Text="&#x26F6;" FontSize="10.5" Foreground="#DDD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Deck 3: Media Deck -->
                                <Grid x:Name="IslandDeckMedia" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#222530" BorderBrush="#30FFFFFF" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <StackPanel x:Name="IslandWaveform" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Rectangle x:Name="WaveBar1" Width="2.5" Height="8" Fill="#00E5FF" RadiusX="1" RadiusY="1" Margin="0.75,0"/>
                                            <Rectangle x:Name="WaveBar2" Width="2.5" Height="14" Fill="#00E5FF" RadiusX="1" RadiusY="1" Margin="0.75,0"/>
                                            <Rectangle x:Name="WaveBar3" Width="2.5" Height="6" Fill="#00E5FF" RadiusX="1" RadiusY="1" Margin="0.75,0"/>
                                            <Rectangle x:Name="WaveBar4" Width="2.5" Height="11" Fill="#00E5FF" RadiusX="1" RadiusY="1" Margin="0.75,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="IslandExpandedTrack" Text="No Media Playing" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="IslandExpandedArtist" Text="Horizon Web Engine" Foreground="#8E9297" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#1FFFFFFF" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonUp="BtnIslandPrev_Click" ToolTip="Previous Track">
                                            <TextBlock Text="&#x23EE;" FontSize="10.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#35FFFFFF" Cursor="Hand" Margin="0,0,4,0" MouseLeftButtonUp="BtnIslandPlayPause_Click" ToolTip="Play / Pause">
                                            <TextBlock x:Name="TxtIslandExpandedPlayPause" Text="&#x25B6;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#1FFFFFFF" Cursor="Hand" MouseLeftButtonUp="BtnIslandNext_Click" ToolTip="Next Track">
                                            <TextBlock Text="&#x23ED;" FontSize="10.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Deck 4: Notes Deck -->
                                <Grid x:Name="IslandDeckNotes" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="IslandExpNotesSnippet" Text="Quick Notes" Foreground="#F5F5F5" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="24" CornerRadius="12" Background="#30FFD54F" BorderBrush="#80FFD54F" BorderThickness="1" Padding="9,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandOpenNotesWindow_Click">
                                        <TextBlock Text="&#x270E; Open Notes" FontSize="10" FontWeight="SemiBold" Foreground="#FFD54F" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Deck 5: Download Deck -->
                                <Grid x:Name="IslandDeckDownload" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="IslandExpDownloadInfo" Text="Downloading..." Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="IslandExpDownloadProgress" Height="3" Maximum="100" Value="60" Foreground="#00E5FF" Background="#20FFFFFF" BorderThickness="0" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="24" CornerRadius="12" Background="#3000E5FF" BorderBrush="#8000E5FF" BorderThickness="1" Padding="9,0" Cursor="Hand" MouseLeftButtonUp="BtnIslandOpenDownloads_Click">
                                        <TextBlock Text="&#x2B07; Downloads" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Popup>

        </Grid>

    </Border>

</Window>