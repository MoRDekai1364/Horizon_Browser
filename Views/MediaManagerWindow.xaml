<Window x:Class="Horizon.Stealth.Views.MediaManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Manager"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush_DeepBackground}"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" PreviewDragEnter="Window_DragEnter">
    <Window.Resources>
        <Style x:Key="TabRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="6" Padding="6" CornerRadius="10"
                                Background="#18808080" BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="0,0,0,4" Padding="10,8" CornerRadius="8"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtHeaderTitle" Grid.Column="0" Text="WALLPAPERS //" Foreground="{DynamicResource Brush_Accent}"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                <RadioButton x:Name="TabWallpapers" Content="WALLPAPERS" GroupName="MediaKindTab" Style="{StaticResource TabRadioStyle}" Click="TabWallpapers_Click"/>
                <RadioButton x:Name="TabVideos" Content="STARTUP VIDEO" GroupName="MediaKindTab" Style="{StaticResource TabRadioStyle}" Click="TabVideos_Click"/>
                <TextBlock x:Name="TxtHeaderSub" Text="" Foreground="#999999" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="2" Content="&#x2715;" Click="BtnClose_Click"
                    Width="36" Height="36" Background="Transparent" Foreground="{DynamicResource Brush_SoftText}"
                    BorderThickness="0" FontSize="15" Cursor="Hand" ToolTip="Close (Esc)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Body -->
        <Grid x:Name="PnlBody" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Collections rail -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="COLLECTIONS" Foreground="{DynamicResource Brush_Accent}" FontSize="13" FontWeight="Bold" Margin="2,0,0,8"/>
                <ListBox x:Name="ListCollections" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ListCollections_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ActiveMark}" Foreground="{DynamicResource Brush_Accent}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="{DynamicResource Brush_SoftText}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="#999999" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="BtnPlayCollection" Content="&#x25B6; Play collection" Height="30" Padding="12,0" Margin="0,0,8,8" Click="BtnPlayCollection_Click"/>
                    <Button x:Name="BtnNewCollection" Content="+ New" Height="30" Padding="12,0" Margin="0,0,8,8" Click="BtnNewCollection_Click"/>
                    <Button x:Name="BtnRenameCollection" Content="Rename" Height="30" Padding="12,0" Margin="0,0,8,8" Click="BtnRenameCollection_Click"/>
                    <Button x:Name="BtnDeleteCollection" Content="Delete" Height="30" Padding="12,0" Margin="0,0,8,8" Click="BtnDeleteCollection_Click"/>
                </WrapPanel>
            </Grid>

            <!-- Items of the selected collection -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock x:Name="TxtCollectionTitle" Text="" Foreground="{DynamicResource Brush_SoftText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCollectionCount" Text="" Foreground="#999999" FontSize="13" Margin="12,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1">
                        <Button x:Name="BtnAdd" Content="+ Add images..." Height="30" Padding="12,0" Margin="0,0,8,6" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnSetSingle" Content="Set as wallpaper" Height="30" Padding="12,0" Margin="0,0,8,6" Click="BtnSetSingle_Click"/>
                        <Button x:Name="BtnUseSelection" Content="Rotate selected" Height="30" Padding="12,0" Margin="0,0,8,6" Click="BtnUseSelection_Click"
                                ToolTip="Select two or more (Ctrl/Shift+click) to rotate between them"/>
                        <Button x:Name="BtnRemove" Content="Delete selected" Height="30" Padding="12,0" Margin="0,0,16,6" Click="BtnRemove_Click"/>
                        <TextBlock Text="Order" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <ComboBox x:Name="CmbOrder" Width="110" Height="30" Margin="0,0,16,6" SelectionChanged="CmbOrder_SelectionChanged">
                            <ComboBoxItem Content="Random"/>
                            <ComboBoxItem Content="Sequential"/>
                        </ComboBox>
                        <CheckBox x:Name="ChkRemember" Content="Remember original file locations" Foreground="{DynamicResource Brush_SoftText}"
                                  VerticalAlignment="Center" Margin="0,0,0,6" Click="ChkRemember_Click"
                                  ToolTip="Off (default): files are copied into the browser and the original path is forgotten"/>
                    </WrapPanel>
                </Grid>

                <ListBox x:Name="ListTiles" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource TileItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ListTiles_SelectionChanged"
                         MouseDoubleClick="ListTiles_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="190">
                                <Grid Height="112">
                                    <Border Background="#22000000" CornerRadius="6"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    <TextBlock Text="{Binding PlaceholderText}" Foreground="#999999" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Padding="6,1"
                                            CornerRadius="9" Background="#CC000000" Visibility="{Binding BadgeVisibility}">
                                        <TextBlock Text="&#x25CF; ACTIVE" Foreground="{DynamicResource Brush_Accent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Foreground="{DynamicResource Brush_SoftText}"
                                           FontSize="12" Margin="2,6,2,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Drop zone -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Margin="-24,-20,-24,-16" Panel.ZIndex="100" Visibility="Collapsed"
                AllowDrop="True" Background="#E6101010"
                BorderBrush="{DynamicResource Brush_Accent}" BorderThickness="3"
                DragOver="Overlay_DragOver" DragLeave="Overlay_DragLeave" Drop="Overlay_Drop">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock x:Name="TxtDropTitle" Text="Drop files or a folder to add them" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="A folder can become a collection, or its files can be added to the selected one"
                           Foreground="#BBBBBB" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="" Foreground="#999999" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar x:Name="ProgBusy" Width="130" Height="6" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                <Button x:Name="BtnCancelImport" Content="Cancel" Height="24" Padding="10,0" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnCancelImport_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
