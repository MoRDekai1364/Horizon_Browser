<Window x:Class="Horizon.Stealth.Views.WebAppManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Web App Settings"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        Width="680" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{DynamicResource Brush_Text}"
        KeyDown="Window_KeyDown">

    <Grid x:Name="OuterGrid" Margin="0">
        <Grid x:Name="CardClipHost">
            <Border x:Name="CardBaseBg" CornerRadius="8" Background="{DynamicResource Brush_SurfaceCard}" IsHitTestVisible="False"/>

            <DockPanel LastChildFill="True">

                <Border DockPanel.Dock="Top" Height="56" Padding="18,0,14,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        Background="{DynamicResource Brush_SurfaceChrome}"
                        BorderBrush="{DynamicResource Brush_SurfaceChromeStroke}"
                        BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush_Text}"/>
                            <TextBlock x:Name="TxtUrl" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush_MutedText}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Cursor="Hand"
                                Background="{DynamicResource Brush_SurfaceField}" MouseLeftButtonDown="BtnClose_Down" MouseLeftButtonUp="BtnClose_Click">
                            <TextBlock Text="&#x2715;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush_SoftText}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" MinHeight="46" Padding="18,8"
                        Background="{DynamicResource Brush_SurfaceChrome}"
                        BorderBrush="{DynamicResource Brush_SurfaceChromeStroke}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Reset" Width="72" Height="28"
                                    Style="{DynamicResource Style_StealthButton}" Click="BtnReset_Click"/>
                            <Button Content="Save" Width="72" Height="28" Margin="6,0,0,0"
                                    Style="{DynamicResource Style_StealthButton}" Click="BtnSave_Click"/>
                            <Button Content="Save &amp; restart" Width="120" Height="28" Margin="6,0,0,0"
                                    Style="{DynamicResource Style_StealthButton}" Click="BtnSaveRestart_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtStatus" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,12,0" Foreground="{DynamicResource Brush_MutedText}"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,14,18,14">

                        <TextBlock Text="WEB APP" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Brush_Accent}"/>

                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Rename" Width="84" Height="28" Margin="8,0,0,0"
                                    Style="{DynamicResource Style_StealthButton}" Click="BtnRename_Click"/>
                            <TextBox x:Name="TxtName" Height="28" VerticalContentAlignment="Center" MaxLength="40" Padding="8,0"
                                     Background="{DynamicResource Brush_SurfaceField}"
                                     BorderBrush="{DynamicResource Brush_SurfaceFieldStroke}"
                                     Foreground="{DynamicResource Brush_Text}"
                                     CaretBrush="{DynamicResource Brush_Text}"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Recreate shortcuts" Width="130" Height="28"
                                    Style="{DynamicResource Style_StealthButton}" Click="BtnShortcuts_Click"/>
                            <Button Content="Uninstall" Width="84" Height="28" Margin="8,0,0,0"
                                    Style="{DynamicResource Style_StealthButton}" Click="BtnUninstall_Click"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkOffer" Margin="0,6,0,0" Click="ChkOffer_Click"
                                  Content="Ask what to do when a link leaves a Web App's site (all Web Apps)"/>

                        <TextBlock x:Name="TxtGeneralStatus" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush_MutedText}"/>

                        <TextBlock Text="EXTENSIONS" FontSize="11" FontWeight="Bold" Margin="0,22,0,8"
                                   Foreground="{DynamicResource Brush_Accent}"/>

                        <CheckBox x:Name="ChkExtensionsEnabled" Content="Allow extensions in this Web App"
                                  Checked="AnyBox_Changed" Unchecked="AnyBox_Changed"/>

                        <TextBlock x:Name="TxtIsolationNote" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush_MutedText}"/>

                        <TextBlock Text="Access by permission type (every extension)" FontWeight="SemiBold" Margin="0,18,0,4"/>
                        <StackPanel x:Name="PnlTypes"/>

                        <TextBlock Text="Access per extension" FontWeight="SemiBold" Margin="0,18,0,4"/>
                        <StackPanel x:Name="PnlExtensions"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
