<Window x:Class="Horizon.Stealth.Views.WebAppManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Web App Settings" Width="720" Height="700" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush_Background}"
        Foreground="{DynamicResource Brush_Text}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush_Text}"/>
            <TextBlock x:Name="TxtUrl" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush_Text}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="WEB APP" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"
                           Foreground="{DynamicResource Brush_Accent}"/>

                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Rename" Width="90" Height="28" Margin="8,0,0,0"
                            Style="{DynamicResource Style_StealthButton}" Click="BtnRename_Click"/>
                    <TextBox x:Name="TxtName" Height="28" VerticalContentAlignment="Center" MaxLength="40"
                             Background="#101010" BorderBrush="#2a2a2a" Foreground="{DynamicResource Brush_Text}"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Recreate shortcuts" Width="140" Height="28"
                            Style="{DynamicResource Style_StealthButton}" Click="BtnShortcuts_Click"/>
                    <Button Content="Uninstall" Width="90" Height="28" Margin="8,0,0,0"
                            Style="{DynamicResource Style_StealthButton}" Click="BtnUninstall_Click"/>
                </StackPanel>

                <CheckBox x:Name="ChkOffer" Margin="0,6,0,0" Click="ChkOffer_Click"
                          Content="Ask what to do when a link leaves a Web App's site (applies to all Web Apps)"/>

                <TextBlock x:Name="TxtGeneralStatus" Opacity="0.75" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="EXTENSIONS" FontSize="14" FontWeight="Bold" Margin="0,24,0,8"
                           Foreground="{DynamicResource Brush_Accent}"/>

                <CheckBox x:Name="ChkExtensionsEnabled" Content="Allow extensions in this Web App"
                          Checked="AnyBox_Changed" Unchecked="AnyBox_Changed"/>

                <TextBlock x:Name="TxtIsolationNote" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <TextBlock Text="Access by permission type (applies to every extension)" FontWeight="SemiBold"
                           Margin="0,18,0,4"/>
                <StackPanel x:Name="PnlTypes"/>

                <TextBlock Text="Access per extension" FontWeight="SemiBold" Margin="0,18,0,4"/>
                <StackPanel x:Name="PnlExtensions"/>

            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Reset" Width="80" Height="30"
                        Style="{DynamicResource Style_StealthButton}" Click="BtnReset_Click"/>
                <Button Content="Save" Width="80" Height="30" Margin="8,0,0,0"
                        Style="{DynamicResource Style_StealthButton}" Click="BtnSave_Click"/>
                <Button Content="Save &amp; restart Web App" Width="170" Height="30" Margin="8,0,0,0"
                        Style="{DynamicResource Style_StealthButton}" Click="BtnSaveRestart_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
