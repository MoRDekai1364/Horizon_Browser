<Window x:Class="Horizon.Stealth.Views.DownloadsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads &amp; File Browser"
        WindowStyle="None" WindowState="Maximized" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush_DeepBackground}"
        Foreground="{DynamicResource Brush_Text}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="MgrFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MgrModeTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MgrPillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MgrRowStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Far-right corner Close Button (Fitts's Law) -->
        <Button Click="BtnClose_Click" Panel.ZIndex="100"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="56" Height="44" Background="#16FFFFFF" Foreground="{DynamicResource Brush_SoftText}"
                BorderThickness="0" Cursor="Hand" ToolTip="Close (Esc)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,0,0,12"
                            BorderBrush="#26FFFFFF" BorderThickness="1,0,0,1">
                        <Path x:Name="XIcon" Data="M 0,0 L 12,12 M 12,0 L 0,12"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C40D1D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    <Grid Margin="26,20,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,46,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="DOWNLOADS &amp; FILES //" Foreground="{DynamicResource Brush_Accent}"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0">
                <RadioButton x:Name="TabDownloads" Content="DOWNLOADS" GroupName="DlViewMode" IsChecked="True"
                             Style="{StaticResource MgrModeTabStyle}" Click="ViewMode_Changed"/>
                <RadioButton x:Name="TabFileBrowser" Content="FILE BROWSER" GroupName="DlViewMode"
                             Style="{StaticResource MgrModeTabStyle}" Click="ViewMode_Changed"/>
            </StackPanel>

            <!-- Search Pill -->
            <Border Grid.Column="2" MaxWidth="440" HorizontalAlignment="Left" MinWidth="240" Width="360" Height="36"
                    Background="#1E808080" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="13" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Brush_Text}" CaretBrush="{DynamicResource Brush_Text}"
                             FontSize="13" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged" ToolTip="Filter files and folders (Ctrl+F)"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="&#x2715;" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Foreground="#999999" Cursor="Hand"
                            FontSize="11" Padding="4,0" Click="BtnClearSearch_Click"/>
                </Grid>
            </Border>

            <!-- Top-right Actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnNewFolder" Content="+ New Folder" Margin="0,0,8,0"
                        Style="{StaticResource MgrPillBtnStyle}" Click="BtnNewFolder_Click"
                        ToolTip="Create a new folder in current directory"/>
                <Button x:Name="BtnOpenExplorer" Content="&#x1F4C2; Open in Explorer" Margin="0,0,8,0"
                        Style="{StaticResource MgrPillBtnStyle}" Click="BtnOpenExplorer_Click"/>
                <Button x:Name="BtnSetDownloadsDir" Content="&#x2699; Change Folder" Margin="0,0,0,0"
                        Style="{StaticResource MgrPillBtnStyle}" Click="BtnSetDownloadsDir_Click"
                        ToolTip="Set default downloads folder"/>
            </StackPanel>
        </Grid>

        <!-- Active Downloads Banner -->
        <Border x:Name="PnlActiveDownloads" Grid.Row="1" Visibility="Collapsed"
                Background="#1A2639" BorderBrush="#3860A5FA" BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ACTIVE DOWNLOADS" FontSize="10.5" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,6"/>
                <ItemsControl x:Name="LstActiveDownloads">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush_Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                             Height="6" Margin="12,0" VerticalAlignment="Center"
                                             Background="#1AFFFFFF" Foreground="{DynamicResource Brush_Accent}" BorderThickness="0"/>
                                <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="11.5" Foreground="#93C5FD"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Contextual Multi-Select Bar -->
        <Border x:Name="PnlBulkBar" Grid.Row="2" Visibility="Collapsed"
                Background="#243B82F6" BorderBrush="#5560A5FA" BorderThickness="1" CornerRadius="10"
                Padding="14,8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Open Selected" Style="{StaticResource MgrPillBtnStyle}" Margin="0,0,8,0" Click="BtnBulkOpen_Click"/>
                    <Button Content="Copy Paths" Style="{StaticResource MgrPillBtnStyle}" Margin="0,0,8,0" Click="BtnBulkCopyPath_Click"/>
                    <Button Content="Delete Selected" Style="{StaticResource MgrPillBtnStyle}" Background="#55EF4444" BorderBrush="#88F87171" Click="BtnBulkDelete_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtBulkCount" Text="0 items selected" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Body: Left Rail + File Browser List -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Rail: File Types, Quick Access, Drives -->
            <Border Grid.Column="0" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="FILE TYPE FILTER" FontSize="10.5" FontWeight="Bold" Foreground="#8894A6" Margin="8,2,0,6"/>
                        <RadioButton x:Name="RbTypeAll" Content="All Items" GroupName="DlType" IsChecked="True" Style="{StaticResource MgrFilterRadioStyle}" Click="TypeFilter_Changed"/>
                        <RadioButton x:Name="RbTypeFolders" Content="Folders Only" GroupName="DlType" Style="{StaticResource MgrFilterRadioStyle}" Click="TypeFilter_Changed"/>
                        <RadioButton x:Name="RbTypeDocs" Content="Documents &amp; PDFs" GroupName="DlType" Style="{StaticResource MgrFilterRadioStyle}" Click="TypeFilter_Changed"/>
                        <RadioButton x:Name="RbTypeImages" Content="Images" GroupName="DlType" Style="{StaticResource MgrFilterRadioStyle}" Click="TypeFilter_Changed"/>
                        <RadioButton x:Name="RbTypeMedia" Content="Audio &amp; Video" GroupName="DlType" Style="{StaticResource MgrFilterRadioStyle}" Click="TypeFilter_Changed"/>
                        <RadioButton x:Name="RbTypeArchives" Content="Archives &amp; Installers" GroupName="DlType" Style="{StaticResource MgrFilterRadioStyle}" Click="TypeFilter_Changed"/>

                        <TextBlock Text="QUICK ACCESS &amp; DRIVES" FontSize="10.5" FontWeight="Bold" Foreground="#8894A6" Margin="8,14,0,6"/>
                        <ListBox x:Name="LstPlaces" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LstPlaces_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1E808080"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Brush_Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main File Browser Panel -->
            <Border Grid.Column="2" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Navigation / Sort Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="BtnBack" Content="&#x2190;" Style="{StaticResource MgrPillBtnStyle}" Padding="10,5" Margin="0,0,6,0"
                                    Click="BtnBack_Click" ToolTip="Back"/>
                            <Button x:Name="BtnUp" Content="&#x2191; Up" Style="{StaticResource MgrPillBtnStyle}" Padding="10,5" Margin="0,0,6,0"
                                    Click="BtnUp_Click" ToolTip="Parent folder"/>
                            <Button x:Name="BtnRefresh" Content="&#x21BB;" Style="{StaticResource MgrPillBtnStyle}" Padding="10,5" Margin="0,0,10,0"
                                    Click="BtnRefresh_Click" ToolTip="Refresh"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtCurrentPath" FontSize="12" Foreground="{DynamicResource Brush_SoftText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnSortDate" Content="Date" Style="{StaticResource MgrPillBtnStyle}" Padding="10,5" Margin="0,0,5,0" Click="BtnSortDate_Click"/>
                            <Button x:Name="BtnSortName" Content="Name" Style="{StaticResource MgrPillBtnStyle}" Padding="10,5" Margin="0,0,5,0" Click="BtnSortName_Click"/>
                            <Button x:Name="BtnSortSize" Content="Size" Style="{StaticResource MgrPillBtnStyle}" Padding="10,5" Margin="0,0,5,0" Click="BtnSortSize_Click"/>
                            <Button x:Name="BtnSortDir" Content="&#x2193;" Style="{StaticResource MgrPillBtnStyle}" Padding="9,5" Click="BtnSortDir_Click" ToolTip="Toggle ascending/descending"/>
                        </StackPanel>
                    </Grid>

                    <!-- File & Folder List -->
                    <ListBox x:Name="LstFiles" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource MgrRowStyle}"
                             SelectionChanged="LstFiles_SelectionChanged"
                             MouseDoubleClick="LstFiles_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#20FFFFFF"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush_Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#8E9AAE"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="11.5" Foreground="#8E9AAE"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" FontSize="11.5" Foreground="#8E9AAE"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#x2197;" Tag="{Binding}" Click="BtnRowOpen_Click"
                                                Style="{StaticResource MgrPillBtnStyle}" Padding="8,4" Margin="0,0,5,0"
                                                ToolTip="Open"/>
                                        <Button Content="&#x1F4C2;" Tag="{Binding}" Click="BtnRowReveal_Click"
                                                Style="{StaticResource MgrPillBtnStyle}" Padding="8,4" Margin="0,0,5,0"
                                                ToolTip="Show in Explorer"/>
                                        <Button Content="&#x270E;" Tag="{Binding}" Click="BtnRowRename_Click"
                                                Style="{StaticResource MgrPillBtnStyle}" Padding="8,4" Margin="0,0,5,0"
                                                ToolTip="Rename"/>
                                        <Button Content="&#x2715;" Tag="{Binding}" Click="BtnRowDelete_Click"
                                                Style="{StaticResource MgrPillBtnStyle}" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                ToolTip="Delete"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="TxtEmpty" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="This folder is empty or no items match your filter." FontSize="14" Foreground="#8E9AAE"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnPinFolder" Content="&#x1F4CC; Pin Current Folder" Style="{StaticResource MgrPillBtnStyle}"
                        Margin="0,0,8,0" Click="BtnPinFolder_Click"/>
                <Button Content="All Drives (This PC)" Style="{StaticResource MgrPillBtnStyle}" Click="BtnShowDrives_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStats" Text="0 items" FontSize="12" Foreground="#8E9AAE" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
