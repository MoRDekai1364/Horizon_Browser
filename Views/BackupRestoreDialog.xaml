<Window x:Class="Horizon.Stealth.Views.BackupRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup &amp; Restore Manager"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0E121E"
        Foreground="#EAF6FF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2235"/>
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="BorderBrush" Value="#2A3855"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25334D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0B0F1A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="BACKUP &amp; RESTORE MANAGER"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#00D9FF"/>
            <TextBlock Text="Safely preserve and recover your passwords, bookmarks, settings, and profile."
                       FontSize="12" Foreground="#8FA3BF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Backup Card -->
                <Border Background="#141B2D" BorderBrush="#202C45" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Create New Backup" FontSize="14" FontWeight="Bold" Foreground="#EAF6FF"/>
                        <TextBlock Text="Generates a full snapshot of your current settings, password vault, and history."
                                   FontSize="11" Foreground="#7E93AE" Margin="0,2,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnCreateBackup" Content="CREATE BACKUP NOW" Click="BtnCreateBackup_Click"
                                    Background="#00D9FF" Foreground="#0B0F1A" FontWeight="Bold" Padding="16,8"/>
                            <Button x:Name="BtnOpenFolder" Content="Open Backups Folder" Click="BtnOpenFolder_Click"
                                    Margin="12,0,0,0" Padding="12,8"/>
                        </StackPanel>

                        <!-- Progress Section -->
                        <StackPanel x:Name="PanelProgress" Visibility="Collapsed" Margin="0,8,0,0">
                            <ProgressBar x:Name="ProgressBarStatus" Height="6" Background="#1C273D" Foreground="#00D9FF" BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtStatus" Text="Working..." FontSize="11" Foreground="#00D9FF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Restore Card -->
                <Border Background="#141B2D" BorderBrush="#202C45" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Restore from Backup" FontSize="14" FontWeight="Bold" Foreground="#EAF6FF"/>
                        <TextBlock Text="Select a previously created backup snapshot or choose a folder."
                                   FontSize="11" Foreground="#7E93AE" Margin="0,2,0,12"/>

                        <TextBlock Text="Available Local Backups:" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3BF" Margin="0,0,0,4"/>
                        <ListBox x:Name="ListBackups" Height="100" Background="#0E1424" BorderBrush="#25334D"
                                 Foreground="#EAF6FF" FontSize="11" SelectionMode="Single"
                                 SelectionChanged="ListBackups_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#00D9FF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Foreground="#7E93AE" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnRestoreSelected" Content="RESTORE SELECTED" Click="BtnRestoreSelected_Click"
                                    IsEnabled="False" FontWeight="Bold" Padding="16,8"/>
                            <Button x:Name="BtnBrowseOther" Content="Browse Custom Backup..." Click="BtnBrowseOther_Click"
                                    Margin="12,0,0,0" Padding="12,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Detected Existing Installations Card -->
                <Border x:Name="BorderDetectedInstallations" Background="#141B2D" BorderBrush="#FFB800" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Detected Existing Horizon Installations" FontSize="14" FontWeight="Bold" Foreground="#FFB800"/>
                                <TextBlock Text="Found other installations on this computer. You can migrate your profile data from them."
                                           FontSize="11" Foreground="#7E93AE" Margin="0,2,0,8"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnOpenDetectedDialog" Content="VIEW &amp; MIGRATE" Click="BtnOpenDetectedDialog_Click"
                                    Background="#FFB800" Foreground="#0B0F1A" FontWeight="Bold" Padding="12,6" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="PanelDetectedSummary" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="CLOSE" Click="BtnClose_Click" HorizontalAlignment="Right" Padding="20,6"/>
        </Grid>
    </Grid>
</Window>
