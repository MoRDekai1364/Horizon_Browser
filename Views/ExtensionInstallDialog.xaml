<Window x:Class="Horizon.Stealth.Views.ExtensionInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Extension"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="#F012151E"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.65" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row: Icon, Title, Store -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="12" Background="#222736" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="ImgIcon" Width="36" Height="36" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtIconFallback" Text="🧩" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="TxtTitle" Text="Extension Name" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Chrome Web Store" Foreground="#8892B0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="1" Height="1" Background="#20FFFFFF" Margin="0,0,0,14"/>

            <!-- Permissions Block -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Permissions Requested:" Foreground="#DDE3F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Uncheck to restrict non-essential access" Foreground="#7A9EFF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Background="#1A1D27" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="IcnPermissions">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  VerticalAlignment="Top" Margin="0,2,8,0" Cursor="Hand"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#CCD5E8" FontSize="12" FontWeight="SemiBold"/>
                                                <Border CornerRadius="4" Background="#26334D" Margin="6,0,0,0" Padding="4,1"
                                                        Visibility="{Binding EssentialBadgeVisibility}">
                                                    <TextBlock Text="Required" Foreground="#7A9EFF" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="#8892B0" FontSize="10.5" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Progress & Status Info -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock x:Name="TxtStatus" Text="Ready to install" Foreground="#8892B0" FontSize="12" Margin="0,0,0,6"/>
                <ProgressBar x:Name="ProgressBarInstall" Height="4" IsIndeterminate="True" Visibility="Collapsed" Background="#20FFFFFF" Foreground="#3D68FF"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancel" Grid.Column="1" Content="Cancel" Click="BtnCancel_Click"
                        Width="90" Height="34" Margin="0,0,10,0" Cursor="Hand"
                        Background="#252A38" Foreground="#CCD5E8" BorderBrush="#35FFFFFF" BorderThickness="1">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnInstall" Grid.Column="2" Content="Add Extension" Click="BtnInstall_Click"
                        Padding="16,0" Height="34" Cursor="Hand" FontWeight="SemiBold"
                        Background="#3D68FF" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
