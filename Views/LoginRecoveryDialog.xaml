<Window x:Class="Horizon.Stealth.Views.LoginRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identity Bridge" Height="380" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="#1E1E1E" BorderBrush="#444" BorderThickness="1" CornerRadius="8">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Identity Bridge" Foreground="#FFF" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="TxtIntro" Text="Security checks are preventing a direct login. To fix this, we need to verify your identity by syncing with your main browser." 
                           Foreground="#CCC" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <Border Background="#252525" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <TextBlock Text="INSTRUCTIONS:" Foreground="#AAA" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="1." Foreground="#007ACC" FontWeight="Bold" Width="20"/>
                            <TextBlock x:Name="TxtStep1" Text="Open [Browser] and ensure you are logged into [Site]." 
                                       Foreground="#DDD" TextWrapping="Wrap" Width="400"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="2." Foreground="#007ACC" FontWeight="Bold" Width="20"/>
                            <TextBlock x:Name="TxtStep2" Text="Close [Browser] completely. (Required to unlock session)." 
                                       Foreground="#DDD" FontWeight="Bold" TextWrapping="Wrap" Width="400"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="3." Foreground="#007ACC" FontWeight="Bold" Width="20"/>
                            <TextBlock Text="Security Note: Your Antivirus MAY flag this action because we access secure storage. Please open Windows Security and temporarily pause 'Real-Time Protection'." 
                                       Foreground="#AA8844" TextWrapping="Wrap" Width="400"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtStatus" Text="Ready to sync." Foreground="#666" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" IsCancel="True" Click="BtnCancel_Click" 
                        Width="100" Height="30" Margin="0,0,10,0"
                        Background="Transparent" Foreground="#AAA" BorderBrush="#444"/>
                
                <Button x:Name="BtnSync" Content="Sync Session" Click="BtnSync_Click" 
                        Width="120" Height="30" 
                        Background="#007ACC" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>