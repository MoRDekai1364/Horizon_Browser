<Window x:Class="Horizon.Stealth.Views.LoginRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identity Bridge &amp; Site Recovery" Height="450" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="ModernDialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="#E8ECF4"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#48FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernDialogButtonStyle}">
            <Setter Property="Background" Value="#FF3B82F6"/>
            <Setter Property="BorderBrush" Value="#6693C5FD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="#F4151821" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="14"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="&#x2715;" Width="28" Height="28" Padding="0"
                        Style="{StaticResource ModernDialogButtonStyle}" Background="Transparent" BorderThickness="0"
                        Foreground="#9CA3AF" Click="BtnCancel_Click" ToolTip="Close"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#263B82F6" BorderBrush="#4D3B82F6" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="&#x1F6E1;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#60A5FA"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Identity Bridge &amp; Anti-Bot Recovery" Foreground="#F3F4F6" FontSize="15.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtDomainSubtitle" Text="Target site: ..." Foreground="#9CA3AF" FontSize="11.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Body -->
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="TxtIntro"
                           Text="If a website blocks sign-in or loops on anti-bot checks, you can bypass site injections (Safe Mode) or import your active session tokens from another browser."
                           Foreground="#CBD5E1" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Option 1: Safe Mode / Bypass Protections -->
                <Border Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,10">
                    <DockPanel>
                        <Button x:Name="BtnSafeMode" DockPanel.Dock="Right" Content="Enable Safe Mode"
                                Style="{StaticResource ModernDialogButtonStyle}" Margin="12,0,0,0"
                                Click="BtnSafeMode_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="1. Site Safe Mode (Bypass Scripts &amp; Spoofing)" Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Exempts this domain from automation scripts and fingerprint hooks, then reloads cleanly."
                                       Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Option 2: Browser Session Sync -->
                <Border Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="2. Sync Authenticated Session" Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtStep1" Text="&#x2022; Sign in to the site in your external browser, or import an exported cookies.json file."
                                   Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtStep2" Text="&#x2022; Close the external browser before syncing so its session database is unlocked."
                                   Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <DockPanel>
                            <Button x:Name="BtnImportJson" DockPanel.Dock="Right" Content="Import JSON..."
                                    Style="{StaticResource ModernDialogButtonStyle}" Padding="12,6"
                                    Click="BtnImportJson_Click" ToolTip="Import cookies from a JSON file"/>
                            <Button x:Name="BtnForceCloseAndSync" DockPanel.Dock="Right" Content="Close Browser &amp; Sync"
                                    Style="{StaticResource ModernDialogButtonStyle}" Padding="12,6" Margin="0,0,8,0"
                                    Visibility="Collapsed" Click="BtnForceCloseAndSync_Click"/>
                            <TextBlock x:Name="TxtDetectedBrowser" VerticalAlignment="Center"
                                       Text="Source: Google Chrome" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtStatus" Text="Ready." Foreground="#94A3B8" FontSize="12"
                           Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Content="Cancel" IsCancel="True" Click="BtnCancel_Click"
                        Style="{StaticResource ModernDialogButtonStyle}" Width="96" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSync" Content="Sync Session" Click="BtnSync_Click"
                            Style="{StaticResource PrimaryDialogButtonStyle}" Width="136"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
