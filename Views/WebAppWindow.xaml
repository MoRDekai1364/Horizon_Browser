<Window x:Class="Horizon.Stealth.Views.WebAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Horizon.Stealth.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Horizon Web App" Height="750" Width="1100"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush_Background}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarCloseButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C4101F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OfferButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OfferAccentButton" TargetType="Button" BasedOn="{StaticResource OfferButton}">
            <Setter Property="Background" Value="#FF3B82F6"/>
            <Setter Property="BorderBrush" Value="#6693C5FD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="OfferBar" Grid.Row="0" Visibility="Collapsed"
                HorizontalAlignment="Left" Margin="0,0,260,0"
                Background="#F4141824" BorderBrush="#4060CDFF" BorderThickness="0,0,1,1"
                CornerRadius="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
            </Border.Effect>
            <DockPanel Margin="12,7">
                <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6"
                        Background="#263B82F6" BorderBrush="#4D60A5FA" BorderThickness="1"
                        Margin="0,0,9,0" VerticalAlignment="Center">
                    <TextBlock Text="&#x2197;" FontSize="12" FontWeight="Bold" Foreground="#60A5FA"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="BtnOfferStay" DockPanel.Dock="Left" Style="{StaticResource OfferAccentButton}"
                        Content="Stay here" Click="BtnOfferStay_Click"/>
                <Button x:Name="BtnOfferHorizon" DockPanel.Dock="Left" Style="{StaticResource OfferButton}"
                        Content="Open in Horizon" Click="BtnOfferHorizon_Click"/>
                <Button x:Name="BtnOfferBrowser" DockPanel.Dock="Left" Style="{StaticResource OfferButton}"
                        Content="Default browser" Click="BtnOfferBrowser_Click"/>
                <Button x:Name="BtnOfferNever" DockPanel.Dock="Left" Style="{StaticResource OfferButton}"
                        Background="Transparent" BorderThickness="0" Foreground="#9CA3AF"
                        Content="Don't ask again" Click="BtnOfferNever_Click"/>
                <TextBlock x:Name="OfferText" VerticalAlignment="Center" Foreground="#E5EDF7"
                           FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="4,0,4,0"/>
            </DockPanel>
        </Border>

        <controls:BrowserView x:Name="Browser" Grid.Row="1"/>
        <Image x:Name="SnapshotImage" Grid.Row="1" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Popup x:Name="BarPopup" AllowsTransparency="True" StaysOpen="True" Focusable="False"
               Placement="Relative" PlacementTarget="{Binding ElementName=RootGrid}"
               HorizontalOffset="0" VerticalOffset="0" IsOpen="False">
            <Grid x:Name="BarRoot" Height="36" Opacity="0">
                <Border CornerRadius="8,0,0,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F20b0b0b" Offset="0"/>
                            <GradientStop Color="#800b0b0b" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Rectangle x:Name="BarDragGrip" Fill="#01000000" Cursor="SizeAll"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Margin="0,0,186,0" MouseLeftButtonDown="BarDragGrip_MouseLeftButtonDown"/>
                <TextBlock x:Name="BarTitle" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="12,0,186,0" Foreground="#CCCCCC" FontSize="12"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Stretch" Margin="0">
                    <Button x:Name="BtnBarSettings" Style="{StaticResource BarButton}" Content="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="16" ToolTip="Web App settings" Click="BtnBarSettings_Click"/>
                    <Button x:Name="BtnBarMin" Style="{StaticResource BarButton}" Content="&#x2500;" Click="BtnBarMin_Click"/>
                    <Button x:Name="BtnBarMax" Style="{StaticResource BarButton}" Content="&#x25A1;" Click="BtnBarMax_Click"/>
                    <Button x:Name="BtnBarClose" Style="{StaticResource BarCloseButton}" Content="&#x2715;" Click="BtnBarClose_Click"/>
                </StackPanel>
            </Grid>
        </Popup>
    </Grid>
</Window>
