<Window x:Class="Horizon.Stealth.Views.StackElementWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Element" Width="520" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush_DeepBackground}"
        WindowStyle="None" BorderBrush="{DynamicResource Brush_Accent}" BorderThickness="1"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_ButtonBorder}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WizardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_MutedText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="WizardCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_ButtonBorder}"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="10,7" Margin="0,0,0,2" CornerRadius="8"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush_TabStripBgSelected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <TextBlock x:Name="TxtHeader" Text="ADD ELEMENT //" Foreground="{DynamicResource Brush_Accent}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="TxtSteps" Text="STEP 1 / 4" Foreground="{DynamicResource Brush_MutedText}"
                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <StackPanel x:Name="PnlStep1">
                <TextBlock Text="What do you want to add?" Foreground="{DynamicResource Brush_Text}" FontSize="14" Margin="0,0,0,12"/>
                <Border x:Name="CardWidget" Style="{StaticResource WizardCard}" Tag="Widget" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                    <StackPanel>
                        <TextBlock Text="Built-in widget" Foreground="{DynamicResource Brush_Text}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Clock, media, calendar, weather, battery, VPN, AdBlock"
                                   Foreground="{DynamicResource Brush_MutedText}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardSite" Style="{StaticResource WizardCard}" Tag="Site" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                    <StackPanel>
                        <TextBlock Text="Website" Foreground="{DynamicResource Brush_Text}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Any web address shown as a stack element"
                                   Foreground="{DynamicResource Brush_MutedText}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardTemplate" Style="{StaticResource WizardCard}" Tag="Template" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                    <StackPanel>
                        <TextBlock Text="Template" Foreground="{DynamicResource Brush_Text}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="A website optimized for a purpose: mail, videos, music, AI and more"
                                   Foreground="{DynamicResource Brush_MutedText}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid x:Name="PnlStep2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtStep2Title" Grid.Row="0" Text="Choose" Foreground="{DynamicResource Brush_Text}" FontSize="14" Margin="0,0,0,12"/>
                <ListBox x:Name="LstSource" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="16" Width="32"
                                           Foreground="{DynamicResource Brush_Text}"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource Brush_Text}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="PnlSiteUrl" Grid.Row="1" Visibility="Collapsed">
                    <TextBlock Text="Web address" Style="{StaticResource WizardLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSiteUrl"/>
                    <TextBlock Text="Example: example.com or https://example.com/page"
                               Foreground="{DynamicResource Brush_DisabledText}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="PnlStep3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource WizardLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTitle" MaxLength="40"/>
                    <TextBlock x:Name="TxtTitleHint" Text="Leave empty to use the site name"
                               Foreground="{DynamicResource Brush_DisabledText}" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock Text="Icon (emoji or symbol)" Style="{StaticResource WizardLabel}"/>
                    <TextBox x:Name="TxtIcon" Width="90" HorizontalAlignment="Left" MaxLength="8" FontFamily="Segoe UI Emoji"/>
                    <StackPanel x:Name="PnlTemplateUrl" Visibility="Collapsed">
                        <TextBlock Text="Web address" Style="{StaticResource WizardLabel}"/>
                        <TextBox x:Name="TxtTemplateUrl"/>
                    </StackPanel>
                    <StackPanel x:Name="PnlWebOptions" Visibility="Collapsed">
                        <TextBlock Text="Refresh interval" Style="{StaticResource WizardLabel}"/>
                        <ComboBox x:Name="CmbRefresh" Width="140" Height="28" HorizontalAlignment="Left"/>
                        <TextBlock Text="Login profile" Style="{StaticResource WizardLabel}"/>
                        <RadioButton x:Name="RbShared" Content="Shared with the main browser" GroupName="StackLogin"
                                     Foreground="{DynamicResource Brush_Text}" IsChecked="True" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RbIsolated" Content="Separate profile for this element" GroupName="StackLogin"
                                     Foreground="{DynamicResource Brush_Text}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="PnlStep4" Visibility="Collapsed">
                <TextBlock Text="Preview" Foreground="{DynamicResource Brush_Text}" FontSize="14" Margin="0,0,0,12"/>
                <Border x:Name="PnlPreview" Height="170" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="TxtSummary" Foreground="{DynamicResource Brush_MutedText}" FontSize="12"
                           Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="TxtError" Grid.Row="2" Foreground="{DynamicResource Brush_Alert}" FontSize="12"
                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="30" Click="BtnCancel_Click"/>
            <Button x:Name="BtnBack" Content="Back" Width="90" Height="30" Margin="10,0,0,0" Click="BtnBack_Click"/>
            <Button x:Name="BtnNext" Content="Next" Width="90" Height="30" Margin="10,0,0,0" Click="BtnNext_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
