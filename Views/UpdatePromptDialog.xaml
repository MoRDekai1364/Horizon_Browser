<Window x:Class="Horizon.Stealth.Views.UpdatePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon Browser Update"
        Width="580" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#EAF6FF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2235"/>
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="BorderBrush" Value="#2A3855"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25334D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0B0F1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00D9FF"/>
            <Setter Property="Foreground" Value="#0B0F1A"/>
            <Setter Property="BorderBrush" Value="#00B8D9"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#141B2A"/>
            <Setter Property="Foreground" Value="#8EA0BE"/>
            <Setter Property="BorderBrush" Value="#202C42"/>
        </Style>
    </Window.Resources>

    <!-- Outer Glass Shell -->
    <Border Background="#EB0E131F" BorderBrush="#3500D9FF" BorderThickness="1" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.85"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Drag Handle -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" Background="#1A2338" BorderBrush="#00D9FF" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                    <TextBlock Text="&#x21BB;" Foreground="#00D9FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Horizon Browser Update Available" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtVersionSummary" Text="Version 2.7.9 is available" FontSize="12" Foreground="#8EA0BE" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="&#x2715;" Width="32" Height="32" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClose_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Info Badges Bar -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Background="#141B2C" BorderBrush="#243048" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,52,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCurrentVersionBadge" Grid.Column="0" Text="Current: v2.7.8 (Release)" FontSize="11" Foreground="#8EA0BE"/>
                    <TextBlock x:Name="TxtTargetLocationBadge" Grid.Column="1" Text="Target: D:\Program Files\..." FontSize="11" Foreground="#00D9FF" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- ── Main Content Area (Multi-State View) ── -->
            <Grid Grid.Row="1" Margin="0,16,0,16">
                
                <!-- State 1: "Do you want to update?" -->
                <StackPanel x:Name="PanelStateQuestion" Visibility="Visible" VerticalAlignment="Center">
                    <TextBlock Text="A new version of Horizon Browser is ready for installation." FontSize="14" Foreground="#D0E2FF" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="Would you like to install the update?" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- YES Button Card -->
                        <Border Grid.Column="0" Background="#1A2840" BorderBrush="#00D9FF" BorderThickness="1" CornerRadius="8" Padding="16" MouseLeftButtonDown="CardYes_Click" Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x2713; Yes, Update" FontSize="15" FontWeight="Bold" Foreground="#00D9FF" HorizontalAlignment="Center"/>
                                <TextBlock Text="View update options" FontSize="11" Foreground="#8EA0BE" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- NO Button Card -->
                        <Border Grid.Column="2" Background="#161E2E" BorderBrush="#2C3B56" BorderThickness="1" CornerRadius="8" Padding="16" MouseLeftButtonDown="CardNo_Click" Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No, Remind Me Later" FontSize="15" FontWeight="Bold" Foreground="#E0E6F0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Postpone or skip version" FontSize="11" Foreground="#7888A0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- State 2: "Update Now or Later?" -->
                <StackPanel x:Name="PanelStateYesOptions" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="When would you like to update?" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                    <!-- Option A: Update Now -->
                    <Border Background="#1A2840" BorderBrush="#00D9FF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12" MouseLeftButtonDown="BtnUpdateNow_Click" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="&#x26A1; Update Now (Recommended)" FontSize="14" FontWeight="Bold" Foreground="#00D9FF"/>
                                <TextBlock Text="Close browser, protect settings, and auto-install into target directory." FontSize="11" Foreground="#95A8C5" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TxtNowTargetDir" Text="Location: D:\Program Files\Horizon_Browser_Official_Release" FontSize="10" Foreground="#657A9A" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#x2192;" FontSize="20" FontWeight="Bold" Foreground="#00D9FF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Option B: Update Later -->
                    <Border Background="#141C2A" BorderBrush="#2A3852" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="&#x23F0; Update Later" FontSize="13" FontWeight="Bold" Foreground="#E0E6F0" Margin="0,0,0,6"/>
                            <TextBlock Text="Choose download timing:" FontSize="11" Foreground="#8EA0BE" Margin="0,0,0,8"/>
                            
                            <RadioButton x:Name="RbDownloadNow" GroupName="DownloadTiming" IsChecked="True" Foreground="#D0E0F5" FontSize="12" Margin="0,0,0,4">
                                <TextBlock Text="Download in background now (ready to install on next launch)" Foreground="#D0E0F5"/>
                            </RadioButton>
                            <RadioButton x:Name="RbDownloadLater" GroupName="DownloadTiming" Foreground="#D0E0F5" FontSize="12" Margin="0,0,0,10">
                                <TextBlock Text="Download later when installation begins" Foreground="#D0E0F5"/>
                            </RadioButton>

                            <Button Content="Confirm Update Later" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="BtnConfirmUpdateLater_Click" Padding="14,6"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- State 3: "When would you like to be reminded?" (Snooze/No) -->
                <StackPanel x:Name="PanelStateNoSnooze" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="When would you like to be reminded?" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                    <TextBlock Text="Select a reminder interval for this update:" FontSize="12" Foreground="#8EA0BE" Margin="0,0,0,12"/>

                    <Border Background="#141C2A" BorderBrush="#2A3852" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <RadioButton x:Name="RbSnoozeWeek" GroupName="SnoozeOption" IsChecked="True" Foreground="#D0E0F5" FontSize="12" Margin="0,4,0,8">
                                <TextBlock Text="Try again in 1 week (Default)" Foreground="#D0E0F5"/>
                            </RadioButton>
                            <RadioButton x:Name="RbSnoozeMonth" GroupName="SnoozeOption" Foreground="#D0E0F5" FontSize="12" Margin="0,0,0,8">
                                <TextBlock Text="Try again in 1 month" Foreground="#D0E0F5"/>
                            </RadioButton>
                            <RadioButton x:Name="RbSnoozeYear" GroupName="SnoozeOption" Foreground="#D0E0F5" FontSize="12" Margin="0,0,0,8">
                                <TextBlock Text="Try again in 1 year" Foreground="#D0E0F5"/>
                            </RadioButton>
                            <RadioButton x:Name="RbSnoozeNever" GroupName="SnoozeOption" Foreground="#D0E0F5" FontSize="12" Margin="0,0,0,4">
                                <TextBlock x:Name="TxtNeverOption" Text="Never for this version (resets when next update is released)" Foreground="#D0E0F5"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Button Content="Save Reminder Preference" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="BtnSaveSnooze_Click" Padding="16,8"/>
                </StackPanel>

            </Grid>

            <!-- Bottom Action Footer (Back Button when in sub-panel) -->
            <Grid Grid.Row="2">
                <Button x:Name="BtnBack" Content="&#x2190; Back" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="BtnBack_Click" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
