<Window x:Class="Horizon.Stealth.Views.ExtensionsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extensions"
        WindowStyle="None" WindowState="Maximized" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush_DeepBackground}"
        Foreground="{DynamicResource Brush_Text}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ExtFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExtModeTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExtPillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExtRowStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Far-right corner Close Button (Fitts's Law) -->
        <Button Click="BtnClose_Click" Panel.ZIndex="100"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="56" Height="44" Background="#16FFFFFF" Foreground="{DynamicResource Brush_SoftText}"
                BorderThickness="0" Cursor="Hand" ToolTip="Close (Esc)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,0,0,12"
                            BorderBrush="#26FFFFFF" BorderThickness="1,0,0,1">
                        <Path x:Name="XIcon" Data="M 0,0 L 12,12 M 12,0 L 0,12"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C40D1D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    <Grid Margin="26,20,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,46,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="EXTENSIONS //" Foreground="{DynamicResource Brush_Accent}"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,16,0">
                <RadioButton x:Name="TabAll" Content="ALL" GroupName="ExtViewMode" IsChecked="True"
                             Style="{StaticResource ExtModeTabStyle}" Click="ViewMode_Changed"/>
                <RadioButton x:Name="TabEnabled" Content="ENABLED" GroupName="ExtViewMode"
                             Style="{StaticResource ExtModeTabStyle}" Click="ViewMode_Changed"/>
                <RadioButton x:Name="TabDisabled" Content="DISABLED" GroupName="ExtViewMode"
                             Style="{StaticResource ExtModeTabStyle}" Click="ViewMode_Changed"/>
            </StackPanel>

            <!-- Search Pill -->
            <Border Grid.Column="2" MaxWidth="440" HorizontalAlignment="Left" MinWidth="240" Width="360" Height="36"
                    Background="#1E808080" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="13" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Brush_Text}" CaretBrush="{DynamicResource Brush_Text}"
                             FontSize="13" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged" ToolTip="Search extensions (Ctrl+F)"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="&#x2715;" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Foreground="#999999" Cursor="Hand"
                            FontSize="11" Padding="4,0" Click="BtnClearSearch_Click"/>
                </Grid>
            </Border>

            <!-- Top-right Actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#x1F9E9; Chrome Web Store" Margin="0,0,8,0"
                        Style="{StaticResource ExtPillBtnStyle}" Click="BtnWebStore_Click"/>
                <Button Content="&#x1F4C2; Extensions Folder" Margin="0,0,8,0"
                        Style="{StaticResource ExtPillBtnStyle}" Click="BtnOpenFolder_Click"/>
                <Button Content="&#x21BB; Reload" Margin="0,0,0,0"
                        Style="{StaticResource ExtPillBtnStyle}" Click="BtnReload_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Rail -->
            <Border Grid.Column="0" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="FILTER" FontSize="10.5" FontWeight="Bold" Foreground="#8894A6" Margin="8,2,0,6"/>
                    <RadioButton x:Name="RbFilterAll" Content="All Extensions" GroupName="ExtFilter" IsChecked="True" Style="{StaticResource ExtFilterRadioStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="RbFilterPinned" Content="Pinned to Header Stack" GroupName="ExtFilter" Style="{StaticResource ExtFilterRadioStyle}" Click="Filter_Changed"/>

                    <TextBlock Text="SORT BY" FontSize="10.5" FontWeight="Bold" Foreground="#8894A6" Margin="8,16,0,6"/>
                    <RadioButton x:Name="RbSortName" Content="Name (A-Z)" GroupName="ExtSort" IsChecked="True" Style="{StaticResource ExtFilterRadioStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="RbSortState" Content="Enabled First" GroupName="ExtSort" Style="{StaticResource ExtFilterRadioStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="RbSortDate" Content="Recently Installed" GroupName="ExtSort" Style="{StaticResource ExtFilterRadioStyle}" Click="Filter_Changed"/>
                </StackPanel>
            </Border>

            <!-- Main List -->
            <Border Grid.Column="2" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <ListBox x:Name="LstExtensions" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ExtRowStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#20FFFFFF"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding IconEmoji}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding FallbackVisibility}"/>
                                            <Image Source="{Binding IconImage}" Width="24" Height="24" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush_Text}"/>
                                            <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VersionText}" FontSize="10.5" Foreground="#94A3B8"/>
                                            </Border>
                                            <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusFg}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#8E9AAE"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding ToggleLabel}" Tag="{Binding}" Click="BtnRowToggle_Click"
                                                Style="{StaticResource ExtPillBtnStyle}" Padding="10,5" Margin="0,0,6,0"/>
                                        <Button Content="{Binding PinLabel}" Tag="{Binding}" Click="BtnRowPin_Click"
                                                Style="{StaticResource ExtPillBtnStyle}" Padding="10,5" Margin="0,0,6,0"/>
                                        <Button Content="&#x1F4C2;" Tag="{Binding}" Click="BtnRowFolder_Click"
                                                Style="{StaticResource ExtPillBtnStyle}" Padding="8,5" Margin="0,0,6,0" ToolTip="Open extension folder"/>
                                        <Button Content="&#x2715;" Tag="{Binding}" Click="BtnRowRemove_Click"
                                                Style="{StaticResource ExtPillBtnStyle}" Padding="8,5" Background="Transparent" BorderThickness="0" ToolTip="Uninstall"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="No extensions match your filter." FontSize="14" Foreground="#8E9AAE"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="TxtNote" DockPanel.Dock="Right" Text="Tip: Restart Horizon if an extension change requires re-mounting."
                       FontSize="11.5" Foreground="#8E9AAE" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtStats" Text="0 extensions" FontSize="12" Foreground="#8E9AAE" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
