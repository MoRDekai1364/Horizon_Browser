<UserControl x:Class="Horizon.Stealth.Views.HomePageView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:controls="clr-namespace:Horizon.Stealth.Controls"

             xmlns:services="clr-namespace:Horizon.Stealth.Services"

             Loaded="HomePageView_Loaded"

             Unloaded="HomePageView_Unloaded">



    <UserControl.Resources>

        <controls:PinIconConverter x:Key="PinIconConverter"/>

        <controls:BookmarkIconConverter x:Key="BookmarkIconConverter"/>

        <controls:FirstLetterConverter x:Key="BookmarkInitialConverter"/>



        <ItemsPanelTemplate x:Key="PuzzleItemsPanel">

            <controls:PuzzlePanel Gap="14" HorizontalAlignment="Center"/>

        </ItemsPanelTemplate>



        <ItemsPanelTemplate x:Key="RowsItemsPanel">

            <controls:RowsPanel/>

        </ItemsPanelTemplate>



        <ItemsPanelTemplate x:Key="BlockItemsPanel">

            <controls:AutoGridPanel/>

        </ItemsPanelTemplate>



        <Style x:Key="PuzzleGroupItemStyle" TargetType="GroupItem">

            <EventSetter Event="Loaded" Handler="GroupItem_Loaded"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="GroupItem">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <ContentPresenter x:Name="GroupHeaderHost" Grid.Row="0" HorizontalAlignment="Center"/>

                            <Border x:Name="GroupCard" Grid.Row="1" HorizontalAlignment="Center" CornerRadius="18" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"

                                    Padding="8" services:HomeGlass.Exclude="True" MouseLeftButtonUp="FolderCard_Click" MouseRightButtonUp="FolderCard_MouseRightButtonUp">

                                <StackPanel>

                                    <TextBlock x:Name="GroupCount" Visibility="Collapsed" FontSize="12" HorizontalAlignment="Center"

                                               Foreground="{DynamicResource HomeTextBrush}" Opacity="0.4" Margin="0,0,0,4"

                                               Text="{Binding Content.ItemCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0} items}"/>

                                    <Border x:Name="GroupItemsClip" ClipToBounds="True">

                                        <ItemsPresenter x:Name="GroupItemsHost"/>

                                    </Border>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="controls:GroupState.IsCollapsed" Value="True">

                                <Setter TargetName="GroupCount" Property="Visibility" Value="Visible"/>

                            </Trigger>

                            <Trigger Property="controls:GroupState.IsFolder" Value="True">

                                <Setter TargetName="GroupHeaderHost" Property="Grid.Row" Value="2"/>

                                <Setter TargetName="GroupCount" Property="Visibility" Value="Collapsed"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <DataTemplate x:Key="PuzzleHeaderTemplate">

            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource HomeTextBrush}"

                       Opacity="0.55" HorizontalAlignment="Center" Margin="0,10,0,2"

                       Cursor="Hand" Background="Transparent" MouseLeftButtonUp="GroupHeader_Click"/>

        </DataTemplate>



        <!-- Shared text brush: keeps favorites text color in sync with the search bar text color -->

        <SolidColorBrush x:Key="HomeTextBrush" Color="White"/>

        <!-- Shared accent brush: updated every time the wallpaper-derived pill color changes,

             so the context menu (and anything else using DynamicResource) re-tints with it. -->

        <SolidColorBrush x:Key="HomeAccentBrush" Color="#8C000000"/>

        <RadialGradientBrush x:Key="HomeTileFadeBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">

            <GradientStop Color="#99000000" Offset="0.0"/>

            <GradientStop Color="#40555555" Offset="0.55"/>

            <GradientStop Color="#00555555" Offset="1.0"/>

        </RadialGradientBrush>



        <LinearGradientBrush x:Key="SharedSearchBgBrush" StartPoint="0,0" EndPoint="1,1">

            <GradientStop Color="#D91A1A1A" Offset="0.0"/>

            <GradientStop Color="#D91A1A1A" Offset="0.68"/>

            <GradientStop Color="#B71A1A1A" Offset="1.0"/>

        </LinearGradientBrush>

        <SolidColorBrush x:Key="SharedSearchBorderBrush" Color="#33FFFFFF"/>



        <Style TargetType="ContextMenu">

            <EventSetter Event="Opened" Handler="ContextMenu_Opened"/>

            <Setter Property="Background" Value="{DynamicResource SharedSearchBgBrush}"/>

            <Setter Property="BorderBrush" Value="{DynamicResource SharedSearchBorderBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ContextMenu">

                        <Grid>

                            <Border CornerRadius="24" ClipToBounds="True">

                                <Grid x:Name="GlassHost" Visibility="Collapsed">

                                    <Border x:Name="WallLayer" RenderTransformOrigin="0.5,0.5">

                                        <Border.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Border.RenderTransform>

                                        <Border.Effect><BlurEffect Radius="32" KernelType="Gaussian" RenderingBias="Performance"/></Border.Effect>

                                    </Border>

                                    <Border x:Name="TintLayer" Background="{TemplateBinding Background}"/>

                                </Grid>

                            </Border>

                            <Border x:Name="CtxMenuBg" BorderBrush="{TemplateBinding BorderBrush}"

                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="4">

                                <Border.OpacityMask>

                                    <VisualBrush Stretch="None">

                                        <VisualBrush.Visual>

                                            <Border Width="{Binding ActualWidth, ElementName=CtxMenuBg}"

                                                    Height="{Binding ActualHeight, ElementName=CtxMenuBg}"

                                                    CornerRadius="24"

                                                    Background="Black">

                                                <Border.Effect>

                                                    <BlurEffect Radius="4" KernelType="Gaussian" RenderingBias="Performance"/>

                                                </Border.Effect>

                                            </Border>

                                        </VisualBrush.Visual>

                                    </VisualBrush>

                                </Border.OpacityMask>

                                <ItemsPresenter/>

                            </Border>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style TargetType="MenuItem">

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Padding" Value="10,6"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="MenuItem">

                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">

                            <Grid IsHitTestVisible="True">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Grid.Column="0"/>

                                <TextBlock x:Name="Arrow" Text="&#x25B6;" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" Grid.Column="1" Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" PopupAnimation="Fade" HorizontalOffset="4" Opened="Submenu_Opened">

                                    <Grid>

                                        <Border CornerRadius="24" ClipToBounds="True">

                                            <Grid x:Name="GlassHost" Visibility="Collapsed">

                                                <Border x:Name="WallLayer" RenderTransformOrigin="0.5,0.5">

                                                    <Border.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Border.RenderTransform>

                                                    <Border.Effect><BlurEffect Radius="32" KernelType="Gaussian" RenderingBias="Performance"/></Border.Effect>

                                                </Border>

                                                <Border x:Name="TintLayer" Background="{DynamicResource SharedSearchBgBrush}"/>

                                            </Grid>

                                        </Border>

                                        <Border x:Name="SubMenuBg" BorderBrush="{DynamicResource SharedSearchBorderBrush}" BorderThickness="1" CornerRadius="24" Padding="4">

                                            <Border.OpacityMask>

                                                <VisualBrush Stretch="None">

                                                    <VisualBrush.Visual>

                                                        <Border Width="{Binding ActualWidth, ElementName=SubMenuBg}"

                                                                Height="{Binding ActualHeight, ElementName=SubMenuBg}"

                                                                CornerRadius="24"

                                                                Background="Black">

                                                            <Border.Effect>

                                                                <BlurEffect Radius="4" KernelType="Gaussian" RenderingBias="Performance"/>

                                                            </Border.Effect>

                                                        </Border>

                                                    </VisualBrush.Visual>

                                                </VisualBrush>

                                            </Border.OpacityMask>

                                            <ItemsPresenter/>

                                        </Border>

                                    </Grid>

                                </Popup>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="Role" Value="SubmenuHeader">

                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>

                            </Trigger>

                            <Trigger Property="Role" Value="TopLevelHeader">

                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource HomeAccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity" Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="PillButtonStyle" TargetType="Button">

            <Setter Property="Height" Value="40"/>

            <Setter Property="Padding" Value="18,0"/>

            <Setter Property="Background" Value="#B3202020"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="BorderBrush" Value="#33FFFFFF"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Grid>

                            <Border x:Name="PillBorder"

                                    Background="{TemplateBinding Background}"

                                    BorderBrush="{TemplateBinding BorderBrush}"

                                    BorderThickness="{TemplateBinding BorderThickness}"

                                    CornerRadius="20">

                            </Border>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="PillBorder" Property="Background" Value="#CC202020"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="MediaButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="46"/>

            <Setter Property="Height" Value="46"/>

            <Setter Property="Margin" Value="0,0,8,0"/>

            <Setter Property="Background" Value="#B3202020"/>

            <Setter Property="Foreground" Value="White"/>

            <Setter Property="BorderBrush" Value="#33FFFFFF"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="RenderTransform">

                <Setter.Value>

                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Grid>

                            <Border x:Name="PillBorder"

                                    Background="{TemplateBinding Background}"

                                    BorderBrush="{TemplateBinding BorderBrush}"

                                    BorderThickness="{TemplateBinding BorderThickness}"

                                    CornerRadius="23">

                            </Border>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="PillBorder" Property="Background" Value="#CC202020"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Trigger.EnterActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.18">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseOut"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.18">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseOut"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.EnterActions>

                    <Trigger.ExitActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseIn"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseIn"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.ExitActions>

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="InteractiveItemStyle" TargetType="StackPanel">

            <Setter Property="Width" Value="115"/>

            <Setter Property="Margin" Value="8,8"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Setter Property="RenderTransform">

                <Setter.Value>

                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Trigger.EnterActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.18">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseOut"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.18">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseOut"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.EnterActions>

                    <Trigger.ExitActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseIn"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15">

                                    <DoubleAnimation.EasingFunction>

                                        <QuadraticEase EasingMode="EaseIn"/>

                                    </DoubleAnimation.EasingFunction>

                                </DoubleAnimation>

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.ExitActions>

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="HomeScrollBarThumb" TargetType="Thumb">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Thumb">

                        <Border CornerRadius="6" Background="{DynamicResource HomeAccentBrush}"/>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="HomeScrollBarStyle" TargetType="ScrollBar">

            <EventSetter Event="ScrollBar.Scroll" Handler="HomeScrollBar_Scroll"/>

            <Setter Property="Width" Value="8"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid>

                            <Border CornerRadius="4" Background="#14FFFFFF" Width="8" HorizontalAlignment="Center"/>

                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">

                                <Track.Thumb>

                                    <Thumb Style="{StaticResource HomeScrollBarThumb}" Width="8" MinHeight="24"/>

                                </Track.Thumb>

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style TargetType="ScrollViewer" x:Key="HomeScrollViewerStyle">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollViewer">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"/>

                            <ScrollBar Grid.Column="1" Style="{StaticResource HomeScrollBarStyle}"

                                       Value="{TemplateBinding VerticalOffset}"

                                       Maximum="{TemplateBinding ScrollableHeight}"

                                       ViewportSize="{TemplateBinding ViewportHeight}"

                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Pill-shaped ComboBox (search engine switcher). Shape only - matches the search bar's

             corner radius / pill silhouette. Colors are left as whatever is set on the control. -->

        <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">

            <Setter Property="Height" Value="40"/>

            <Setter Property="Padding" Value="14,0,28,0"/>

            <Setter Property="ItemContainerStyle">

                <Setter.Value>

                    <Style TargetType="ComboBoxItem">

                        <Setter Property="Foreground" Value="White"/>

                        <Setter Property="Background" Value="Transparent"/>

                        <Setter Property="Padding" Value="10,6"/>

                        <Style.Triggers>

                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter Property="Background" Value="#33FFFFFF"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton x:Name="PART_Toggle"

                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"

                                          Background="{TemplateBinding Background}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"

                                          Focusable="False" ClickMode="Press">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Grid>

                                            <Border x:Name="PillBorder"

                                                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"

                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"

                                                    BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"

                                                    CornerRadius="20">

                                            </Border>

                                        </Grid>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"

                                               Content="{TemplateBinding SelectionBoxItem}"

                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"

                                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                                               TextElement.Foreground="{TemplateBinding Foreground}"

                                               VerticalAlignment="Center" HorizontalAlignment="Stretch"

                                               Margin="{TemplateBinding Padding}"/>

                            <Path Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"

                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"

                                  IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"

                                   AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade"

                                   Width="180">

                                <Border Background="#E01C1C1C" BorderBrush="#26FFFFFF" BorderThickness="1"

                                        CornerRadius="12" Padding="4" MaxHeight="240">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>



    <Grid x:Name="RootHomeGrid" PreviewMouseLeftButtonDown="RootHomeGrid_PreviewMouseLeftButtonDown"

          RenderOptions.BitmapScalingMode="HighQuality">

        <Grid.ContextMenu>

            <ContextMenu>

                <MenuItem Header="Add new favorite" Click="MenuAddFavorite_Click"/>

                <MenuItem Header="Add new bookmark" Click="MenuAddBookmark_Click"/>

                <Separator Background="#26FFFFFF" Margin="0,4"/>

                <MenuItem Header="Enter workspace edit mode // reorder widgets" Click="MenuEnterEditMode_Click"/>

            </ContextMenu>

        </Grid.ContextMenu>

        <Grid.Background>

            <ImageBrush x:Name="BgImageBrush" Stretch="UniformToFill" Opacity="1"

                        RenderOptions.BitmapScalingMode="HighQuality"/>

        </Grid.Background>



        <MediaElement x:Name="BgVideoElement" Stretch="UniformToFill"

                      LoadedBehavior="Manual" UnloadedBehavior="Manual"

                      Visibility="Collapsed"/>



        <Grid Margin="0">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>



            <StackPanel x:Name="PnlBottomRightButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Panel.ZIndex="10">



                <Border x:Name="PnlVpnAdBlock" Tag="VpnAdBlock" Background="#4D141822" CornerRadius="13" BorderBrush="#35FFFFFF" BorderThickness="1"

                        Cursor="Hand" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,0,14,0" Height="26" VerticalAlignment="Center"

                        RenderTransformOrigin="0.5,0.5" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove" MouseLeftButtonUp="WidgetVpnAdBlock_Click">

                    <Border.RenderTransform>

                        <TransformGroup>

                            <ScaleTransform x:Name="VpnAdBlockScale" ScaleX="1.0" ScaleY="1.0"/>

                            <TranslateTransform x:Name="VpnAdBlockTrans" X="0" Y="0"/>

                        </TransformGroup>

                    </Border.RenderTransform>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                        <TextBlock x:Name="TblVpnAdBlockStatus" Text="VPN off" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBlock x:Name="TblVpnAdBlockCountry" Text="" FontSize="9" Foreground="#CCC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"/>

                        <TextBlock x:Name="TblVpnAdBlockSpeed" Text="" FontSize="9" Foreground="#CCC" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"/>

                    </StackPanel>

                </Border>



                <Border x:Name="PnlBatteryPill" Width="84" Height="26"

                        VerticalAlignment="Center" Margin="0,0,8,0"

                        ClipToBounds="True" Cursor="Hand"

                        Background="#4D141822" CornerRadius="13" BorderBrush="#35FFFFFF" BorderThickness="1"

                        MouseLeftButtonUp="PnlBatteryPill_Click"

                        MouseRightButtonUp="PnlBatteryPill_Click">

                    <Grid>

                        <!-- Sleek bottom progress bar indicator (2.5px) -->

                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="2.5" Margin="8,0,8,2" CornerRadius="1.25" Background="#26FFFFFF" IsHitTestVisible="False">

                            <Border x:Name="BatteryPillFill"

                                    HorizontalAlignment="Left" VerticalAlignment="Stretch"

                                    CornerRadius="1.25" Width="0"/>

                        </Border>

                        <!-- Battery text with optional status dot -->

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1">

                            <Border x:Name="BatteryPillDot" Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                            <TextBlock x:Name="TxtBatteryPill" Text="&#x1F50B; --%"

                                       Foreground="#EAEAEA" FontSize="11" FontWeight="SemiBold"

                                       HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock.Effect>

                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.85" RenderingBias="Performance"/>

                                </TextBlock.Effect>

                            </TextBlock>

                        </StackPanel>

                    </Grid>

                </Border>





                <Button x:Name="BtnChangeWallpaper" Height="26"

                        HorizontalAlignment="Center" VerticalAlignment="Center"

                        Click="BtnChangeWallpaper_Click" BorderThickness="0" Cursor="Hand"

                        Background="Transparent" Padding="0" Margin="0,0,8,0">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <ContentPresenter/>

                        </ControlTemplate>

                    </Button.Template>

                    <Border x:Name="BtnChangeWallpaperBg" Background="#4D141822" CornerRadius="13"

                            BorderBrush="#35FFFFFF" BorderThickness="1" Height="26" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,14,0">

                            <TextBlock x:Name="TxtChangeWallpaper" Text="Change Wallpaper" FontSize="11" FontWeight="SemiBold" Foreground="White"

                                       VerticalAlignment="Center">

                                <TextBlock.Effect>

                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.85" RenderingBias="Performance"/>

                                </TextBlock.Effect>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                </Button>



                <Button x:Name="BtnHomeSettings" Height="26" Width="36"

                        HorizontalAlignment="Center" VerticalAlignment="Center"

                        Click="BtnHomeSettings_Click" BorderThickness="0" Cursor="Hand"

                        Background="Transparent" Padding="0" ToolTip="Homepage Settings">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <ContentPresenter/>

                        </ControlTemplate>

                    </Button.Template>

                    <Border x:Name="BtnHomeSettingsBg" Background="#4D141822" CornerRadius="13"

                            BorderBrush="#35FFFFFF" BorderThickness="1" Height="26" Width="36" VerticalAlignment="Center">

                        <TextBlock x:Name="BtnHomeSettingsIcon" Text="&#x2699;" FontSize="14" Foreground="White"

                                   HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock.Effect>

                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.85" RenderingBias="Performance"/>

                            </TextBlock.Effect>

                        </TextBlock>

                    </Border>

                </Button>

            </StackPanel>



            <!-- Bottom Left Navigation Buttons: Widgets & Utilities Hub -->

            <StackPanel x:Name="PnlBottomLeftButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,16" Panel.ZIndex="10">

                <Button x:Name="BtnBottomWidgets" Height="26"

                        HorizontalAlignment="Center" VerticalAlignment="Center"

                        Click="BtnBottomWidgets_Click" BorderThickness="0" Cursor="Hand"

                        Background="Transparent" Padding="0" Margin="0,0,8,0" ToolTip="Widgets Board">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <ContentPresenter/>

                        </ControlTemplate>

                    </Button.Template>

                    <Border x:Name="BtnBottomWidgetsBg" Background="#4D141822" CornerRadius="13"

                            BorderBrush="#35FFFFFF" BorderThickness="1" Height="26" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,14,0">

                            <TextBlock Text="&#x229E; Widgets" FontSize="11" FontWeight="SemiBold" Foreground="White"

                                       VerticalAlignment="Center">

                                <TextBlock.Effect>

                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.85" RenderingBias="Performance"/>

                                </TextBlock.Effect>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                </Button>



                <Button x:Name="BtnBottomUtilities" Height="26"

                        HorizontalAlignment="Center" VerticalAlignment="Center"

                        Click="BtnBottomUtilities_Click" BorderThickness="0" Cursor="Hand"

                        Background="Transparent" Padding="0" Margin="0,0,8,0" ToolTip="Horizon Utilities Hub">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <ContentPresenter/>

                        </ControlTemplate>

                    </Button.Template>

                    <Border x:Name="BtnBottomUtilitiesBg" Background="#4D141822" CornerRadius="13"

                            BorderBrush="#35FFFFFF" BorderThickness="1" Height="26" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,14,0">

                            <TextBlock Text="&#x26A1; Utilities" FontSize="11" FontWeight="SemiBold" Foreground="White"

                                       VerticalAlignment="Center">

                                <TextBlock.Effect>

                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.85" RenderingBias="Performance"/>

                                </TextBlock.Effect>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                </Button>

            </StackPanel>



            <!-- Overlapping centered layout: Left section sits anchored to the top-left, while the search area spans the entire width with horizontal centering so it remains permanently centered against the true viewport regardless of left panel dimensions or widget visibility. -->

            <Grid x:Name="GridHomeLayout" Grid.Row="1" AllowDrop="True" DragOver="GridHomeLayout_DragOver" Drop="GridHomeLayout_Drop">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition x:Name="ColClockWeather" Width="Auto"/>

                    <ColumnDefinition x:Name="ColSearchArea" Width="*"/>

                    <ColumnDefinition x:Name="ColRightBalance" Width="Auto"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>

                    <RowDefinition x:Name="RowClockWeather" Height="Auto"/>

                    <RowDefinition x:Name="RowSearchArea" Height="*"/>

                </Grid.RowDefinitions>



            <Border x:Name="ClockWeatherIslandBorder" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"

                    HorizontalAlignment="Left" VerticalAlignment="Top"

                    Margin="30,40,40,0"

                    CornerRadius="{Binding CornerRadius, ElementName=SearchBoxBorder}"

                    Background="Transparent"

                    BorderBrush="Transparent"

                    BorderThickness="{Binding BorderThickness, ElementName=SearchBoxBorder}"

                    IsHitTestVisible="False"

                    Opacity="0.85">

            </Border>

            <Border x:Name="SearchBlurPill" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"

                    HorizontalAlignment="Left" VerticalAlignment="Top"

                    Margin="30,40,40,0"

                    Width="{Binding ActualWidth, ElementName=ClockWeatherIslandBorder}"

                    Height="{Binding ActualHeight, ElementName=ClockWeatherIslandBorder}"

                    CornerRadius="{Binding CornerRadius, ElementName=SearchBoxBorder}"

                    Background="{Binding Background, ElementName=SearchBoxBorder}"

                    BorderBrush="{Binding BorderBrush, ElementName=SearchBoxBorder}"

                    BorderThickness="{Binding BorderThickness, ElementName=SearchBoxBorder}"

                    IsHitTestVisible="False"

                    Opacity="1">

            </Border>

            

            <Border x:Name="ClockWeatherHitOverlay" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"

                    Panel.ZIndex="1000"

                    HorizontalAlignment="Left" VerticalAlignment="Top"

                    Margin="30,40,40,0"

                    Width="{Binding ActualWidth, ElementName=ClockWeatherIslandBorder}"

                    Background="Transparent"

                    BorderBrush="Transparent">

                <Canvas x:Name="PillClickZones" Background="{x:Null}">

                    <Border x:Name="ZoneClockMode" Cursor="Hand" Background="Transparent" 

                            MouseLeftButtonUp="WidgetClockWeather_Click" 

                            PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove" Tag="ClockWeather" />

                    <Border x:Name="ZoneWeatherPopup" Cursor="Hand" Background="Transparent" 

                            MouseLeftButtonUp="WidgetClockWeather_Click" 

                            PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove" Tag="WeatherOverlay" />

                    <Border x:Name="ZoneCalendar" Cursor="Hand" Background="Transparent" 

                            MouseLeftButtonUp="WidgetCalendar_Click" 

                            PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove" Tag="Calendar" />

                    <Border x:Name="ZoneMedia" Cursor="Hand" Background="Transparent" 

                            MouseLeftButtonUp="WidgetMedia_Click" 

                            PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove" Tag="Media" />

                </Canvas>

            </Border>



            <StackPanel x:Name="PnlClockWeather" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,50,40,0">

                <StackPanel.LayoutTransform>

                    <ScaleTransform x:Name="ClockWeatherScale" ScaleX="1.0" ScaleY="1.0"/>

                </StackPanel.LayoutTransform>

                <StackPanel x:Name="PnlClockWeatherSub" Tag="ClockWeather" RenderTransformOrigin="0,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="WidgetClockWeather_Click" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove">

                    <StackPanel.RenderTransform>

                        <TransformGroup>

                            <ScaleTransform x:Name="ClockScale" ScaleX="1.0" ScaleY="1.0"/>

                            <TranslateTransform x:Name="ClockTrans" X="0" Y="0"/>

                        </TransformGroup>

                    </StackPanel.RenderTransform>

                    <TextBlock x:Name="TblClock" FontSize="62" FontWeight="Light" Foreground="White" HorizontalAlignment="Left"/>

                    <TextBlock x:Name="TblWeather" Text="&#x26C5; N/A" FontSize="29" Foreground="#CCC" HorizontalAlignment="Left" Margin="2,6,0,0"/>

                    <TextBlock x:Name="TblWeatherCity" Text="" FontSize="23" Foreground="#888" HorizontalAlignment="Left" Margin="2,2,0,0"/>

                </StackPanel>



                <StackPanel x:Name="PnlCalendar" Tag="Calendar" Margin="0,20,0,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="WidgetCalendar_Click" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove">

                    <StackPanel x:Name="PnlCalendarDate" RenderTransformOrigin="0,0">

                        <StackPanel.RenderTransform>

                            <TransformGroup>

                                <ScaleTransform x:Name="CalendarScale" ScaleX="1.0" ScaleY="1.0"/>

                                <TranslateTransform x:Name="CalendarTrans" X="0" Y="0"/>

                            </TransformGroup>

                        </StackPanel.RenderTransform>

                        <TextBlock x:Name="TblCalendarDate" FontSize="24" Foreground="#AAA" HorizontalAlignment="Left"/>

                    </StackPanel>

                    <StackPanel x:Name="PnlCalendarEvents" RenderTransformOrigin="0,0">

                        <StackPanel.RenderTransform>

                            <TransformGroup>

                                <ScaleTransform x:Name="EventsScale" ScaleX="1.0" ScaleY="1.0"/>

                                <TranslateTransform x:Name="EventsTrans" X="0" Y="0"/>

                            </TransformGroup>

                        </StackPanel.RenderTransform>

                        <TextBlock x:Name="TblCalendarPrev" FontSize="21" Foreground="#777" HorizontalAlignment="Left"

                                   MaxWidth="352" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

                        <TextBlock x:Name="TblCalendarNext" FontSize="21" Foreground="#8fd6a0" HorizontalAlignment="Left"

                                   MaxWidth="352" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>



                <StackPanel x:Name="PnlDownloads" Tag="Downloads" Margin="0,20,0,0" Visibility="Collapsed" RenderTransformOrigin="0,0" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove">

                    <StackPanel.RenderTransform>

                        <TransformGroup>

                            <ScaleTransform x:Name="DownloadsScale" ScaleX="1.0" ScaleY="1.0"/>

                            <TranslateTransform x:Name="DownloadsTrans" X="0" Y="0"/>

                        </TransformGroup>

                    </StackPanel.RenderTransform>

                    <ItemsControl x:Name="IcnDownloads">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Width="352" Margin="0,0,0,8">

                                    <TextBlock Text="{Binding FileName}" Foreground="#DDD" FontSize="18"

                                               TextTrimming="CharacterEllipsis"/>

                                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"

                                                 Margin="0,3,0,0"/>

                                </StackPanel>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>



                <StackPanel x:Name="PnlMedia" Tag="Media" Margin="0,26,0,0" Visibility="Collapsed" RenderTransformOrigin="0,0" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove">

                    <StackPanel.RenderTransform>

                        <TransformGroup>

                            <ScaleTransform x:Name="MediaScale" ScaleX="1.0" ScaleY="1.0"/>

                            <TranslateTransform x:Name="MediaTrans" X="0" Y="0"/>

                        </TransformGroup>

                    </StackPanel.RenderTransform>

                    <Border x:Name="MediaTitleClip" HorizontalAlignment="Left" MaxWidth="352" ClipToBounds="True">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock x:Name="TblMediaTitle" Text="" FontSize="24" Foreground="#DDD" HorizontalAlignment="Left"

                                       TextWrapping="NoWrap" TextTrimming="None" Cursor="Hand"

                                       MouseLeftButtonUp="TblMediaTitle_Click"

                                       SizeChanged="TblMediaTitle_SizeChanged">

                                <TextBlock.RenderTransform>

                                    <TranslateTransform x:Name="MediaTitleTT" X="0"/>

                                </TextBlock.RenderTransform>

                            </TextBlock>

                        </StackPanel>

                    </Border>

                    <TextBlock x:Name="TblMediaArtist" Text="" FontSize="16" Foreground="#999" HorizontalAlignment="Left"

                               MaxWidth="352" TextWrapping="Wrap" TextTrimming="None" Margin="2,4,0,0" Visibility="Collapsed"/>

                    <StackPanel x:Name="PnlMediaButtons" Orientation="Horizontal" Margin="0,12,0,0">

                        <Button x:Name="BtnMediaPrev" Content="&#x23EE;" Style="{StaticResource MediaButtonStyle}" Click="BtnMediaPrev_Click"/>

                        <Button x:Name="BtnMediaPlayPause" Content="&#x25B6;" Padding="2,0,0,0" Style="{StaticResource MediaButtonStyle}" Click="BtnMediaPlayPause_Click"/>

                        <Button x:Name="BtnMediaNext" Content="&#x23ED;" Style="{StaticResource MediaButtonStyle}" Click="BtnMediaNext_Click"/>

                        <Button x:Name="BtnMediaMute" Content="&#x1F50A;" Style="{StaticResource MediaButtonStyle}" Click="BtnMediaMute_Click"/>

                        <Button x:Name="BtnMediaAudioOnly" Content="&#x1F3A7;" Style="{StaticResource MediaButtonStyle}" Margin="0" Click="BtnMediaAudioOnly_Click"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>



            <controls:StackHost x:Name="HomeStack" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"

                                HorizontalAlignment="Right" VerticalAlignment="Top"

                                Margin="0,50,40,0" Visibility="Collapsed"/>

            <!-- Pinned Extensions Rail (Right Column) -->
            <StackPanel x:Name="PnlHomePinnedExtensions" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,50,40,0" Orientation="Vertical"/>



            <!-- Centered search + pins, confined to the middle column so it can never

                 overlap the left/right side columns (e.g. the media widget) regardless

                 of how wide their content gets. -->

            <Grid x:Name="PnlSearchArea" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <Grid x:Name="GridSearchRow" Grid.Row="0" HorizontalAlignment="Center">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Grid x:Name="SwitchSlot" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">

                        <Border x:Name="PnlSearchMode" Margin="0,0,10,0" CornerRadius="18"

                                BorderThickness="0" Background="#CC000000" BorderBrush="#33FFFFFF" VerticalAlignment="Center">

                            <StackPanel x:Name="PnlSearchModeStack" Orientation="Vertical">

                                <Border x:Name="SegModeFavorites" Tag="Favorites" Height="34" CornerRadius="15" Padding="14,0" Cursor="Hand"

                                        Background="Transparent" ToolTip="Favorites" MouseLeftButtonUp="SearchModeSegment_Click">

                                    <TextBlock x:Name="TxtModeFavorites" Text="Favorites" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                </Border>

                                <Border x:Name="SegModeSearch" Tag="Search" Height="34" CornerRadius="15" Padding="14,0" Cursor="Hand"

                                        Background="Transparent" ToolTip="Search" MouseLeftButtonUp="SearchModeSegment_Click">

                                    <TextBlock x:Name="TxtModeSearch" Text="Search" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                </Border>

                                <Border x:Name="SegModeBookmarks" Tag="Bookmarks" Height="34" CornerRadius="15" Padding="14,0" Cursor="Hand"

                                        Background="Transparent" ToolTip="Bookmarks" MouseLeftButtonUp="SearchModeSegment_Click">

                                    <TextBlock x:Name="TxtModeBookmarks" Text="Bookmarks" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                </Border>

                                <Border x:Name="SegModeCalendar" Tag="Calendar" Height="34" CornerRadius="15" Padding="14,0" Cursor="Hand"

                                        Background="Transparent" ToolTip="Calendar" MouseLeftButtonUp="SearchModeSegment_Click" Visibility="Collapsed">



                                    <TextBlock x:Name="TxtModeCalendar" Text="Calendar" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                </Border>



                            </StackPanel>

                        </Border>

                    </Grid>

                    <Border x:Name="SearchBoxBorder" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"

                            Background="{DynamicResource SharedSearchBgBrush}" CornerRadius="24" MaxWidth="900" MinHeight="48" BorderBrush="{DynamicResource SharedSearchBorderBrush}" BorderThickness="0">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="8,8,0,8" VerticalAlignment="Top">

                                <ComboBox x:Name="CmbSearchEngine" Width="120"

                                          DisplayMemberPath="Name" BorderThickness="2"

                                          Background="#CC000000" Foreground="White"

                                          Style="{StaticResource PillComboBoxStyle}"

                                          SelectionChanged="CmbSearchEngine_SelectionChanged"/>

                                <ComboBox x:Name="CmbCategoryFilter" Width="140" Visibility="Collapsed"

                                          BorderThickness="2" Background="#CC000000" Foreground="White"

                                          Style="{StaticResource PillComboBoxStyle}"

                                          SelectionChanged="CmbCategoryFilter_SelectionChanged"/>

                            </Grid>

                            <Grid Grid.Column="1">

                                <TextBlock x:Name="TxtHomeSearchPlaceholder" Text="Search here ..." Foreground="#888"

                                           FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,12,20,12"

                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>

                                <TextBox x:Name="TxtHomeSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource HomeTextBrush}"

                                         CaretBrush="White" FontSize="18" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="12,12,20,12"

                                         MinWidth="30" MaxWidth="740"

                                         TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="140" VerticalScrollBarVisibility="Auto"

                                         KeyDown="TxtHomeSearch_KeyDown" TextChanged="TxtHomeSearch_TextChanged"/>

                            </Grid>

                        </Grid>

                    </Border>

                    <Border x:Name="SearchMirror" Grid.Row="0" Grid.Column="2" IsHitTestVisible="False"

                            Width="{Binding ActualWidth, ElementName=SwitchSlot}"/>

                </Grid>   



                <Grid x:Name="GridFavBookmarksIsland" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center">

                    <Grid.RenderTransform>

                        <TranslateTransform x:Name="TransFavBookmarksIsland" X="0" Y="0"/>

                    </Grid.RenderTransform>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Calendar Island Border: dedicated capsule for the calendar widget in mini mode -->

                    <Border x:Name="CalendarIslandBorder" Grid.Row="0" Grid.RowSpan="2"

                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                            Margin="-15,14,-15,-22"

                            CornerRadius="{Binding CornerRadius, ElementName=SearchBoxBorder}"

                            Background="{Binding Background, ElementName=SearchBoxBorder}"

                            BorderBrush="{Binding BorderBrush, ElementName=SearchBoxBorder}"

                            BorderThickness="{Binding BorderThickness, ElementName=SearchBoxBorder}"

                            Visibility="Collapsed" IsHitTestVisible="False">

                    </Border>



                    <Grid x:Name="PnlCalendarContainer" Grid.Row="0" Grid.RowSpan="2" Margin="0,14,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>



                    <!-- Widget Board Island Border: Windows 11 style dedicated capsule for the widgets board -->

                    <Border x:Name="WidgetBoardIslandBorder" Grid.Row="0" Grid.RowSpan="2"

                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                            Margin="-15,14,-15,-22"

                            CornerRadius="{Binding CornerRadius, ElementName=SearchBoxBorder}"

                            Background="{Binding Background, ElementName=SearchBoxBorder}"

                            BorderBrush="{Binding BorderBrush, ElementName=SearchBoxBorder}"

                            BorderThickness="{Binding BorderThickness, ElementName=SearchBoxBorder}"

                            Visibility="Collapsed" IsHitTestVisible="False">

                    </Border>



                    <Grid x:Name="PnlWidgetBoardContainer" Grid.Row="0" Grid.RowSpan="2" Margin="0,14,0,0" Visibility="Collapsed" HorizontalAlignment="Center">

                        <ScrollViewer x:Name="ScvWidgetBoard" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Center" Style="{StaticResource HomeScrollViewerStyle}">

                            <Grid x:Name="GridWidgetBoard" Margin="4,2,4,4" HorizontalAlignment="Center"/>

                        </ScrollViewer>

                    </Grid>



                <!-- Favorites Island Border: dedicated capsule for the favorites widget -->





                <Border x:Name="FavoritesIslandBorder" Grid.Row="0"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,16" Padding="28,18,28,24"
                        MinWidth="420"
                        CornerRadius="28"
                        Background="{Binding Background, ElementName=SearchBoxBorder}"
                        BorderBrush="{Binding BorderBrush, ElementName=SearchBoxBorder}"
                        BorderThickness="{Binding BorderThickness, ElementName=SearchBoxBorder}">





                    <StackPanel x:Name="PnlFavoritesContainer" Tag="Favorites" HorizontalAlignment="Center" Margin="0" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove">

                    <ScrollViewer x:Name="ScvFavorites" MaxHeight="560" PreviewMouseWheel="Scroller_PreviewMouseWheel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Center" Style="{StaticResource HomeScrollViewerStyle}">

                    <ItemsControl x:Name="IcnColumns" HorizontalAlignment="Center" ItemsPanel="{StaticResource BlockItemsPanel}">

                        <ItemsControl.GroupStyle>

                            <GroupStyle ContainerStyle="{StaticResource PuzzleGroupItemStyle}" Panel="{StaticResource PuzzleItemsPanel}">

                                <GroupStyle.HeaderTemplate>

                                    <DataTemplate>

                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource HomeTextBrush}"

                                                   Opacity="0.55" HorizontalAlignment="Center" Margin="0,10,0,2"

                                                   Cursor="Hand" Background="Transparent" MouseLeftButtonUp="GroupHeader_Click">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text" Value="{Binding Name}"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Name}" Value="">

                                                            <Setter Property="Text" Value="GENERAL"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </DataTemplate>

                                </GroupStyle.HeaderTemplate>

                            </GroupStyle>

                        </ItemsControl.GroupStyle>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Style="{StaticResource InteractiveItemStyle}" MouseLeftButtonUp="Pin_Click" MouseRightButtonUp="Pin_MouseRightButtonUp" PreviewMouseLeftButtonDown="Pin_PreviewMouseLeftButtonDown" PreviewMouseMove="Pin_PreviewMouseMove">

                                    <Grid HorizontalAlignment="Center" Width="77" Height="77">

                                        <Border Width="77" Height="77" CornerRadius="19" Background="{DynamicResource HomeAccentBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">

                                            <Grid>

                                                <Image Source="{Binding Converter={StaticResource PinIconConverter}, IsAsync=True}" Width="48" Height="48" Stretch="Uniform"

                                                       HorizontalAlignment="Center" VerticalAlignment="Center">

                                                    <Image.Style>

                                                        <Style TargetType="Image">

                                                            <Setter Property="Visibility" Value="Collapsed"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IconEmoji}" Value="">

                                                                    <Setter Property="Visibility" Value="Visible"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </Image.Style>

                                                </Image>

                                                <TextBlock Text="{Binding IconEmoji}" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center">

                                                    <TextBlock.Style>

                                                        <Style TargetType="TextBlock">

                                                            <Setter Property="Visibility" Value="Visible"/>

                                                            <Style.Triggers>

                                                                <DataTrigger Binding="{Binding IconEmoji}" Value="">

                                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                                </DataTrigger>

                                                            </Style.Triggers>

                                                        </Style>

                                                    </TextBlock.Style>

                                                </TextBlock>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource HomeTextBrush}" FontSize="18" HorizontalAlignment="Center"

                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    </ScrollViewer>

                    <TextBlock x:Name="TxtFavoritesEmpty" Text="No favorites yet. Add favorite websites to display them here." Foreground="{DynamicResource HomeTextBrush}" Opacity="0.85" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="24,24" Visibility="Collapsed"/>

                    <Button x:Name="BtnToggleFavorites" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Margin="0,12,24,0" Click="BtnToggleFavorites_Click" Visibility="Collapsed">

                        <TextBlock x:Name="TxtToggleFavorites" Text="&#x25BC; Show more" FontSize="14" FontWeight="Bold"/>

                    </Button>

                </StackPanel>

            </Border>



                <!-- Bookmarks Island Border: dedicated capsule for the bookmarks widget -->





                <Border x:Name="BookmarksIslandBorder" Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,16" Padding="28,18,28,24"
                        MinWidth="420"
                        CornerRadius="28"
                        Background="{Binding Background, ElementName=SearchBoxBorder}"
                        BorderBrush="{Binding BorderBrush, ElementName=SearchBoxBorder}"
                        BorderThickness="{Binding BorderThickness, ElementName=SearchBoxBorder}">





                    <StackPanel x:Name="PnlBookmarksContainer" Tag="Bookmarks" HorizontalAlignment="Center" Margin="0" PreviewMouseLeftButtonDown="Widget_PreviewMouseLeftButtonDown" MouseMove="Widget_MouseMove">

                    <ScrollViewer x:Name="ScvBookmarks" MaxHeight="560" PreviewMouseWheel="Scroller_PreviewMouseWheel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Center" Style="{StaticResource HomeScrollViewerStyle}">

                    <ItemsControl x:Name="IcnBookmarks" HorizontalAlignment="Center" ItemsPanel="{StaticResource BlockItemsPanel}">

                        <ItemsControl.GroupStyle>

                            <GroupStyle ContainerStyle="{StaticResource PuzzleGroupItemStyle}" Panel="{StaticResource PuzzleItemsPanel}"

                                        HeaderTemplate="{StaticResource PuzzleHeaderTemplate}"/>

                        </ItemsControl.GroupStyle>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Style="{StaticResource InteractiveItemStyle}" MouseLeftButtonUp="Bookmark_Click" MouseRightButtonUp="Bookmark_MouseRightButtonUp" PreviewMouseLeftButtonDown="Bm_PreviewMouseLeftButtonDown" PreviewMouseMove="Bm_PreviewMouseMove">

                                    <Grid HorizontalAlignment="Center" Width="77" Height="77">

                                        <Border Width="77" Height="77" CornerRadius="19" Background="{DynamicResource HomeAccentBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">

                                            <Grid>

                                                <Image Source="{Binding AsPin, Converter={StaticResource PinIconConverter}, IsAsync=True}" Width="48" Height="48" Stretch="Uniform"

                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Grid>

                                        </Border>

