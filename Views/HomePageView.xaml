                                    <TextBlock Text="COMM-LINK // " Foreground="#FF9900" FontSize="14" FontWeight="Black" VerticalAlignment="Center"/>

                                    <TextBox x:Name="TxtLcarsSearch" Grid.Column="1" Background="Transparent" Foreground="#FFCC00" CaretBrush="#FFCC00"

                                             FontSize="16" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center" KeyDown="LcarsSearch_KeyDown"/>

                                </Grid>

                            </Border>



                            <!-- LCARS Tactical Pill Array -->

                            <Border Grid.Row="1" Background="#0A0A14" CornerRadius="8" Padding="14">

                                <StackPanel>

                                    <TextBlock Text="SUBSPACE RELAYS // QUICK SYSTEMS" Foreground="#FFCC00" FontSize="12" FontWeight="Black" Margin="0,0,0,10"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                                        <WrapPanel x:Name="PnlLcarsPills" Orientation="Horizontal"/>

                                    </ScrollViewer>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Grid>

                </Grid>

            </Grid>



            <!-- ====================================================================== -->

            <!-- THEME 8: ZEN GARDEN (Biophilic Soft Claymorphism & Mindfulness)         -->

            <!-- ====================================================================== -->

            <Grid x:Name="ThemeHost_ZenGarden" Grid.Row="1" Visibility="Collapsed" Background="#171A18">

                <Grid Margin="40,30">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <!-- Breathing Mindful Sundial -->

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">

                        <TextBlock x:Name="TxtZenClock" Text="10:48" FontSize="52" FontWeight="Light" Foreground="#DDE5E0" HorizontalAlignment="Center"/>

                        <TextBlock x:Name="TxtZenBreath" Text="Soft morning light in Sofia · 7°C · Breathe deeply"

                                   FontSize="15" Foreground="#8EA898" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    </StackPanel>



                    <!-- Pebble-Pond Indented Search -->

                    <Border Grid.Row="1" HorizontalAlignment="Center" Width="520" Height="52"

                            Background="#222724" BorderBrush="#353E39" BorderThickness="1.5" CornerRadius="26" Padding="20,0" Margin="0,0,0,30">

                        <Grid VerticalAlignment="Center">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#x1F33F;" FontSize="18" Foreground="#8EA898" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBox x:Name="TxtZenSearch" Grid.Column="1" Background="Transparent" Foreground="#E2EBE6" CaretBrush="#8EA898"

                                     FontSize="16" BorderThickness="0" VerticalAlignment="Center" KeyDown="ZenSearch_KeyDown"/>

                        </Grid>

                    </Border>



                    <!-- River Stone Shortcuts -->

                    <StackPanel Grid.Row="2" MaxWidth="760" HorizontalAlignment="Center">

                        <TextBlock Text="RIVER STONES" FontSize="11" FontWeight="Bold" Foreground="#5A6E62" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <WrapPanel x:Name="PnlZenStones" HorizontalAlignment="Center" Orientation="Horizontal"/>

                    </StackPanel>

                </Grid>

            </Grid>



            <!-- ====================================================================== -->

            <!-- THEME 9: WIN95 RETRODESK (1995 Desktop Nostalgia & Brutalism)           -->

            <!-- ====================================================================== -->

            <Grid x:Name="ThemeHost_Win95RetroDesk" Grid.Row="1" Visibility="Collapsed" Background="#008080">

                <Grid Margin="24">

                    <!-- Internet Search Wizard Window (Center) -->

                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"

                            Background="#C0C0C0" BorderBrush="#FFFFFF" BorderThickness="2,2,0,0">

                        <Border BorderBrush="#808080" BorderThickness="0,0,2,2">

                            <StackPanel>

                                <!-- Title Bar -->

                                <Border Background="#000080" Height="24" Padding="6,2">

                                    <Grid>

                                        <TextBlock Text="Internet Search Wizard - [Horizon 95]" Foreground="#FFFFFF" FontWeight="Bold" FontFamily="MS Sans Serif, Tahoma" FontSize="12" VerticalAlignment="Center"/>

                                        <Button Content="&#x2715;" Width="16" Height="16" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold"

                                                Background="#C0C0C0" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0"/>

                                    </Grid>

                                </Border>



                                <!-- Dialog Content -->

                                <StackPanel Margin="16,14">

                                    <TextBlock Text="Type the web page or search query you wish to locate:" Foreground="#000000" FontFamily="MS Sans Serif, Tahoma" FontSize="12" Margin="0,0,0,8"/>

                                    <Border Background="#FFFFFF" BorderBrush="#808080" BorderThickness="2,2,0,0" Height="28">

                                        <Border BorderBrush="#DFDFDF" BorderThickness="0,0,1,1">

                                            <TextBox x:Name="TxtWin95Search" Background="Transparent" Foreground="#000000" CaretBrush="#000000"

                                                     FontFamily="MS Sans Serif, Tahoma" FontSize="13" BorderThickness="0" Margin="4,2" KeyDown="Win95Search_KeyDown"/>

                                        </Border>

                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">

                                        <Button Content="Find Now!" Click="BtnWin95Search_Click" Width="84" Height="24"

                                                Background="#C0C0C0" BorderBrush="#FFFFFF" BorderThickness="2,2,0,0"

                                                FontFamily="MS Sans Serif, Tahoma" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"/>

                                        <Button Content="Cancel" Width="70" Height="24"

                                                Background="#C0C0C0" BorderBrush="#FFFFFF" BorderThickness="2,2,0,0"

                                                FontFamily="MS Sans Serif, Tahoma" FontSize="11"/>

                                    </StackPanel>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </Border>



                    <!-- Desktop Shortcut Icons (Top Left) -->

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">

                        <WrapPanel x:Name="PnlWin95Icons" Orientation="Vertical" MaxHeight="500"/>

                    </StackPanel>



                    <!-- System Tray (Bottom Right) -->

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#C0C0C0"

                            BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="8,4">

                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#x1F50A;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                <TextBlock Text="&#x1F50B;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtWin95Clock" Text="10:48 AM" FontFamily="MS Sans Serif, Tahoma" FontSize="11" Foreground="#000000" VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Border>

                </Grid>

            </Grid>

        </Grid>



        <!-- Bottom fade: blends the homepage content into the page/tab area below it -->

        <Border VerticalAlignment="Bottom" Height="140" IsHitTestVisible="False">

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                    <GradientStop Color="#00000000" Offset="0"/>

                    <GradientStop Color="#66000000" Offset="1"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>



        <!-- Audio visualizer: glow bleeding in from all four edges, colors cross-fading -->

        <Grid x:Name="HomeVizCanvas" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True">

            <Rectangle x:Name="VizCornerTL" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0" IsHitTestVisible="False">

                

            </Rectangle>

            <Rectangle x:Name="VizCornerBL" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0,1" IsHitTestVisible="False">

                

            </Rectangle>

            <Rectangle x:Name="VizCornerTR" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="1,0" IsHitTestVisible="False">

                

            </Rectangle>

            <Rectangle x:Name="VizCornerBR" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="1,1" IsHitTestVisible="False">

                

            </Rectangle>

        </Grid>



        <Border x:Name="DropIndicatorBorder" BorderBrush="#44AAFF" BorderThickness="2" Background="#1A44AAFF"

                CornerRadius="16" Visibility="Collapsed" IsHitTestVisible="False"

                HorizontalAlignment="Left" VerticalAlignment="Top"/>



        <Grid x:Name="EditModeOverlay" Background="#59000000" Visibility="Collapsed"

              AllowDrop="True" DragOver="EditModeOverlay_DragOver" Drop="EditModeOverlay_Drop">

            <Border VerticalAlignment="Top" Background="#E0141414" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="20,12">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="EDIT MODE //" Foreground="#44AAFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <ComboBox x:Name="CmbLayoutSet" Width="180" Height="32" DisplayMemberPath="Name"

                                  Style="{StaticResource PillComboBoxStyle}" SelectionChanged="CmbLayoutSet_SelectionChanged"/>

                        <Button x:Name="BtnNewLayoutSet" Content="+" Width="32" Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Padding="0" Click="BtnNewLayoutSet_Click"/>

                        <Button x:Name="BtnDeleteLayoutSet" Content="&#x1F5D1;" Width="36" Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Padding="0" Click="BtnDeleteLayoutSet_Click"/>

                    </StackPanel>



                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <RadioButton x:Name="RbEditNormal" Content="Normal Layout" Foreground="White" FontWeight="Bold" GroupName="EditStateGroup" IsChecked="True" Margin="0,0,16,0" Checked="EditState_Checked"/>

                        <RadioButton x:Name="RbEditInactivity" Content="Inactivity Layout" Foreground="White" FontWeight="Bold" GroupName="EditStateGroup" Checked="EditState_Checked"/>

                    </StackPanel>



                    <Button x:Name="BtnExitEditMode" Grid.Column="2" Content="SAVE &amp; EXIT" Height="32" Width="120"

                            Style="{StaticResource PillButtonStyle}" Background="#2266AA" Click="BtnExitEditMode_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>