<Window x:Class="Horizon.Stealth.Views.HomePageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Homepage Settings" Width="780" Height="640" MinWidth="740" MinHeight="520" MaxWidth="1100" MaxHeight="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush_DeepBackground}"
        WindowStyle="None" BorderBrush="{DynamicResource Brush_Accent}" BorderThickness="1"
        PreviewKeyDown="HomePageSettingsWindow_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Focusable="False">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal" Background="Transparent"/>
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="Content" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="GlassBackdropHost" IsHitTestVisible="False"/>

        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

                <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="HOMEPAGE SETTINGS //" Foreground="{StaticResource Brush_Accent}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x2715;" Click="BtnCloseHomeSettings_Click"
                    Width="32" Height="32" Background="Transparent" Foreground="#DDD"
                    BorderThickness="0" FontSize="14" Cursor="Hand" ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <TabControl x:Name="TabsHomeSettings" Grid.Row="1" Margin="0,15" Background="Transparent" BorderThickness="0">
            <!-- ====================================================================== -->
            <!-- TAB: THEMES & WORLDS (9 Visual Launchers)                               -->
            <!-- ====================================================================== -->
            <TabItem Header="THEMES &amp; WORLDS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="14">
                        <TextBlock Text="HOMEPAGE VISUAL WORLDS &amp; LAUNCHERS" Foreground="{DynamicResource Brush_Accent}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Transform your new tab experience into completely different visual environments, layouts, and operating philosophies." Foreground="#999999" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <WrapPanel x:Name="PnlThemeGallery" Orientation="Horizontal" Margin="0,0,0,14">
                            <!-- Theme 1: Horizon Flow (Default) -->
                            <Border x:Name="CardTheme_Default" Width="220" Height="140" Background="#18FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1.5" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="Default">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F305;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Horizon Flow" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Default frosted Aero Glass desktop with multi-column widgets and deep wallpaper immersion." Foreground="#AAAAAA" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_Default" Grid.Row="2" Text="ACTIVE" Foreground="#00FF66" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 2: CyberTerminal -->
                            <Border x:Name="CardTheme_CyberTerminal" Width="220" Height="140" Background="#0C1017" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="CyberTerminal">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F4BB;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="CyberTerminal" Foreground="#00FF66" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Monospace hacker HUD, real-time Aegis RAM/CPU telemetry, CLI search prompt, numbered shortcuts." Foreground="#00CC55" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_CyberTerminal" Grid.Row="2" Text="" Foreground="#00FF66" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 3: Metro Matrix -->
                            <Border x:Name="CardTheme_MetroMatrix" Width="220" Height="140" Background="#004E8C" BorderBrush="#0078D7" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="MetroMatrix">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F4CA;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Metro Matrix" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Windows Phone Live Tiles masonry, dynamic 2x1 live weather curve, waveform media player, chromatic blocks." Foreground="#D0E8FF" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_MetroMatrix" Grid.Row="2" Text="" Foreground="#00FF66" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 4: Rust Neo-Canvas -->
                            <Border x:Name="CardTheme_RustNeoCanvas" Width="220" Height="140" Background="#1C1824" BorderBrush="#E05638" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="RustNeoCanvas">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x2699;" FontSize="18" Margin="0,0,8,0" Foreground="#E05638" VerticalAlignment="Center"/>
                                        <TextBlock Text="Rust Neo-Canvas" Foreground="#FFA07A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Arc Spatial Dock solved natively in Rust horizon_core.dll. Optical center spotlight and floating glass capsule dock." Foreground="#DDAA99" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_RustNeoCanvas" Grid.Row="2" Text="" Foreground="#00FF66" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 5: Retro CRT Cyberdeck -->
                            <Border x:Name="CardTheme_RetroCRT" Width="220" Height="140" Background="#1A1408" BorderBrush="#FFB000" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="RetroCRT">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F4BE;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Retro CRT Cyberdeck" Foreground="#FFB000" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="80s arcade synthwave terminal, amber scanlines, CRT screen curvature, cassette tape deck, and floppy diskettes." Foreground="#CCA040" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_RetroCRT" Grid.Row="2" Text="" Foreground="#00FF66" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 6: Editorial Paper -->
                            <Border x:Name="CardTheme_EditorialPaper" Width="220" Height="140" Background="#F4EFE6" BorderBrush="#D5CBB8" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="EditorialPaper">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F4F0;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Editorial Paper" Foreground="#2A2421" FontFamily="Georgia" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Kinfolk &amp; Monocle broadsheet journal, high-fashion serif typography, cream/charcoal textures, chapter index." Foreground="#665D55" FontFamily="Georgia" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_EditorialPaper" Grid.Row="2" Text="" Foreground="#00AA44" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 7: Starship LCARS -->
                            <Border x:Name="CardTheme_StarshipLCARS" Width="220" Height="140" Background="#0A0A14" BorderBrush="#FF9900" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="StarshipLCARS">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F680;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Starship LCARS" Foreground="#FF9900" FontFamily="Arial Black" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="24th-century Federation bridge console, sweeping elbow arch frames, Gold &amp; Warp Blue pill controls." Foreground="#CC99CC" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_StarshipLCARS" Grid.Row="2" Text="" Foreground="#00FF66" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 8: Zen Garden -->
                            <Border x:Name="CardTheme_ZenGarden" Width="220" Height="140" Background="#161B17" BorderBrush="#343F37" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="ZenGarden">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F33F;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zen Garden" Foreground="#D0D8D0" FontSize="13" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Biophilic claymorphism, smooth river stone pebble shortcuts, serene minimal typography, mindful rhythm." Foreground="#889888" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_ZenGarden" Grid.Row="2" Text="" Foreground="#00FF66" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Theme 9: Win95 RetroDesk -->
                            <Border x:Name="CardTheme_Win95RetroDesk" Width="220" Height="140" Background="#008080" BorderBrush="#DFDFDF" BorderThickness="2" CornerRadius="4" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="CardTheme_Click" Tag="Win95RetroDesk">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="&#x1F5A5;" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Win95 RetroDesk" Foreground="White" FontFamily="MS Sans Serif, Tahoma" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="1995 desktop computing nostalgia, classic teal background, 3D beveled windows, desktop icons with dotted focus." Foreground="#E0FFFF" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="BadgeTheme_Win95RetroDesk" Grid.Row="2" Text="" Foreground="#FFFF00" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="BACKGROUND" Loaded="TabBackground_Loaded">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10">
                        <TextBlock Text="Wallpaper" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TblWallpaperSummary" Text="" Foreground="#888888" FontSize="11" Margin="0,0,0,12"
                                   TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left"/>
                        <Button x:Name="BtnOpenMediaManager" Content="Manage Wallpapers &amp; Startup Video..." Height="32" Padding="14,0"
                                HorizontalAlignment="Left" Click="BtnManageWallpapers_Click"/>
                        <TextBlock Text="Pick a single wallpaper or a rotation, add your own images, organize collections, and drag and drop images or folders."
                                   Foreground="#888888" FontSize="10" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="BACKGROUND (old)" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10">
                        <TextBlock Text="Wallpaper" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TblWallpaperFolderPath" Text="Default (app folder)" Foreground="#888888" FontSize="11"
                                   Margin="0,0,0,8" MaxWidth="440" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="BtnManageWallpapers" Content="Manage Wallpapers..." Height="28" Padding="10,0" Margin="0,0,10,0" Click="BtnManageWallpapers_Click"/>
                            <Button x:Name="BtnOpenWallpaperFolder" Content="Open Wallpapers Folder" Height="28" Padding="10,0" Click="BtnOpenWallpaperFolder_Click"/>
                            <Button x:Name="BtnAddWallpaper" Content="Add Wallpaper..." Height="28" Padding="10,0" Margin="10,0,0,0" Click="BtnAddWallpaper_Click"/>
                            <Button x:Name="BtnChooseWallpaperFolder" Content="Choose Folder..." Height="28" Padding="10,0" Margin="10,0,0,0" Click="BtnChooseWallpaperFolder_Click"/>
                            <Button x:Name="BtnResetWallpaperFolder" Content="Reset" Height="28" Padding="10,0" Margin="10,0,0,0" Click="BtnResetWallpaperFolder_Click"/>
                        </StackPanel>

                        <TextBlock Text="Playback mode" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>

                        <RadioButton x:Name="RbWallpaperFixed" Content="Fixed wallpaper" GroupName="WallpaperMode"
                                     Foreground="White" Margin="0,0,0,6" Checked="WallpaperMode_Checked"/>
                        <ComboBox x:Name="CmbWallpaperFixedFile" Height="28" Margin="20,0,0,14"
                                  SelectionChanged="CmbWallpaperFixedFile_SelectionChanged"/>

                        <RadioButton x:Name="RbWallpaperRandom" Content="Random wallpaper every launch" GroupName="WallpaperMode"
                                     Foreground="White" Margin="0,0,0,14" Checked="WallpaperMode_Checked"/>

                        <RadioButton x:Name="RbWallpaperCustom" Content="Custom selection" GroupName="WallpaperMode"
                                     Foreground="White" Margin="0,0,0,6" Checked="WallpaperMode_Checked"/>
                        <TextBlock Text="Custom selection order" Foreground="#888888" FontSize="10" Margin="20,0,0,6"/>
                        <ListBox x:Name="ListWallpaperCustom" Height="110" Margin="20,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <Button x:Name="BtnWallpaperCustomAdd" Content="Add" Width="64" Height="26" Click="BtnWallpaperCustomAdd_Click"/>
                            <Button x:Name="BtnWallpaperCustomRemove" Content="Remove" Width="64" Height="26" Margin="6,0,0,0" Click="BtnWallpaperCustomRemove_Click"/>
                            <ComboBox x:Name="CmbWallpaperCustomOrder" Width="110" Height="26" Margin="6,0,0,0"
                                      SelectionChanged="CmbWallpaperCustomOrder_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="HOMEPAGE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10">
                        <TextBlock Text="Homepage Address" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbHomepage" Height="30" IsEditable="True">
                            <ComboBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit" Click="MenuEditHomepage_Click"/>
                                    <MenuItem Header="Delete" Click="MenuDeleteHomepage_Click"/>
                                </ContextMenu>
                            </ComboBox.ContextMenu>
                        </ComboBox>
                        <Button x:Name="BtnSaveHomepage" Content="Save as New Homepage" Margin="0,10,0,0" Height="28" Click="BtnSaveHomepage_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="SECTIONS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10">
                        <TextBlock Text="Visible Sections" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkSectionClockWeather" Content="Clock &amp; Weather panel" Foreground="White"
                                  Margin="0,0,0,8" Checked="SectionToggle_Changed" Unchecked="SectionToggle_Changed"/>
                        <CheckBox x:Name="ChkSectionSearch" Content="Search bar &amp; shortcuts" Foreground="White"
                                  Margin="0,0,0,8" Checked="SectionToggle_Changed" Unchecked="SectionToggle_Changed"/>
                        <Rectangle Height="1" Fill="#333" Margin="0,10,0,10"/>
                        <TextBlock Text="Sidebar Integration" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkHomeSidebarFloatingOverlay" Content="Float sidebar over homepage (preserves center alignment)" Foreground="White"
                                  Margin="0,0,0,8" Checked="HomeSidebarFloatingOverlay_Changed" Unchecked="HomeSidebarFloatingOverlay_Changed"
                                  ToolTip="When enabled, opening the sidebar will slide smoothly over the homepage without squeezing or shifting widgets out of the center."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="APPEARANCE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10">
                        <TextBlock Text="Font" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbHomeFont" Height="28" Margin="0,0,0,14"
                                  SelectionChanged="CmbHomeFont_SelectionChanged"/>

                        <TextBlock Text="Colors" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkAdaptiveColors" Content="Adapt clock/search colors to wallpaper" Foreground="White"
                                  Margin="0,0,0,8" Checked="AdaptiveColors_Changed" Unchecked="AdaptiveColors_Changed"/>

                        <TextBlock Text="Widget Tint" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Slider x:Name="SldTintStrength" Width="220" Minimum="0" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="TintStrength_ValueChanged"/>
                            <TextBlock x:Name="TblTintStrengthValue" Text="50%" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Width="35"/>
                        </StackPanel>

                        <TextBlock Text="Inactivity Timeout" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Slider x:Name="SldInactivityTimeout" Width="220" Minimum="3" Maximum="60"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="InactivityTimeout_ValueChanged"/>
                            <TextBlock x:Name="TblInactivityTimeoutValue" Text="15s" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Width="30"/>
                        </StackPanel>

                        <TextBlock Text="Audio Visualizer" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <CheckBox x:Name="ChkVisualizerEnabled" Content="Show audio visualizer on homepage" Foreground="White"
                                  Margin="0,0,0,8" Checked="VisualizerEnabled_Changed" Unchecked="VisualizerEnabled_Changed"/>
                        <TextBlock Text="Show when" Foreground="#888888" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbVisualizerScope" Height="28" Margin="0,0,0,8"
                                  SelectionChanged="CmbVisualizerScope_SelectionChanged"/>

                        <StackPanel x:Name="PnlVisualizerWebsites" Margin="0,4,0,0">
                            <TextBlock Text="Allowed websites (domain contains)" Foreground="#888888" FontSize="10" Margin="0,0,0,2"/>
                            <ListBox x:Name="ListVisualizerWebsites" Height="90"
                                     SelectionChanged="ListVisualizerWebsites_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox x:Name="TxtVisualizerWebsite" Width="180" Height="26"/>
                                <Button x:Name="BtnVisualizerWebsiteAdd" Content="Add" Width="60" Height="26" Margin="6,0,0,0" Click="BtnVisualizerWebsiteAdd_Click"/>
                                <Button x:Name="BtnVisualizerWebsiteRemove" Content="Remove" Width="70" Height="26" Margin="6,0,0,0" Click="BtnVisualizerWebsiteRemove_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="WIDGETS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="10">
                        <TextBlock Text="Widgets" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkWidgetClock" Content="Clock" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                        <CheckBox x:Name="ChkWidgetWeather" Content="Weather" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                        <CheckBox x:Name="ChkWidgetMedia" Content="Media controls" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                        <CheckBox x:Name="ChkWidgetCalendar" Content="Calendar" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                        <CheckBox x:Name="ChkWidgetDownloads" Content="Downloads" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                        <CheckBox x:Name="ChkWidgetFavorites" Content="Favorites" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                        <CheckBox x:Name="ChkWidgetBookmarks" Content="Bookmarks" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>
                        <CheckBox x:Name="ChkWidgetBattery" Content="Battery indicator" Foreground="White"
                                  Margin="0,0,0,8" Checked="WidgetToggle_Changed" Unchecked="WidgetToggle_Changed"/>

                        <TextBlock Text="Right column" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,10"/>
                        <CheckBox x:Name="ChkRightColumn" Content="Show right column" Foreground="White"
                                  Margin="0,0,0,8" Checked="RightColumnToggle_Changed" Unchecked="RightColumnToggle_Changed"/>
                        <CheckBox x:Name="ChkRightFavorites" Content="Favorites drawer" Foreground="White"
                                  Margin="20,0,0,8" Checked="RightColumnToggle_Changed" Unchecked="RightColumnToggle_Changed"/>
                        <CheckBox x:Name="ChkRightBookmarks" Content="Bookmarks drawer" Foreground="White"
                                  Margin="20,0,0,8" Checked="RightColumnToggle_Changed" Unchecked="RightColumnToggle_Changed"/>
                        <TextBlock Text="Added elements" Foreground="#888888" FontSize="10" Margin="0,6,0,2"/>
                        <ListBox x:Name="ListRightElements" Height="90" DisplayMemberPath="Title"/>
                        <Button x:Name="BtnRightElementRemove" Content="Remove selected" Width="120" Height="26"
                                HorizontalAlignment="Left" Margin="0,6,0,8" Click="BtnRightElementRemove_Click"/>

                        <TextBlock Text="Collapsed group style" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CmbGroupStyle" Height="28" Margin="0,0,0,8"
                                  SelectionChanged="CmbGroupStyle_SelectionChanged"/>

                        <TextBlock Text="Bookmark grouping" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CmbBookmarkGrouping" Height="28" Margin="0,0,0,8"
                                  SelectionChanged="CmbBookmarkGrouping_SelectionChanged"/>

                        <TextBlock Text="Favorites rows" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CmbFavoriteRows" Height="28" Margin="0,0,0,8"
                                  SelectionChanged="CmbFavoriteRows_SelectionChanged"/>

                        <TextBlock Text="Bookmark rows" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CmbBookmarkRows" Height="28" Margin="0,0,0,8"
                                  SelectionChanged="CmbBookmarkRows_SelectionChanged"/>

                        <TextBlock Text="Folder cards threshold" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CmbFolderThreshold" Height="28" Margin="0,0,0,8"
                                  ToolTip="Show favorites or bookmarks as folder cards when one folder holds at least this share of their opens, or when the items do not fit in the rows."
                                  SelectionChanged="CmbFolderThreshold_SelectionChanged"/>

                        <TextBlock Text="Folder open mode" Foreground="{DynamicResource Brush_Accent}" FontSize="13" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CmbFolderOpenMode" Height="28" Margin="0,0,0,8"
                                  ToolTip="Popup floats the opened folder over a blurred drawer. In-place expand grows the clicked folder to fill the drawer."
                                  SelectionChanged="CmbFolderOpenMode_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="SHORTCUTS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="ListShortcuts" Grid.Row="0" DisplayMemberPath="Name" Height="220"
                                 SelectionChanged="ListShortcuts_SelectionChanged"/>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="Name" Foreground="#888888" FontSize="10"/>
                            <TextBox x:Name="TxtShortcutName" Height="26" Margin="0,2,0,8"/>
                            <TextBlock Text="URL" Foreground="#888888" FontSize="10"/>
                            <TextBox x:Name="TxtShortcutUrl" Height="26" Margin="0,2,0,8"/>
                            <TextBlock Text="Icon (emoji)" Foreground="#888888" FontSize="10"/>
                            <TextBox x:Name="TxtShortcutEmoji" Height="26" Margin="0,2,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnShortcutAdd" Content="Add" Width="70" Height="26" Click="BtnShortcutAdd_Click"/>
                                <Button x:Name="BtnShortcutUpdate" Content="Update" Width="70" Height="26" Margin="6,0,0,0" Click="BtnShortcutUpdate_Click"/>
                                <Button x:Name="BtnShortcutRemove" Content="Remove" Width="70" Height="26" Margin="6,0,0,0" Click="BtnShortcutRemove_Click"/>
                                <Button x:Name="BtnShortcutMoveUp" Content="&#x2191;" Width="30" Height="26" Margin="10,0,0,0" Click="BtnShortcutMoveUp_Click"/>
                                <Button x:Name="BtnShortcutMoveDown" Content="&#x2193;" Width="30" Height="26" Margin="4,0,0,0" Click="BtnShortcutMoveDown_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button x:Name="BtnCloseHomeSettings" Grid.Row="2" Content="Close" Width="90" HorizontalAlignment="Right"
                Click="BtnCloseHomeSettings_Click"/>
        </Grid>
    </Grid>
</Window>