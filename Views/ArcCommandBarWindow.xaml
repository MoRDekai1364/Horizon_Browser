<Window x:Class="Horizon.Stealth.Views.ArcCommandBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="680" Height="500"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Grid x:Name="OuterGrid" Margin="24">
        <!-- Drop Shadow Caster -->
        <Border CornerRadius="16" Background="#01000000" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.65" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Frosted Glass Command Bar Card -->
        <Border x:Name="CardBorder" CornerRadius="16" BorderThickness="1" ClipToBounds="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#70FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#25FFFFFF" Offset="0.35"/>
                    <GradientStop Color="#10FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F0131722" Offset="0.0"/>
                    <GradientStop Color="#F60F121B" Offset="0.6"/>
                    <GradientStop Color="#FA0A0C12" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- Specular top glare line -->
                <Rectangle Height="1" VerticalAlignment="Top" Margin="16,0,16,0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#60FFFFFF" Offset="0.3"/>
                            <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#60FFFFFF" Offset="0.7"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <DockPanel LastChildFill="True">
                    <!-- Top Search Input Bar (Arc Style) -->
                    <Border DockPanel.Dock="Top" Height="56" Padding="18,0,18,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Magnifying Glass Icon -->
                            <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="15" Foreground="#8E9297"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- Search Input Box & Placeholder -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPlaceholder" Text="Search or Enter URL, command, or script..."
                                           Foreground="#60FFFFFF" FontSize="14.5" FontFamily="Segoe UI"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14.5" FontFamily="Segoe UI"
                                         CaretBrush="#00E5FF" VerticalAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged"
                                         PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
                            </Grid>

                            <!-- Clear Button -->
                            <Border x:Name="BtnClear" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                    Background="#20FFFFFF" Cursor="Hand" Margin="0,0,10,0"
                                    Visibility="Collapsed" MouseLeftButtonUp="BtnClear_Click">
                                <TextBlock Text="&#x2715;" FontSize="9.5" Foreground="#BBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- + New Shortcut Button -->
                            <Border x:Name="BtnNewShortcut" Grid.Column="3" Height="26" CornerRadius="13"
                                    Background="#2000E5FF" BorderBrush="#5000E5FF" BorderThickness="1"
                                    Padding="10,0" Cursor="Hand" MouseLeftButtonUp="BtnNewShortcut_Click"
                                    ToolTip="Create Custom Shortcut or Script">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,5,-1"/>
                                    <TextBlock Text="Shortcut" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Divider Line -->
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="#1EFFFFFF"/>

                    <!-- Bottom Status Bar -->
                    <Border DockPanel.Dock="Bottom" Height="34" Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Padding="18,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x2191;&#x2193; Navigate" FontSize="11" Foreground="#70FFFFFF" Margin="0,0,14,0"/>
                                <TextBlock Text="&#x21B5; Execute / Open" FontSize="11" Foreground="#70FFFFFF" Margin="0,0,14,0"/>
                                <TextBlock Text="Esc Dismiss" FontSize="11" Foreground="#70FFFFFF"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Arc Command Bar" FontSize="11" FontWeight="SemiBold" Foreground="#4000E5FF"/>
                        </Grid>
                    </Border>

                    <!-- Main Content Area: Results List or Inline Shortcut Creator -->
                    <Grid>
                        <!-- Results ListBox -->
                        <ListBox x:Name="ListResults" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="8,8"
                                 SelectionChanged="ListResults_SelectionChanged"
                                 MouseDoubleClick="ListResults_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" CornerRadius="10"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#25FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#2600E5FF"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6600E5FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon Container -->
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                                                Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayIcon}" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Title and Description Stack -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#8E9297" FontSize="11"
                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Action Hint / Tag / Hotkey -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Hotkey badge if any -->
                                            <Border CornerRadius="4" Background="#20FFFFFF" Padding="6,2" Margin="0,0,8,0"
                                                    Visibility="{Binding KeyGestureVisibility}">
                                                <TextBlock Text="{Binding KeyGesture}" FontSize="10.5" FontFamily="Segoe UI"
                                                           FontWeight="SemiBold" Foreground="#00E5FF"/>
                                            </Border>
                                            <!-- Action Arrow Hint (Arc style: Learning Arc ->) -->
                                            <Border CornerRadius="6" Background="#12FFFFFF" Padding="8,3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActionHint}" FontSize="10.5" Foreground="#BBB" Margin="0,0,4,0"/>
                                                    <TextBlock Text="&#x2192;" FontSize="11" Foreground="#00E5FF"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Inline Custom Shortcut / Script Creator Drawer -->
                        <Border x:Name="PnlNewShortcut" Background="#F00E1119" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0"
                                Padding="20,16" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Create Custom Shortcut &amp; Script" FontSize="14.5" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Define a custom action, URL template, or JavaScript to run on active tabs." FontSize="11.5" Foreground="#8E9297" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="#20FFFFFF" Cursor="Hand" MouseLeftButtonUp="BtnCloseNewShortcut_Click">
                                            <TextBlock Text="&#x2715;" FontSize="10.5" Foreground="#CCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Shortcut Title & Icon -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Icon" FontSize="11" Foreground="#AAA" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtNewIcon" Text="&#x26A1;" Background="#161A24" BorderBrush="#35FFFFFF" Foreground="White" Height="30" FontSize="14" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Title" FontSize="11" Foreground="#AAA" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtNewTitle" Background="#161A24" BorderBrush="#35FFFFFF" Foreground="White" Height="30" FontSize="12.5" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Type & Hotkey -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Action Type" FontSize="11" Foreground="#AAA" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbNewActionType" Height="30" Background="#161A24" Foreground="White" SelectionChanged="CmbNewActionType_SelectionChanged">
                                                <ComboBoxItem Content="Run JavaScript on Tab (Script)" IsSelected="True"/>
                                                <ComboBoxItem Content="Open Web URL Template (Url)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Hotkey Gesture (e.g. Ctrl+Shift+K)" FontSize="11" Foreground="#AAA" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtNewHotkey" Background="#161A24" BorderBrush="#35FFFFFF" Foreground="White" Height="30" FontSize="12.5" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Payload / Script Editor -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock x:Name="LblNewPayload" Text="JavaScript Code (Executes on current active tab):" FontSize="11" Foreground="#AAA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtNewPayload" Background="#141720" BorderBrush="#35FFFFFF" Foreground="#00E5FF"
                                                 FontFamily="Consolas" FontSize="12" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" Padding="10"/>
                                    </StackPanel>

                                    <!-- Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Height="30" CornerRadius="6" Background="#20FFFFFF" Padding="14,0" Cursor="Hand" Margin="0,0,8,0" MouseLeftButtonUp="BtnCloseNewShortcut_Click">
                                            <TextBlock Text="Cancel" FontSize="12" Foreground="#CCC" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Height="30" CornerRadius="6" Background="#00E5FF" Padding="16,0" Cursor="Hand" MouseLeftButtonUp="BtnSaveNewShortcut_Click">
                                            <TextBlock Text="Save Shortcut" FontSize="12" FontWeight="Bold" Foreground="#0A0C12" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
