<Window x:Class="Horizon.Stealth.Views.HistoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        WindowStyle="None" WindowState="Maximized" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush_DeepBackground}"
        Foreground="{DynamicResource Brush_Text}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="HistFilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistModeTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistPillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text}"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistRowStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E808080"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E808080"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Far-right corner Close Button (Fitts's Law) -->
        <Button Click="BtnClose_Click" Panel.ZIndex="100"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="56" Height="44" Background="#16FFFFFF" Foreground="{DynamicResource Brush_SoftText}"
                BorderThickness="0" Cursor="Hand" ToolTip="Close (Esc)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,0,0,12"
                            BorderBrush="#26FFFFFF" BorderThickness="1,0,0,1">
                        <Path x:Name="XIcon" Data="M 0,0 L 12,12 M 12,0 L 0,12"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C40D1D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    <Grid Margin="26,20,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,46,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="HISTORY //" Foreground="{DynamicResource Brush_Accent}"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,16,0">
                <RadioButton x:Name="TabTimeline" Content="TIMELINE" GroupName="HistViewMode" IsChecked="True"
                             Style="{StaticResource HistModeTabStyle}" Click="ViewMode_Changed"/>
                <RadioButton x:Name="TabBySite" Content="BY SITE" GroupName="HistViewMode"
                             Style="{StaticResource HistModeTabStyle}" Click="ViewMode_Changed"/>
            </StackPanel>

            <!-- Search Pill -->
            <Border Grid.Column="2" MaxWidth="460" HorizontalAlignment="Left" MinWidth="280" Width="400" Height="36"
                    Background="#1E808080" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="13" Foreground="#999999" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Brush_Text}" CaretBrush="{DynamicResource Brush_Text}"
                             FontSize="13" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged" ToolTip="Search by title, URL, or domain (Ctrl+F)"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="&#x2715;" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Foreground="#999999" Cursor="Hand"
                            FontSize="11" Padding="4,0" Click="BtnClearSearch_Click"/>
                </Grid>
            </Border>

            <!-- Top-right Actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnReopenClosed" Content="&#x21A9; Reopen Closed Tab" Margin="0,0,8,0"
                        Style="{StaticResource HistPillBtnStyle}" Click="BtnReopenClosed_Click"
                        ToolTip="Reopen the most recently closed tab (Ctrl+Shift+T)"/>
                <Button x:Name="BtnClearMenu" Content="&#x1F5D1; Clear Data..." Margin="0,0,0,0"
                        Style="{StaticResource HistPillBtnStyle}" Click="BtnClearMenu_Click"
                        ToolTip="Clear history by time range"/>
            </StackPanel>
        </Grid>

        <!-- Contextual Multi-Select Bar (Hidden until 2+ items selected) -->
        <Border x:Name="PnlBulkBar" Grid.Row="1" Visibility="Collapsed"
                Background="#243B82F6" BorderBrush="#5560A5FA" BorderThickness="1" CornerRadius="10"
                Padding="14,8" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Open Selected" Style="{StaticResource HistPillBtnStyle}" Margin="0,0,8,0" Click="BtnBulkOpen_Click"/>
                    <Button Content="Bookmark Selected" Style="{StaticResource HistPillBtnStyle}" Margin="0,0,8,0" Click="BtnBulkBookmark_Click"/>
                    <Button Content="Delete Selected" Style="{StaticResource HistPillBtnStyle}" Background="#55EF4444" BorderBrush="#88F87171" Click="BtnBulkDelete_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtBulkCount" Text="0 items selected" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Body: Left Rail + Main History List -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Rail: Time Filters & Top Sites -->
            <Border Grid.Column="0" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="TIME RANGE" FontSize="10.5" FontWeight="Bold" Foreground="#8894A6" Margin="8,2,0,6"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <RadioButton x:Name="RbRangeAll" Content="All History" GroupName="HistRange" IsChecked="True" Style="{StaticResource HistFilterRadioStyle}" Click="Range_Changed"/>
                        <RadioButton x:Name="RbRangeToday" Content="Today" GroupName="HistRange" Style="{StaticResource HistFilterRadioStyle}" Click="Range_Changed"/>
                        <RadioButton x:Name="RbRangeYesterday" Content="Yesterday" GroupName="HistRange" Style="{StaticResource HistFilterRadioStyle}" Click="Range_Changed"/>
                        <RadioButton x:Name="RbRangeWeek" Content="Last 7 Days" GroupName="HistRange" Style="{StaticResource HistFilterRadioStyle}" Click="Range_Changed"/>
                        <RadioButton x:Name="RbRangeOlder" Content="Older" GroupName="HistRange" Style="{StaticResource HistFilterRadioStyle}" Click="Range_Changed"/>
                    </StackPanel>

                    <DockPanel Grid.Row="2" Margin="8,0,4,6">
                        <Button x:Name="BtnClearSiteFilter" DockPanel.Dock="Right" Content="Reset" Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush_Accent}"
                                FontSize="11" Cursor="Hand" Click="BtnClearSiteFilter_Click"/>
                        <TextBlock Text="TOP SITES" FontSize="10.5" FontWeight="Bold" Foreground="#8894A6" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="LstTopSites" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstTopSites_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E808080"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#30808080"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Foreground="#8894A6" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Domain}" FontSize="12" Foreground="{DynamicResource Brush_Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Main History List -->
            <Border Grid.Column="2" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <ListBox x:Name="LstHistory" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource HistRowStyle}"
                             SelectionChanged="LstHistory_SelectionChanged"
                             MouseDoubleClick="LstHistory_MouseDoubleClick"
                             MouseRightButtonUp="LstHistory_MouseRightButtonUp">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush_Accent}" Margin="10,12,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="#20FFFFFF"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="&#x1F310;" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding FallbackVisibility}"/>
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush_Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8E9AAE"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="11.5" Foreground="#8E9AAE"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#x2197;" Tag="{Binding}" Click="BtnRowOpen_Click"
                                                Style="{StaticResource HistPillBtnStyle}" Padding="8,4" Margin="0,0,5,0"
                                                ToolTip="Open in new tab"/>
                                        <Button Content="&#x2715;" Tag="{Binding}" Click="BtnRowDelete_Click"
                                                Style="{StaticResource HistPillBtnStyle}" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                ToolTip="Delete from history"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="No browsing history matches your filter." FontSize="14" Foreground="#8E9AAE"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnDeleteDomain" Content="Delete All from Site" Visibility="Collapsed"
                        Style="{StaticResource HistPillBtnStyle}" Margin="0,0,8,0" Click="BtnDeleteDomain_Click"/>
                <Button Content="Export History..." Style="{StaticResource HistPillBtnStyle}" Click="BtnExport_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStats" Text="0 entries" FontSize="12" Foreground="#8E9AAE" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
