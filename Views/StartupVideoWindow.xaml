<Window x:Class="Horizon.Stealth.Views.StartupVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Horizon Browser"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Black"
        Opacity="0"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        Width="1" Height="1"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid x:Name="RootGrid" Background="#0A1A3C">
        <MediaElement x:Name="VideoPlayer"
                      Stretch="Uniform"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Volume="0"
                      MediaOpened="VideoPlayer_MediaOpened"
                      MediaEnded="VideoPlayer_MediaEnded"
                      MediaFailed="VideoPlayer_MediaFailed"/>
    </Grid>
</Window>
