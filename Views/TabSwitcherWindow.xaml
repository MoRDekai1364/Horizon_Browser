<Window x:Class="Horizon.Stealth.Views.TabSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="1000" Height="580"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Grid x:Name="OuterShadowMarginGrid" Margin="32">
        <!-- Dedicated shadow caster kept strictly inside the 32px transparent margin -->
        <Border CornerRadius="16" Background="#01000000" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- Rounded-clipped frosted glass card -->
        <Grid x:Name="CardClipHost">
            <Border x:Name="CardBaseBg" CornerRadius="16" Background="#EB121419" IsHitTestVisible="False"/>

            <!-- Live wallpaper glass backdrop host -->
            <Grid x:Name="GlassBackdropHost" IsHitTestVisible="False" ClipToBounds="True"/>

            <DockPanel x:Name="RootDock">
                <!-- Top Header Bar -->
                <Border DockPanel.Dock="Top" Background="#16FFFFFF"
                        BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"
                        CornerRadius="16,16,0,0"
                        Padding="18,12,18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2000CC66" BorderBrush="#5500CC66" BorderThickness="1"
                                    CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtCtrlTabLabel" Text="CTRL + TAB"
                                           Foreground="#33FF88" FontFamily="Segoe UI"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button x:Name="BtnModeToggle" Content="Grid" Click="BtnModeToggle_Click"
                                    Foreground="#CCCCCC" Background="#20FFFFFF"
                                    BorderBrush="#33FFFFFF" BorderThickness="1"
                                    FontFamily="Segoe UI" FontSize="11" Padding="9,3"
                                    Margin="0,0,6,0" Cursor="Hand" VerticalAlignment="Center"
                                    ToolTip="Switch to grid layout (Ctrl+G)">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Rectangle Width="1" Height="14" Fill="#33FFFFFF" Margin="4,0,10,0"/>
                            <TextBlock x:Name="TxtTabSwitcherHdr"
                                       Foreground="#888888" FontFamily="Segoe UI" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TxtPreviewTitle"
                                   Foreground="#E2E2E2" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                        <Button Grid.Column="2" x:Name="BtnSwitcherClose"
                                Content="&#x2715;" Click="BtnSwitcherClose_Click"
                                Visibility="Collapsed"
                                Foreground="#CCCCCC" Background="#20FFFFFF"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                FontSize="11" Padding="8,3"
                                Cursor="Hand" VerticalAlignment="Center"
                                ToolTip="Close (Esc)">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Bottom Hint Bar -->
                <Border DockPanel.Dock="Bottom" Background="#12FFFFFF"
                        BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16"
                        Padding="16,8">
                    <TextBlock x:Name="TxtHintBar"
                               Text="&#x2191;&#x2193; navigate   ·   &#x21B5; switch   ·   Ctrl+click: select   ·   Shift+click: range   ·   Del: close   ·   Esc: dismiss"
                               Foreground="#888888" FontFamily="Segoe UI" FontSize="11"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Main Content Split -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: search + tab list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search pill -->
                        <Border Grid.Row="0" Background="#16FFFFFF"
                                BorderBrush="#25FFFFFF" BorderThickness="1"
                                CornerRadius="16" Margin="10,10,10,6"
                                Padding="8,4">
                            <Grid>
                                <TextBox x:Name="TxtSearch"
                                         Background="Transparent" Foreground="#FFFFFF"
                                         BorderThickness="0"
                                         CaretBrush="#00FF88" SelectionBrush="#4400FF88"
                                         FontFamily="Segoe UI" FontSize="12"
                                         Padding="24,2,6,2"
                                         TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock Text="&#x1F50D;  Filter tabs..."
                                           Foreground="#888888" FontFamily="Segoe UI" FontSize="12"
                                           Margin="6,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      Padding="4,4"
                                      x:Name="TabListScroll">
                            <StackPanel x:Name="TabListPanel" Background="Transparent"/>
                        </ScrollViewer>

                        <!-- Multi-select action bar -->
                        <Border Grid.Row="2" x:Name="MultiActionBar"
                                Visibility="Collapsed"
                                Background="#1AFFFFFF"
                                BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0"
                                Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCloseSelected"
                                        Content="&#x2715;  Close selected"
                                        Click="BtnCloseSelected_Click"
                                        Foreground="#FF7777" Background="#33FF4444"
                                        BorderBrush="#66FF4444" BorderThickness="1"
                                        FontFamily="Segoe UI" FontSize="11"
                                        Padding="10,4" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnCloseOthers"
                                        Content="&#x22A0;  Close others"
                                        Click="BtnCloseOthers_Click"
                                        Foreground="#CCCCCC" Background="#20FFFFFF"
                                        BorderBrush="#33FFFFFF" BorderThickness="1"
                                        FontFamily="Segoe UI" FontSize="11"
                                        Padding="10,4" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="#1EFFFFFF" Width="1"/>

                    <!-- Right: preview -->
                    <Grid Grid.Column="2" Background="#0C000000" Margin="14">
                        <Border CornerRadius="12" BorderBrush="#22FFFFFF" BorderThickness="1"
                                Background="#14000000" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform" Margin="10"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <StackPanel x:Name="PnlPreviewStatus"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock Text="&#x1F5BC;" FontSize="28" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtPreviewStatus"
                                               Foreground="#888888" FontFamily="Segoe UI" FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </DockPanel>
        </Grid>

        <!-- Crisp outer border aligned to the 16px rounded card -->
        <Border x:Name="SwitcherCardBorder" CornerRadius="16"
                BorderBrush="#33FFFFFF" BorderThickness="1"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
