<Window x:Class="Horizon.Stealth.Views.TabSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="940" Height="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Border Background="#F2090909" CornerRadius="12"
            BorderBrush="#1E1E1E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.92" Color="Black"/>
        </Border.Effect>

        <DockPanel>
            <DockPanel.Clip>
                <RectangleGeometry RadiusX="11" RadiusY="11" Rect="0,0,938,518"/>
            </DockPanel.Clip>

            <!-- Top bar -->
            <Border DockPanel.Dock="Bottom" Background="#0C0C0C"
                    CornerRadius="12,12,0,0" Padding="18,10,18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="TxtCtrlTabLabel" Text="CTRL+TAB"
                                   Foreground="#00CC44" FontFamily="Consolas"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="12" Fill="#2A2A2A" Margin="12,0"/>
                        <TextBlock x:Name="TxtTabSwitcherHdr"
                                   Foreground="#444" FontFamily="Consolas" FontSize="10"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtPreviewTitle"
                               Foreground="#3A3A3A" FontFamily="Consolas" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                    <Button Grid.Column="2" x:Name="BtnSwitcherClose"
                            Content="✕" Click="BtnSwitcherClose_Click"
                            Visibility="Collapsed"
                            Foreground="#666" Background="Transparent"
                            BorderThickness="0" FontSize="12" Padding="8,0"
                            Cursor="Hand" VerticalAlignment="Center"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- Bottom hint bar -->
            <Border DockPanel.Dock="Top" Background="#080808"
                    CornerRadius="0,0,12,12" Padding="16,8">
                <TextBlock x:Name="TxtHintBar"
                           Text="&#x2191;&#x2193; navigate   &#xB7;   Ctrl+click: select   &#xB7;   Shift+click: range   &#xB7;   Del: close   &#xB7;   Esc cancel"
                           Foreground="#2E2E2E" FontFamily="Consolas" FontSize="10"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Main split -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: search + tab list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#090909"
                            BorderBrush="#1C1C1C" BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <Grid>
                            <TextBox x:Name="TxtSearch"
                                     Background="#111" Foreground="#CCC"
                                     BorderBrush="#2A2A2A" BorderThickness="1"
                                     CaretBrush="#00CC44" SelectionBrush="#00CC44"
                                     FontFamily="Consolas" FontSize="12"
                                     Padding="26,6,8,6"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="🔍  filter tabs..."
                                       Foreground="#333" FontFamily="Consolas" FontSize="12"
                                       Margin="10,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  x:Name="TabListScroll">
                        <StackPanel x:Name="TabListPanel" Background="Transparent"/>
                    </ScrollViewer>

                    <!-- Multi-select action bar (shown when ≥2 rows are selected) -->
                    <Border Grid.Row="2" x:Name="MultiActionBar"
                            Visibility="Collapsed"
                            Background="#0A0A0A"
                            BorderBrush="#1C1C1C" BorderThickness="0,1,0,0"
                            Padding="8,7">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnCloseSelected"
                                    Content="✕  Close 0 tabs"
                                    Click="BtnCloseSelected_Click"
                                    Foreground="#CC5555" Background="#160808"
                                    BorderBrush="#3A1111" BorderThickness="1"
                                    FontFamily="Consolas" FontSize="10"
                                    Padding="8,4" Margin="0,0,6,0" Cursor="Hand"/>
                            <Button x:Name="BtnCloseOthers"
                                    Content="⊠  Close others"
                                    Click="BtnCloseOthers_Click"
                                    Foreground="#666" Background="#141414"
                                    BorderBrush="#282828" BorderThickness="1"
                                    FontFamily="Consolas" FontSize="10"
                                    Padding="8,4" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Divider -->
                <Rectangle Grid.Column="1" Fill="#181818"/>

                <!-- Right: preview -->
                <Grid Grid.Column="2" Background="#070707">
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform" Margin="14"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="PnlPreviewStatus"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="TxtPreviewStatus"
                                   Foreground="#2E2E2E" FontFamily="Consolas" FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </DockPanel>
    </Border>
</Window>